{% extends '@admin/base_admin.html.twig' %}

{% block title %}Ticket #{{ thread.slugId|slice(0, 8) }}{% endblock %}

{% block page_title %}Ticket #{{ thread.slugId|slice(0, 8) }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Page class="text-xs">Support & Tickets</twig:Breadcrumb:Page>
    </twig:Breadcrumb:Item>
{% endblock %}
{% block content %}
    <div class="max-w-7xl mx-auto space-y-6">

        {# --- HEADER --- #}
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="{{ path(is_granted('ROLE_SUPER_ADMIN') ? 'admin_support_list' : 'app_support_list') }}" class="p-2 bg-white border border-slate-200 rounded-lg text-slate-400 hover:text-slate-600 transition-colors">
                    {{ ux_icon('lucide:arrow-left', { class: 'size-5' }) }}
                </a>
                <div>
                    <h1 class="text-xl font-semibold text-slate-900 tracking-tight">{{ thread.categoryTitle }} : {{ thread.topicTitle }}</h1>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase {{ thread.status.badgeClasses }}">
                            {{ thread.status.label }}
                        </span>
                        <span class="text-xs text-slate-400">Ouvert le {{ thread.createdAt|format_datetime(locale: 'fr') }}</span>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <div class="flex items-center gap-3">
                    {% if thread.status.value == 'open' %}
                        <twig:AlertDialog id="resolve-ticket">
                            <twig:AlertDialog:Trigger>
                                <twig:Button type="button" class="text-sm" {{ ...trigger_attrs }}>Marquer comme résolu</twig:Button>
                            </twig:AlertDialog:Trigger>
                            <twig:AlertDialog:Content>
                                <form method="post" action="{{ path('admin_support_mark_as_resolve', {slugId: thread.slugId}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('support-resolve') }}">
                                    <twig:AlertDialog:Header>
                                        <twig:AlertDialog:Title>Confirmer la résolution du ticket ?</twig:AlertDialog:Title>
                                        <twig:AlertDialog:Description>
                                            Le cabinet ne pourra plus répondre tant que le ticket n'est pas rouvert.
                                        </twig:AlertDialog:Description>
                                    </twig:AlertDialog:Header>
                                    <twig:AlertDialog:Footer>
                                        <twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel>
                                        <twig:AlertDialog:Action type="submit">Marquer comme résolu</twig:AlertDialog:Action>
                                    </twig:AlertDialog:Footer>
                                </form>
                            </twig:AlertDialog:Content>
                        </twig:AlertDialog>
                    {% else %}
                        <twig:AlertDialog id="reopen-ticket">
                            <twig:AlertDialog:Trigger>
                                <twig:Button type="button" variant="outline" class="text-sm" {{ ...trigger_attrs }}>
                                    <twig:ux:icon name="tabler:rotate-2" class="mr-1.5 size-4" />
                                    Rouvrir le ticket
                                </twig:Button>
                            </twig:AlertDialog:Trigger>
                            <twig:AlertDialog:Content>
                                <form method="post" action="{{ path('admin_support_reopen', {slugId: thread.slugId}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('support-reopen') }}">
                                    <twig:AlertDialog:Header>
                                        <twig:AlertDialog:Title>Rouvrir ce ticket ?</twig:AlertDialog:Title>
                                        <twig:AlertDialog:Description>
                                            Le cabinet pourra de nouveau échanger avec le support sur ce ticket.
                                        </twig:AlertDialog:Description>
                                    </twig:AlertDialog:Header>
                                    <twig:AlertDialog:Footer>
                                        <twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel>
                                        <twig:AlertDialog:Action type="submit">Rouvrir</twig:AlertDialog:Action>
                                    </twig:AlertDialog:Footer>
                                </form>
                            </twig:AlertDialog:Content>
                        </twig:AlertDialog>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {# --- MAIN LAYOUT --- #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            {# COLONNE GAUCHE : LE CHAT #}
            <div class="lg:col-span-8">
                <twig:AdminSupportChatComponent thread="{{ thread }}"></twig:AdminSupportChatComponent>
            </div>

            {# COLONNE DROITE : PANNEAU UNIQUE, SECTIONS À DIVIDER #}
            <aside class="lg:col-span-4 bg-white border border-slate-200 rounded-xl divide-y divide-slate-200">

                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <section class="p-5">
                        <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Gestion interne</h2>
                        <div class="pt-4">
                            <twig:SupportThreadMetaComponent thread="{{ thread }}" />
                        </div>
                    </section>
                {% endif %}

                <section class="p-5">
                    <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Cabinet</h2>
                    <div class="pt-4 space-y-3">
                        <div class="flex items-center gap-3">
                            <div class="size-9 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
                                {{ ux_icon('lucide:building-2', { class: 'size-4 text-slate-500' }) }}
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-900 truncate">{{ thread.workspace.name }}</p>
                                <p class="text-xs text-slate-400">{{ thread.workspace.slugId }}</p>
                            </div>
                        </div>
                        <dl class="pt-2 space-y-2">
                            <div class="flex justify-between items-center">
                                <dt class="text-xs text-slate-500">Contact principal</dt>
                                <dd class="text-xs font-medium text-slate-900">{{ thread.user.firstName }} {{ thread.user.lastName|default('') }}</dd>
                            </div>
                            <div class="flex justify-between items-center">
                                <dt class="text-xs text-slate-500">Création compte</dt>
                                <dd class="text-xs font-medium text-slate-700">{{ thread.user.createdAt|format_datetime(locale: 'fr') }}</dd>
                            </div>
                        </dl>
                        <a href="{{ path('admin_workspace_details', {slugId: thread.workspace.slugId}) }}"
                           class="mt-2 w-full inline-flex items-center justify-center gap-2 px-3 py-2 bg-slate-50 text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-100 transition-colors border border-slate-100">
                            {{ ux_icon('lucide:external-link', { class: 'size-3' }) }}
                            Voir l'espace client
                        </a>
                    </div>
                </section>

                <section class="p-5">
                    <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Détails techniques</h2>
                    <dl class="pt-4 space-y-3">
                        <div>
                            <dt class="text-xs text-slate-500">Catégorie</dt>
                            <dd class="mt-0.5 text-sm font-medium text-slate-900">{{ thread.getCategoryTitle }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-slate-500">Contexte / Origine</dt>
                            <dd class="mt-0.5">
                                {% if thread.urlContext %}
                                    <a href="{{ thread.urlContext }}" target="_blank" rel="noopener" class="text-sm font-medium text-violet-700 hover:text-violet-900 break-all">
                                        {{ thread.urlContext }}
                                    </a>
                                {% else %}
                                    <span class="text-sm text-slate-400">Non spécifié</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </section>
            </aside>

        </div>
    </div>
{% endblock %}

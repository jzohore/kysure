{# Maquette décorative — DER + signature électronique (exemple illustratif). #}
<div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5" aria-hidden="true">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <span class="flex size-9 items-center justify-center rounded-xl border border-slate-200 bg-slate-50">
                {{ ux_icon('lucide:file-text', { class: 'size-4 text-slate-600' }) }}
            </span>
            <div>
                <p class="text-[13px] font-semibold text-slate-900">Document d'entrée en relation</p>
                <p class="text-[12px] text-slate-600">Cabinet Exemple · ORIAS renseigné</p>
            </div>
        </div>
        <span class="rounded-full border border-emerald-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-emerald-700">Signé</span>
    </div>

    <div class="mt-5 space-y-2.5">
        <div class="h-2 w-full rounded-full bg-slate-100"></div>
        <div class="h-2 w-11/12 rounded-full bg-slate-100"></div>
        <div class="h-2 w-4/5 rounded-full bg-slate-100"></div>
        <div class="h-2 w-2/3 rounded-full bg-slate-100"></div>
    </div>

    <div class="mt-6 rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4">
        <div class="flex items-center gap-3">
            {{ ux_icon('lucide:pen-line', { class: 'size-5 text-emerald-600' }) }}
            <div>
                <p class="text-[13px] font-semibold text-slate-900">Signature électronique</p>
                <p class="text-[12px] text-slate-600">Horodatée · preuve archivée au dossier</p>
            </div>
        </div>
    </div>
</div>

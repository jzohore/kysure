{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}Modifier un membre{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('admin_team_list') }}" class="text-xs">Équipe KYSURE</twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="max-w-xl">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ account.firstName }} {{ account.lastName }}</h1>
            <p class="text-sm text-slate-500 mt-1">{{ account.email }}</p>
        </div>

        <form method="post" action="{{ path('admin_team_edit', {slugId: account.slugId}) }}"
              class="space-y-4 rounded-md border border-slate-200 bg-white p-6 shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_account_edit_' ~ account.slugId) }}">

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label for="firstName" class="mb-1 block text-sm font-medium text-slate-700">Prénom</label>
                    <input type="text" id="firstName" name="firstName" required value="{{ account.firstName }}"
                           class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
                </div>
                <div>
                    <label for="lastName" class="mb-1 block text-sm font-medium text-slate-700">Nom</label>
                    <input type="text" id="lastName" name="lastName" required value="{{ account.lastName }}"
                           class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
                </div>
            </div>

            <div>
                <label for="phoneNumber" class="mb-1 block text-sm font-medium text-slate-700">Téléphone <span class="font-normal text-slate-400">— facultatif</span></label>
                <input type="tel" id="phoneNumber" name="phoneNumber" value="{{ account.phoneNumber }}"
                       class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
            </div>

            <fieldset>
                <legend class="mb-1 block text-sm font-medium text-slate-700">Rôle</legend>
                <p class="mb-2 text-xs text-slate-400">Changer le rôle ferme les sessions ouvertes du membre.</p>
                <div class="space-y-2">
                    {% for role in roles %}
                        <label class="flex items-start gap-3 rounded-md border border-slate-200 p-3 hover:bg-slate-50 has-[:checked]:border-slate-900 has-[:checked]:ring-1 has-[:checked]:ring-slate-900">
                            <input type="radio" name="role" value="{{ role.value }}" class="mt-0.5" {{ role.value == account.role ? 'checked' : '' }} required>
                            <span>
                                <span class="block text-sm font-semibold text-slate-900">{{ role.getLabel() }}</span>
                                <span class="block text-xs text-slate-500">{{ role.getDescription() }}</span>
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="flex items-center justify-end gap-2 pt-2">
                <a href="{{ path('admin_team_list') }}"
                   class="px-4 py-2 bg-white border border-slate-200 text-xs font-bold text-slate-700 rounded-md hover:bg-slate-50">Annuler</a>
                <button type="submit"
                        class="px-4 py-2 bg-[#6e2f1e] text-xs font-bold text-white rounded-md hover:bg-[#5a2517] shadow-sm">Enregistrer</button>
            </div>
        </form>
    </div>
{% endblock %}

{% extends '@app/base_app.html.twig' %}

{# Macros au niveau racine du template (Twig 3.28+ : macro dans un block déprécié). Appel : _self.nom() #}
{% macro render_ocr(ocrData) %}
    {# 1. Dictionnaire de traduction des clés Mindee -> Français #}
    {% set labels = {
        'first_name': 'Prénom',
        'last_name': 'Nom de famille',
        'birth_date': 'Date de naissance',
        'birth_place': 'Lieu de naissance',
        'id_number': 'Numéro de pièce',
        'nationality': 'Nationalité',
        'gender': 'Sexe',
        'document_type': 'Type de document',
        'company_name': 'Nom de la société',
        'registration_number': 'Immatriculation (SIREN/RCS)',
        'legal_form': 'Forme juridique',
        'share_capital': 'Capital social',
        'date_of_registration': 'Date d\'immatriculation',
        'registered_address': 'Siège social',
        'duration_of_company': 'Durée de la société',
        'activity_code_ape': 'Code APE',
        'management': 'Dirigeants',
        'establishments': 'Établissements secondaires',
        'mrz': 'Bande de lecture optique (MRZ)',
        'address': 'Adresse'
    } %}

    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-4">
        {% for key, value in ocrData %}
            {# On gère la largeur de la colonne : les tableaux prennent toute la largeur #}
            <div class="{{ value is iterable ? 'col-span-1 sm:col-span-2 lg:col-span-3' : 'col-span-1' }}">
                {# Affichage du titre traduit #}
                <dt class="text-slate-500 font-medium text-[11px] uppercase tracking-wider mb-1.5">
                    {{ labels[key]|default(key|replace({'_': ' '})|capitalize) }}
                </dt>

                <dd class="text-slate-900 text-xs">
                    {% if value is empty %}
                        <span class="text-slate-300 italic">Non détecté</span>

                        {# ---------------- FORMATAGES SPÉCIFIQUES ---------------- #}

                    {% elseif key in ['birth_date', 'date_of_registration'] %}
                        {# Dates au format FR (ex: 27/01/2000) #}
                        <span class="font-medium">{{ value|date('d/m/Y') }}</span>

                    {% elseif key == 'share_capital' %}
                        {# Argent (ex: 762 500 €) #}
                        <span class="font-medium">{{ value|number_format(0, ',', ' ') }} €</span>

                    {% elseif key == 'management' %}
                        {# Liste des dirigeants (Cartes) #}
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-1">
                            {% for person in value %}
                                <div class="bg-slate-50 ring-1 ring-slate-900/5 p-3 rounded-xl flex flex-col justify-center">
                                    <span class="font-bold text-slate-800">{{ person.name }}</span>
                                    <span class="text-slate-500 text-[10px] uppercase tracking-wide mt-0.5">{{ person.role }}</span>
                                </div>
                            {% endfor %}
                        </div>

                    {% elseif key == 'establishments' %}
                        {# Liste des établissements (Cartes) #}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-1">
                            {% for est in value %}
                                <div class="bg-slate-50 ring-1 ring-slate-900/5 p-3 rounded-xl flex flex-col">
                                    <span class="font-bold text-slate-800">{{ est.activity|default('Activité non précisée') }}</span>
                                    <span class="text-slate-500 text-[10px] mt-1">{{ est.address }}</span>
                                </div>
                            {% endfor %}
                        </div>

                    {% elseif key == 'mrz' %}
                        {# Bande MRZ (Style passeport / code) #}
                        <div class="bg-slate-900 text-emerald-400 font-mono text-[11px] p-3 rounded-xl overflow-x-auto tracking-widest shadow-inner mt-1">
                            {% for line_key, line_val in value %}
                                <div class="whitespace-nowrap">{{ line_val }}</div>
                            {% endfor %}
                        </div>

                    {% elseif key == 'address' %}
                        {# Adresse simple (CNI) #}
                        <div class="text-slate-700">
                            {{ value.full_address|default(value.city ~ (value.department ? ' (' ~ value.department ~ ')' : '')) }}
                        </div>

                    {% else %}
                        {# Affichage par défaut pour les textes basiques #}
                        <span class="font-medium">{{ value }}</span>
                    {% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>
{% endmacro %}

            {% macro status_badge(status) %}
                {% set config = {
                    'pending':  { bg: 'bg-slate-50',   text: 'text-slate-700',   ring: 'ring-slate-600/20',   label: 'En attente' },
                    'uploaded': { bg: 'bg-amber-50',   text: 'text-amber-700',   ring: 'ring-amber-600/20',   label: 'À vérifier' },
                    'valid':    { bg: 'bg-emerald-50', text: 'text-emerald-700', ring: 'ring-emerald-600/20', label: 'Validé' },
                    'rejected': { bg: 'bg-rose-50',    text: 'text-rose-700',    ring: 'ring-rose-600/20',    label: 'Refusé' },
                    'expired':  { bg: 'bg-gray-50',    text: 'text-gray-700',    ring: 'ring-gray-600/20',    label: 'Expiré' }
                } %}
                {% set s = config[status] %}
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-bold {{ s.bg }} {{ s.text }} ring-1 ring-inset {{ s.ring }}">
    {{ s.label }}
</span>
            {% endmacro %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_kyc_list') }}" class="text-xs">
            Dossiers KYC / LCB-FT
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}
{% block content %}
    <div class="min-h-screen bg-[#F7F9FC] selection:bg-indigo-100 selection:text-indigo-900 pb-12">

        {# Top Navigation (Utilisation de twig:Button as="a") #}
        <div class="px-6 py-4 flex items-center gap-4">
            <twig:Button as="a" href="{{ path('app_kyc_list') }}" variant="link" class="text-slate-500 hover:text-slate-900">
                <twig:ux:icon name="solar:arrow-left-bold" class="size-4 mr-2" />
                Retour à la liste
            </twig:Button>
        </div>

        {# CONTAINER PRINCIPAL #}
        <div class="max-w-[1400px] mx-auto px-6 lg:px-8 flex flex-col lg:flex-row gap-10">

            {# ========================================================= #}
            {# COLONNE GAUCHE : CONTENU DÉFILANT (flex-1)                 #}
            {# ========================================================= #}
            <div class="flex-1 min-w-0 space-y-10">

                {# BANDEAU TOP #}
                <div class="bg-indigo-50/50 rounded-[2rem] p-8 ring-1 ring-indigo-900/5 relative overflow-hidden">
                    <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="relative z-10 flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                            <span class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-widest font-bold bg-white text-indigo-600 ring-1 ring-slate-900/5 shadow-sm">
                                Dossier {{ folder.reference }}
                            </span>
                                <span class="text-xs font-semibold text-slate-500 flex items-center gap-1.5">
                                <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span></span>
                                {{ folder.status.label }}
                            </span>
                            </div>
                            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-4">
                                {{ folder.companyName|default('En attente de l\'entreprise') }}
                            </h1>
                            <p class="text-sm font-medium text-slate-500 mt-2">
                                {% if folder.siret %}SIRET : <span class="text-slate-700">{{ folder.siret }}</span>{% else %}Non renseigné{% endif %}
                            </p>
                        </div>
                    </div>
                </div>

                {# 1. CALCUL DES DOCUMENTS SOCIÉTÉ (Docs sans stakeholder attaché) #}
                {% set companyDocs = folder.documents|filter(d => d.stakeholderSlug is null) %}

                {# SECTION 1 : SOCIÉTÉ #}
                {# SECTION 1 : PIÈCES DE LA SOCIÉTÉ #}
                <section>
                    <div class="flex items-center justify-between mb-4 px-2">
                        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">1. Pièces de la société</h2>
                    </div>

                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 overflow-hidden">
                        {% if companyDocs is empty %}
                            {# État vide si aucune entreprise n'est liée ou aucun doc généré #}
                            <div class="p-10 text-center">
                                <div class="mx-auto h-12 w-12 bg-slate-50 rounded-full flex items-center justify-center mb-4 ring-1 ring-slate-900/5">
                                    <twig:ux:icon name="tabler:building-bank" class="size-6 text-slate-400" />
                                </div>
                                <h3 class="text-sm font-semibold text-slate-900">En attente de l'entreprise</h3>
                                <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">
                                    Identifiez votre structure pour générer la liste des documents requis.
                                </p>
                            </div>
                        {% else %}
                            <ul class="divide-y divide-slate-900/5">
                                {% for doc in companyDocs %}
                                    <li class="p-5 hover:bg-slate-50/50 transition-colors">
                                        {# En-tête du document #}
                                        <div class="flex items-center justify-between group">
                                            <div class="flex items-center gap-4">
                                                <div class="p-2.5 bg-slate-50 rounded-xl text-slate-500 ring-1 ring-slate-900/5">
                                                    <twig:ux:icon name="tabler:file-description" class="size-5" />
                                                </div>
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-900">{{ doc.typeLabel }}</p>
                                                    <p class="text-xs text-slate-400 mt-0.5">{{ doc.storagePath|slice(0, 40) ~ (doc.storagePath|length > 40 ? '...' : '')|default('Aucun fichier') }}</p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-4">
                                                {# Badge OCR dynamique #}
                                                {% if doc.ocrData %}
                                                    <span title="Données extraites par l'IA" class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-bold text-indigo-700 ring-1 ring-inset ring-indigo-600/20 uppercase tracking-wider">
                                        <twig:ux:icon name="tabler:robot" class="size-3" />
                                        OCR
                                    </span>
                                                {% endif %}

                                                {{ _self.status_badge(doc.status) }}

                                                {% if doc.storagePath %}
                                                    <twig:Button target="_blank" title="Visualiser" variant="link" as="a" href="{{ doc.storagePath|private_url }}">
                                                        <twig:ux:icon name="tabler:eye" class="size-5" />
                                                    </twig:Button>
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% if doc.status == 'rejected' and doc.rejectionReason %}
                                            <div class="mt-3 p-3 bg-rose-50 rounded-lg ring-1 ring-inset ring-rose-600/20 text-xs text-rose-700 flex gap-2 items-start">
                                                <twig:ux:icon name="tabler:alert-triangle" class="size-4 shrink-0 mt-0.5 text-rose-600" />
                                                <div>
                                                    <span class="font-bold">Motif du refus automatique :</span>
                                                    <p class="mt-0.5 whitespace-pre-line">{{ doc.rejectionReason }}</p>
                                                </div>
                                            </div>
                                        {% endif %}
                                        {# Accordéon des données OCR (s'affiche uniquement si ocrData n'est pas vide) #}
                                        {% if doc.ocrData %}
                                            <details class="mt-4 group/details">
                                                <summary class="text-xs font-medium text-indigo-600 cursor-pointer list-none flex items-center gap-1.5 hover:text-indigo-700 select-none">
                                                    <twig:ux:icon name="tabler:chevron-right" class="size-3.5 transition-transform group-open/details:rotate-90" />
                                                    Voir les données extraites
                                                </summary>
                                                <div class="mt-3 p-5 bg-white rounded-2xl ring-1 ring-slate-900/5 shadow-sm">
                                                    {# 🚀 APPEL DE LA MACRO ICI #}
                                                    {{ _self.render_ocr(doc.ocrData) }}
                                                </div>
                                            </details>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </section>

                {# SECTION 2 : INTERVENANTS #}
                <section class="mt-8">
                    <div class="flex items-center justify-between mb-4 px-2">
                        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">2. Intervenants & Bénéficiaires</h2>
                    </div>

                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-2 space-y-1">
                        {% for stakeholder in folder.stakeholders %}
                            <div class="p-3 hover:bg-slate-50 rounded-xl transition-colors group">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="h-8 w-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-[10px] ring-1 ring-slate-900/5">
                                            {{ stakeholder.fullName|split(' ')|map(n => n|first)|join|upper }}
                                        </div>
                                        <div>
                                            <h3 class="text-sm font-bold text-slate-900">{{ stakeholder.fullName }}</h3>
                                            <div class="flex items-center gap-2">
                                                <span class="text-[10px] text-slate-500 uppercase font-medium tracking-wide">{{ stakeholder.roleLabel }}</span>
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] font-bold bg-violet-200 text-slate-600 ring-1 ring-inset ring-slate-200">
                                    {{ stakeholder.percentage }} %
                                </span>
                                                {% if stakeholder.isUbo %}
                                                    <span class="text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded font-bold">UBO</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {% set stakeholderDocs = folder.documents|filter(d => d.stakeholderSlug == stakeholder.slugId) %}

                                <div class="ml-11 space-y-2">
                                    {% for doc in stakeholderDocs %}
                                        <div class="p-3 bg-white rounded-lg ring-1 ring-slate-900/5 shadow-sm group/doc">
                                            {# Ligne principale #}
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-3">
                                                    <twig:ux:icon name="tabler:id" class="size-4 text-slate-400" />
                                                    <span class="text-sm font-medium text-slate-700">{{ doc.typeLabel }}</span>
                                                </div>
                                                <div class="flex items-center gap-3">
                                                    {% if doc.ocrData %}
                                                        <span title="Données extraites par l'IA" class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-bold text-indigo-700 ring-1 ring-inset ring-indigo-600/20 uppercase tracking-wider">
                                            <twig:ux:icon name="tabler:robot" class="size-3" />
                                            OCR
                                        </span>
                                                    {% endif %}
                                                    {{ _self.status_badge(doc.status) }}
                                                    {% if doc.storagePath %}
                                                        <twig:Button target="_blank" title="Visualiser" variant="link" as="a" href="{{ doc.storagePath|private_url }}">
                                                            <twig:ux:icon name="tabler:eye" class="size-5" />
                                                        </twig:Button>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {% if doc.status == 'rejected' and doc.rejectionReason %}
                                                <div class="mt-3 p-3 bg-rose-50 rounded-lg ring-1 ring-inset ring-rose-600/20 text-xs text-rose-700 flex gap-2 items-start">
                                                    <twig:ux:icon name="tabler:alert-triangle" class="size-4 shrink-0 mt-0.5 text-rose-600" />
                                                    <div>
                                                        <span class="font-bold">Motif du refus automatique :</span>
                                                        <p class="mt-0.5 whitespace-pre-line">{{ doc.rejectionReason }}</p>
                                                    </div>
                                                </div>
                                            {% endif %}
                                            {# Accordéon OCR pour les intervenants #}
                                            {% if doc.ocrData %}
                                                <details class="mt-3 border-t border-slate-100 pt-3 group/details">
                                                    <summary class="text-xs font-medium text-indigo-600 cursor-pointer list-none flex items-center gap-1.5 hover:text-indigo-700 select-none">
                                                        <twig:ux:icon name="tabler:chevron-right" class="size-3.5 transition-transform group-open/details:rotate-90" />
                                                        Voir les données extraites
                                                    </summary>
                                                    <div class="mt-3 p-4 bg-slate-50/50 rounded-xl ring-1 ring-slate-900/5">
                                                        {# 🚀 APPEL DE LA MACRO ICI #}
                                                        {{ _self.render_ocr(doc.ocrData) }}
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <p class="text-[11px] text-slate-400 italic">Aucun document requis pour le moment.</p>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="p-10 text-center">
                                <twig:ux:icon name="tabler:users" class="size-8 text-slate-300 mx-auto mb-3" />
                                <h3 class="text-sm font-semibold text-slate-900">Aucun intervenant</h3>
                                <p class="text-xs text-slate-500 mt-1">La liste s'affichera après l'étape précédente.</p>
                            </div>
                        {% endfor %}
                    </div>
                </section>


                {# SECTION 3 : NOTES INTERNES #}
                <section>
                    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">3. Notes de conformité (Interne)</h2>
                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 overflow-hidden">

                        {# Zone de saisie #}
                        <div class="p-4 bg-slate-50/50 border-b border-slate-900/5">
                            <textarea rows="2" class="w-full border-0 bg-transparent focus:ring-0 text-sm text-slate-900 placeholder-slate-400 resize-none" placeholder="Ajouter une note pour vos collaborateurs..."></textarea>
                            <div class="flex justify-end mt-2">
                                <twig:Button variant="secondary" size="sm">
                                    <twig:ux:icon name="tabler:send" class="size-3 mr-2" />
                                    Enregistrer la note
                                </twig:Button>
                            </div>
                        </div>

                        {# Historique des notes (Fake) #}
                        <ul class="divide-y divide-slate-900/5">
                            <li class="p-4 hover:bg-slate-50/30 transition-colors">
                                <div class="flex items-center justify-between mb-1.5">
                                <span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                    <div class="h-4 w-4 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-[8px]">V</div>
                                    Vous
                                </span>
                                    <span class="text-[10px] text-slate-400 font-medium">Il y a 2 heures</span>
                                </div>
                                <p class="text-sm text-slate-600 ml-5.5">Le client m'a appelé, il va uploader la nouvelle version de son Kbis d'ici demain matin.</p>
                            </li>
                            <li class="p-4 hover:bg-slate-50/30 transition-colors">
                                <div class="flex items-center justify-between mb-1.5">
                                <span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[8px]">M</div>
                                    Marie (Compliance)
                                </span>
                                    <span class="text-[10px] text-slate-400 font-medium">Hier, 16:30</span>
                                </div>
                                <p class="text-sm text-slate-600 ml-5.5">⚠️ Attention, vérifier la date de validité de la CNI du dirigeant, elle semble très proche de l'expiration.</p>
                            </li>
                        </ul>
                    </div>
                </section>

                {# SECTION 4 : SCREENING AML #}
                <section>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">4. Analyse de risque (LCB-FT)</h2>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-200/50 px-2 py-0.5 rounded">Auto</span>
                    </div>
                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-5 flex items-start gap-4">
                        <div class="p-2 bg-emerald-50 rounded-full text-emerald-600 ring-1 ring-emerald-500/20">
                            <twig:ux:icon name="tabler:shield-check" class="size-6" />
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">Aucun risque détecté</h3>
                            <p class="text-xs text-slate-500 mt-1">L'entreprise et les intervenants ont été croisés avec les listes de sanctions internationales (OFAC, Gel des avoirs) et les listes PPE.</p>
                            <twig:Button variant="link" class="!px-0 mt-3 text-xs !text-indigo-600 hover:!text-indigo-800">
                                Voir le rapport détaillé Pappers
                            </twig:Button>
                        </div>
                    </div>
                </section>
            </div>


            {# ========================================================= #}
            {# COLONNE DROITE : SIDEBAR FIXE (w-96)                       #}
            {# ========================================================= #}
            <div class="w-full lg:w-96 flex-shrink-0">

                <div class="sticky top-8 flex flex-col h-[calc(100vh-4rem)] space-y-6">

                    {# 1. BLOC ACTIONS PRINCIPALES #}
                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-5 space-y-3">
                        <twig:Button class="w-full flex justify-center bg-[#0A2540] hover:bg-slate-900 text-white shadow-sm">
                            <twig:ux:icon name="tabler:check" class="size-4 mr-2 text-emerald-400" />
                            Valider le dossier
                        </twig:Button>

                        <twig:Button variant="outline" class="w-full flex justify-center">
                            Demander des corrections
                        </twig:Button>

                        <div class="pt-3 mt-3 border-t border-slate-900/5 grid grid-cols-2 gap-3">
                            <twig:Button variant="ghost" class="w-full !text-slate-600 hover:!text-indigo-600 hover:!bg-indigo-50 !px-2 !text-xs">
                                <twig:ux:icon name="tabler:mail-forward" class="size-3.5 mr-1.5" />
                                Relancer
                            </twig:Button>
                            {% if workspace_can('archive_folder') %}
                                <twig:Button variant="ghost" class="w-full !text-slate-600 hover:!text-rose-600 hover:!bg-rose-50 !px-2 !text-xs">
                                    <twig:ux:icon name="tabler:archive" class="size-3.5 mr-1.5" aria-hidden="true" />
                                    Archiver
                                </twig:Button>
                            {% endif %}
                        </div>
                    </div>

                    {# 2. BLOC DÉTAILS DU CONTACT #}
                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-5">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Contact</h3>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500">Nom</span>
                                <span class="font-medium text-slate-900">{{ folder.contactFirstName }} {{ folder.contactLastName }}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500">Email</span>
                                <a href="mailto:{{ folder.contactEmail }}" class="font-medium text-indigo-600 hover:text-indigo-700 truncate max-w-[150px]">{{ folder.contactEmail }}</a>
                            </div>
                        </div>

                        <twig:Button variant="secondary" class="mt-4 w-full flex justify-center text-xs" data-action="clipboard#copy" data-clipboard-text="{{ url('portal_kyc_confirm_token', {token: folder.slugId}) }}">
                            <twig:ux:icon name="tabler:link" class="size-3.5 mr-2" />
                            Copier le lien
                        </twig:Button>
                    </div>

                    {# 3. BLOC JOURNAL D'ACTIVITÉ (Scrollable) #}
                    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 flex flex-col flex-1 min-h-0">
                        <div class="p-5 border-b border-slate-900/5 flex-shrink-0">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Journal d'activité</h3>
                        </div>

                        <div class="p-5 overflow-y-auto flex-1 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:bg-slate-200 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-slate-300">
                            <div class="relative pl-3 border-l-2 border-slate-100 space-y-6">
                                {% for history in folder.history %}
                                    <div class="relative">
                                        <div class="absolute -left-[17px] top-1.5 h-2 w-2 rounded-full bg-amber-400 ring-4 ring-white"></div>
                                        <p class="text-sm font-semibold text-slate-900">{{ history.title }}</p>
                                        <p class="text-xs text-slate-500 mt-1">{{ history.description }}</p>
                                        <p class="text-[10px] font-bold text-slate-400 mt-1.5 uppercase tracking-wider">{{ history.saveAt.date |date('d/m/Y H:i') }}</p>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

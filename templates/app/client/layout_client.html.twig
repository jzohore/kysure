{% extends '@app/client/base_portal.html.twig' %}

{# Pas de pied de page : le shell occupe toute la hauteur de la fenêtre. #}
{% block footer %}{% endblock %}

{% block layout %}
    {% set current_route = app.request.attributes.get('_route') %}
    <div class="flex h-screen w-full overflow-hidden bg-[#faf9f5]" data-controller="sidebar">

        {# Sidebar flottante partagée #}
        {% include '@app/partials/_sidebar.html.twig' with {
            brand: company_name|default('KYSURE'),
            brand_href: path('portal_dashboard'),
            sections: [
                { items: [
                    { icon: 'lucide:layout-dashboard', label: 'Vue d\'ensemble', href: path('portal_dashboard'), active: current_route == 'portal_dashboard' },
                    { icon: 'lucide:folders', label: 'Mes dossiers', href: path('portal_folders_list'), active: 'folder' in current_route },
                ] },
                { title: 'Configuration', items: [
                    { icon: 'lucide:user-round', label: 'Mon profil', href: path('portal_profile'), active: current_route == 'portal_profile' },
                ] },
            ],
            user_name: app.user.fullName|default(app.user.email|default('Mon compte')),
            user_email: app.user.email|default(null),
            user_initials: app.user.initials|default('CL'),
            user_links: [
                { icon: 'lucide:user-round', label: 'Mon profil', href: path('portal_profile') },
                { icon: 'lucide:log-out', label: 'Se déconnecter', href: path('portal_logout'), danger: true },
            ],
        } only %}

        <div class="flex min-w-0 flex-1 flex-col">
            {# Barre mobile : ouvre le tiroir #}
            <header class="flex h-14 shrink-0 items-center gap-3 px-4 md:hidden">
                <button type="button" data-action="sidebar#open"
                        class="-ml-2 rounded-md p-2 text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
                        aria-label="Ouvrir le menu">
                    <twig:ux:icon name="lucide:menu" class="size-5" aria-hidden="true" />
                </button>
                <span class="text-sm font-semibold tracking-tight text-slate-900">{{ company_name|default('KYSURE') }}</span>
            </header>

            <div class="flex-1 overflow-y-auto">
                <main id="main-content" class="mx-auto w-full max-w-5xl px-4 py-6 outline-none sm:px-6 sm:py-10 lg:px-8" tabindex="-1">
                    {% block client_main %}{% endblock %}
                </main>
            </div>
        </div>
    </div>
{% endblock %}

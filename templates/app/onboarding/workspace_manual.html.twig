{% extends '@app/onboarding/base_onboarding.html.twig' %}

{% set current_step = 1 %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}

{% block form_content %}
    <h1 class="text-balance text-4xl font-semibold leading-[1.08] tracking-[-0.03em] text-slate-900 sm:text-5xl">{{ page_title }}</h1>
    {% if sub_title|default %}
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{{ sub_title }}</p>
    {% endif %}

    <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-8">
        <twig:CreateWorkspaceManualFormComponent userSlugId="{{ user_slug_id }}"></twig:CreateWorkspaceManualFormComponent>
    </div>
{% endblock %}

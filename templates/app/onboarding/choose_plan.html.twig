{% extends '@app/onboarding/base_onboarding.html.twig' %}

{% set current_step = 2 %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}

{% block form_content %}
    <h1 class="text-balance text-4xl font-semibold leading-[1.08] tracking-[-0.03em] text-slate-900 sm:text-5xl">{{ page_title }}</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">{{ page_description }}</p>

    <div class="mt-10">
        <twig:WorkspaceChoosePlanFormComponent userSlugId="{{ app.user.slugId }}"></twig:WorkspaceChoosePlanFormComponent>
    </div>
{% endblock %}

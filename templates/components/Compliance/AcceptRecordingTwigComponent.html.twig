<div {{ attributes }} class="w-full animate-in fade-in slide-in-from-top-2 duration-300">
    {% if this.stepBannerVisible %}

        {# ÉTAT PRÊT : le CTA pour lancer l'enregistrement et l'assistant IA #}
        <div class="flex flex-col justify-between gap-5 rounded-2xl border border-slate-200 bg-white p-6 sm:flex-row sm:items-center">
            {% if not this.acceptRecording %}
                <div class="flex items-start gap-4">
                    <twig:ux:icon name="lucide:mic" class="mt-0.5 size-5 shrink-0 text-slate-400" aria-hidden="true" />
                    <div>
                        <h4 class="text-base font-medium text-slate-900">Assistant IA disponible</h4>
                        <p class="mt-1 text-sm text-slate-600">Voulez-vous démarrer l'enregistrement de l'entretien ?</p>
                        <p class="mt-2 text-xs text-slate-500">
                            En cliquant sur « Oui », vous certifiez avoir prévenu votre client de l'enregistrement.
                        </p>
                    </div>
                </div>
                <twig:Button type="button" variant="dark" class="w-full shrink-0 px-8 sm:w-auto"
                             data-action="live#action" data-live-action-param="save">
                    Oui
                </twig:Button>
            {% else %}
                <div class="flex items-center gap-4">
                    <div class="relative flex size-10 shrink-0 items-center justify-center rounded-full bg-slate-100">
                        {{ ux_icon('lucide:mic', { class: 'size-5 text-slate-500 transition-colors duration-300', 'data-meeting-recorder-target': 'micIcon', 'aria-hidden': 'true' }) }}
                        {# Petit point rouge qui clignote quand ça enregistre (piloté par Stimulus) #}
                        <span class="absolute right-0 top-0 hidden size-2.5 rounded-full border-2 border-white bg-rose-500" data-meeting-recorder-target="recordingIndicator"></span>
                    </div>
                    <div>
                        <h4 class="text-base font-medium text-slate-900">Enregistrement autorisé</h4>
                        <p class="mt-0.5 text-sm text-slate-600">L'assistant IA est prêt. Démarrez l'enregistrement.</p>
                    </div>
                </div>
            {% endif %}

        </div>

    {% else %}

        {# ÉTAT EN ATTENTE : information douce #}
        <p class="flex items-start gap-3 border-l-2 border-slate-300 py-1 pl-4 text-sm text-slate-600">
            Remplissez les informations du client pour enregistrer l'échange.
        </p>

    {% endif %}
</div>

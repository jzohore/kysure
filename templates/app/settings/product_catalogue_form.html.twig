{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="max-w-2xl mx-auto">
        <a href="{{ path('app_settings_product_catalogue_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 mb-4">
            <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
            Retour au catalogue
        </a>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100">
                <h1 class="text-lg font-bold text-slate-900">{{ page_title }}</h1>
            </div>

            <div class="p-6">
                {{ form_start(product_form) }}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {{ form_row(product_form.name) }}
                    {{ form_row(product_form.isin) }}
                    {{ form_row(product_form.family) }}
                    {{ form_row(product_form.sriLevel) }}
                    {{ form_row(product_form.minimumHorizonYears) }}
                    {{ form_row(product_form.annualFeesPercent) }}
                </div>
                <div class="mt-4">
                    {{ form_row(product_form.targetInvestorProfiles) }}
                </div>

                <div class="flex items-center justify-end gap-3 pt-6 mt-6 border-t border-slate-100">
                    <twig:Button as="a" href="{{ path('app_settings_product_catalogue_list') }}" variant="ghost">Annuler</twig:Button>
                    <twig:Button type="submit" variant="dark">
                        <twig:ux:icon name="tabler:check" class="size-4" aria-hidden="true" />
                        Enregistrer
                    </twig:Button>
                </div>
                {{ form_end(product_form) }}
            </div>
        </div>
    </div>
{% endblock %}

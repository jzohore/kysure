{% extends '@app/billing/base_billing.html.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% set container_width = 'max-w-3xl' %}
{# Fond sable uni, comme le reste de l'application : pas de grille « tech » sur cette page #}
{% set surface_class = 'bg-background-sable' %}
{% set plain_surface = true %}
{% set isResume = dto.postMeetingReport is not empty %}
{% set isQuotaExhausted = dto.workspaceRemainingMinutes <= 0 %}
{% block header %}
    <header class="sticky top-0 z-40 flex flex-col items-start justify-between gap-4 border-b border-slate-200 bg-background-sable/90 px-4 py-3 backdrop-blur-xl sm:flex-row sm:items-center sm:px-6">
        <div class="flex items-center gap-3">
            <a href="javascript:history.back()" class="rounded-full p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" title="Retour à l'étape précédente" aria-label="Retour à l'étape précédente">
                {{ ux_icon('lucide:arrow-left', { class: 'size-5', 'aria-hidden': 'true' }) }}
            </a>
            <div>
                <h1 class="text-sm font-medium text-slate-900">Dossier {{ dto.reference }}</h1>
                <p class="text-xs text-slate-500">
                    {{ type == 'individual' ? 'Personne physique' : 'Personne morale' }}
                </p>
            </div>
        </div>

        <div class="flex w-full items-center justify-end gap-2 sm:w-auto">
            {# ENREGISTREMENT DE L'ENTRETIEN : minuteur et commandes pilotés par le contrôleur Stimulus #}
            <div class="flex items-center gap-2"
                {{ stimulus_controller('meeting-recorder', {
                    chunkUrl: path('app_api_meeting_chunk', { slugId: dto.slugId }),
                    stopUrl: path('app_api_meeting_stop', { slugId: dto.slugId }),
                    maxMinutes: dto.workspaceRemainingMinutes
                }) }}>

                <span data-meeting-recorder-target="timer" class="font-mono text-xs tabular-nums text-slate-500">
                    {{ isQuotaExhausted ? '00:00' : (dto.workspaceRemainingMinutes ~ ':00') }}
                </span>

                {% if dto.isAcceptedRecording and not isQuotaExhausted %}
                    <div class="flex items-center gap-1">
                        <button type="button" data-action="click->meeting-recorder#start" data-meeting-recorder-target="startBtn"
                                class="rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" title="Enregistrer" aria-label="Démarrer l'enregistrement">
                            {{ ux_icon('tabler:microphone', { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </button>
                        <button type="button" data-action="click->meeting-recorder#pause" data-meeting-recorder-target="pauseBtn"
                                class="hidden rounded-lg p-2 text-amber-700 transition-colors hover:bg-amber-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" title="Mettre en pause" aria-label="Mettre l'enregistrement en pause">
                            {{ ux_icon('tabler:player-pause', { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </button>
                        <button type="button" data-action="click->meeting-recorder#resume" data-meeting-recorder-target="resumeBtn"
                                class="hidden rounded-lg p-2 text-emerald-700 transition-colors hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" title="Reprendre" aria-label="Reprendre l'enregistrement">
                            {{ ux_icon('tabler:player-play', { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </button>
                        <button type="button" data-action="click->meeting-recorder#stop" data-meeting-recorder-target="stopBtn"
                                class="hidden animate-pulse rounded-lg p-2 text-rose-600 transition-colors hover:bg-rose-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" title="Terminer" aria-label="Terminer l'enregistrement">
                            {{ ux_icon('tabler:square-rounded', { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </button>
                    </div>
                {% else %}
                    <button type="button" disabled class="cursor-not-allowed rounded-lg p-2 text-slate-300" title="{{ isQuotaExhausted ? 'Quota de minutes épuisé' : 'Enregistrement non autorisé' }}" aria-label="{{ isQuotaExhausted ? 'Quota de minutes épuisé' : 'Enregistrement non autorisé' }}">
                        {{ ux_icon('tabler:microphone-off', { class: 'size-5', 'aria-hidden': 'true' }) }}
                    </button>
                {% endif %}
            </div>

            {% if is_granted('DELETE', folder) or is_granted('MAKE_CONFIDENTIAL', folder) or workspace_can('archive_folder') %}
                <div class="group relative inline-block">
                    <button type="button"
                            aria-haspopup="menu"
                            aria-label="Actions sur le dossier"
                            class="flex size-9 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                        {{ ux_icon('lsicon:setting-outline', { class: 'size-5', 'aria-hidden': 'true' }) }}
                    </button>

                    {# Menu d'actions : ouvert au survol et au focus clavier #}
                    <div role="menu"
                         class="invisible absolute right-0 z-50 mt-1.5 w-56 translate-y-1 rounded-xl border border-slate-200 bg-white opacity-0 shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all duration-150 focus-within:visible focus-within:translate-y-0 focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">

                        <div class="p-1">

                            {% if is_granted('MAKE_CONFIDENTIAL', folder) %}
                                <button
                                    type="submit"
                                    role="menuitem"
                                    form="confidential-form"
                                    class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 outline-none transition-colors hover:bg-slate-50 hover:text-slate-900 focus-visible:bg-slate-50">
                                    {% if folder.isConfidential %}
                                        {{ ux_icon('iconamoon:lock-fill', { class: 'size-4 text-slate-500', 'aria-hidden': 'true' }) }}
                                        Déverrouiller le dossier
                                    {% else %}
                                        {{ ux_icon('iconamoon:lock-off-fill', { class: 'size-4 text-slate-500', 'aria-hidden': 'true' }) }}
                                        Verrouiller le dossier
                                    {% endif %}
                                </button>
                            {% endif %}

                            {% if workspace_can('archive_folder') %}
                            <twig:Dialog id="archive_compliance_folder">
                                <twig:Dialog:Trigger>
                                    <twig:Button
                                        class="inline-flex w-full cursor-pointer items-center justify-start gap-2.5 rounded-md px-2.5 py-2 text-left text-sm font-normal text-slate-700 outline-none transition-colors hover:bg-slate-50 hover:text-slate-900 focus-visible:bg-slate-50"
                                        {{ ...dialog_trigger_attrs }}>
                                        {{ ux_icon('tabler:archive', { class: 'size-4 text-slate-500', 'aria-hidden': 'true' }) }}
                                        Archiver
                                    </twig:Button>
                                </twig:Dialog:Trigger>
                                <twig:Dialog:Content>
                                    <twig:Dialog:Header>
                                        <twig:Dialog:Title class="text-slate-900">Archiver le dossier client</twig:Dialog:Title>
                                        <twig:Dialog:Description class="mt-5 text-slate-600">
                                            Cette action va clôturer ce dossier de conformité. Il ne sera plus modifiable, mais restera accessible en lecture seule dans vos archives pour répondre aux obligations de l'AMF.
                                        </twig:Dialog:Description>
                                    </twig:Dialog:Header>

                                    <div class="my-4 border-l-2 border-amber-400 pl-4">
                                        <p class="text-sm font-medium text-slate-900">Conséquences immédiates</p>
                                        <ul class="mt-2 ml-4 list-disc space-y-1 text-sm text-slate-600 marker:text-slate-400">
                                            <li>L'espace de collecte du client sera définitivement désactivé.</li>
                                            <li>La piste d'audit et les documents signés seront scellés.</li>
                                            <li>Les relances automatiques par email seront interrompues.</li>
                                        </ul>
                                    </div>

                                    <twig:Dialog:Footer>
                                        <twig:Dialog:Close>
                                            <twig:Button variant="outline" {{ ...dialog_close_attrs }}>
                                                Annuler
                                            </twig:Button>
                                        </twig:Dialog:Close>

                                        {# Formulaire d'action avec protection CSRF #}
                                        <form action="{{ path('app_compliance_archive_folder', {
                                            slugId: folder.slugId, type: type, method: method
                                        }) }}" method="post" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('archive_folder_' ~ folder.slugId) }}">
                                            <twig:Button type="submit" variant="destructive">
                                                Archiver le dossier
                                            </twig:Button>
                                        </form>
                                    </twig:Dialog:Footer>
                                </twig:Dialog:Content>
                            </twig:Dialog>
                            {% endif %}

                            {% if is_granted('DELETE', folder) %}
                            <div class="mx-2 my-1 h-px bg-slate-100"></div>

                            <twig:Dialog id="delete_compliance_folder">
                                <twig:Dialog:Trigger>
                                    <twig:Button
                                        class="inline-flex w-full cursor-pointer items-center justify-start gap-2.5 rounded-md px-2.5 py-2 text-left text-sm font-normal text-rose-700 outline-none transition-colors hover:bg-rose-50 hover:text-rose-800 focus-visible:bg-rose-50"
                                        {{ ...dialog_trigger_attrs }}>
                                        {{ ux_icon('lucide:trash-2', { class: 'size-4', 'aria-hidden': 'true' }) }}
                                        Supprimer
                                    </twig:Button>
                                </twig:Dialog:Trigger>
                                <twig:Dialog:Content>
                                    <twig:Dialog:Header>
                                        <twig:Dialog:Title class="text-slate-900">Supprimer le dossier client</twig:Dialog:Title>
                                        <twig:Dialog:Description class="mt-5 font-medium text-rose-800">
                                            Cette action va supprimer ce dossier de conformité.
                                        </twig:Dialog:Description>
                                    </twig:Dialog:Header>

                                    <div class="my-4 border-l-2 border-rose-400 pl-4">
                                        <p class="text-sm font-medium text-slate-900">Conséquences immédiates</p>
                                        <ul class="mt-2 ml-4 list-disc space-y-1 text-sm text-slate-600 marker:text-slate-400">
                                            <li>L'espace de collecte du client sera définitivement désactivé.</li>
                                            <li>La piste d'audit et les documents signés seront scellés.</li>
                                            <li>Les relances automatiques par email seront interrompues.</li>
                                        </ul>
                                    </div>

                                    <twig:Dialog:Footer>
                                        <twig:Dialog:Close>
                                            <twig:Button variant="outline" {{ ...dialog_close_attrs }}>
                                                Annuler
                                            </twig:Button>
                                        </twig:Dialog:Close>

                                        {# Formulaire d'action avec protection CSRF #}
                                        <form action="{{ path('app_compliance_delete_folder', {
                                            slugId: folder.slugId, type: type, method: method
                                        }) }}" method="post" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_folder_' ~ folder.slugId) }}">
                                            <twig:Button type="submit" variant="destructive">
                                                Supprimer le dossier
                                            </twig:Button>
                                        </form>
                                    </twig:Dialog:Footer>
                                </twig:Dialog:Content>
                            </twig:Dialog>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </header>
{% endblock %}
{% block portal_content %}
    {# Formulaires cachés : soumission pour relecture et verrouillage / déverrouillage du dossier #}
    <form id="setup-form" method="POST" action="{{ path('app_compliance_submit_for_review', {slugId: folder.slugId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit-for-review-compliance') }}">
    </form>
    <form id="confidential-form" method="POST" action="{{ path('app_compliance_make_confidential_folder', {
        slugId: folder.slugId, type: type, method: method
    }) }}">
        <input type="hidden" value="true" name="folder_confidential_value">
        <input type="hidden" name="_token" value="{{ csrf_token('make-confidential-compliance') }}">
    </form>
    <form id="make-accessible-form" method="POST" action="{{ path('app_compliance_make_confidential_folder', {
        slugId: folder.slugId, type: type, method: method
    }) }}">
        <input type="hidden" value="false" name="folder_confidential_value">
        <input type="hidden" name="_token" value="{{ csrf_token('make-confidential-compliance') }}">
    </form>

    <div class="pb-24 pt-4 sm:pt-8">
        {# EN-TÊTE #}
        <div>
            <p class="text-sm text-slate-500">Nouveau dossier</p>
            <h2 class="mt-2 font-serif text-3xl tracking-tight text-slate-900 sm:text-4xl">
                {{ type == 'individual' ? 'Personne physique' : 'Personne morale' }}
            </h2>
            <p class="mt-3 text-base text-slate-600">
                Renseignez le client, puis générez le document d'entrée en relation (DER) à lui faire accuser.
            </p>
        </div>

        {% if folder.isConfidential %}
            <div class="mt-8 flex flex-col gap-4 border-l-2 border-slate-400 pl-4 sm:flex-row sm:items-center sm:justify-between" role="status">
                <div class="flex items-start gap-3">
                    <twig:ux:icon name="iconamoon:lock-fill" class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
                    <div>
                        <h3 class="text-sm font-medium text-slate-900">Dossier à accès restreint</h3>
                        <p class="mt-0.5 text-sm text-slate-600">Seules les personnes ci-contre peuvent consulter ce dossier.</p>
                    </div>
                </div>

                <ul class="flex flex-wrap items-center gap-2">
                    {% for allowedUser in folder.restrictedUsers %}
                        <li class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-3 text-xs text-slate-700">
                            <span class="flex size-6 items-center justify-center rounded-full bg-slate-100 text-[10px] font-medium text-slate-600" aria-hidden="true">
                                {{ allowedUser.firstName|first|upper }}{{ allowedUser.lastName|first|upper }}
                            </span>
                            {{ allowedUser.fullName }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# LES COMPOSANTS MÉTIER : étapes séparées par un vrai espace, pas de cadres imbriqués #}
        <div class="mt-10 space-y-6">
            <twig:ManualIndividualStepOneComponent complianceFolder="{{ folder }}" method="{{ method }}" type="{{ type }}"></twig:ManualIndividualStepOneComponent>
            {% if not dto.postMeetingReport %}
                <twig:AcceptRecordingTwigComponent complianceFolder="{{ folder }}" method="{{ method }}" type="{{ type }}"></twig:AcceptRecordingTwigComponent>
            {% endif %}

            <twig:GenerateDERComponent complianceFolder="{{ folder }}"></twig:GenerateDERComponent>
        </div>
    </div>
{% endblock %}

{# Widget IA flottant : rendu au niveau <body>, hors de la colonne animée
   (`animate-in slide-in-from-bottom-4`) dont le `transform` casserait le
   `position: fixed` du widget. #}
{% block floating_widgets %}
    <twig:AiReportDisplayComponent folder="{{ folder }}" method="{{ method }}" type="{{ type }}"></twig:AiReportDisplayComponent>
{% endblock %}

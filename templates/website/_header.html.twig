<header role="banner">
    <nav aria-label="Navigation principale" class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-xl">
        <div class="mx-auto flex h-[60px] max-w-7xl items-center justify-between px-4 sm:px-6">

            {# Logo #}
            <div class="flex shrink-0 items-center gap-2">
                <div class="flex size-7 items-center justify-center rounded bg-black text-sm font-bold text-white" aria-hidden="true">K</div>
                <a href="{{ path('website_home') }}"
                   class="rounded text-[17px] font-bold tracking-tight text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40"
                   title="Retour à l'accueil {{ company_name }}">
                    {{ company_name }}
                </a>
            </div>

            {# Liens desktop (ancres de la page d'accueil, valables depuis les autres pages du site) #}
            <div class="hidden items-center gap-7 text-[14px] font-medium text-slate-600 md:flex">
                <a href="{{ path('website_home') }}#parcours" class="rounded transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">Parcours</a>
                <a href="{{ path('website_home') }}#temps-gagne" class="rounded transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">Temps gagné</a>
                <a href="{{ path('website_home') }}#tarifs" class="rounded transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">Tarifs</a>
            </div>

            {# Accès : espace client (clients des cabinets) bien distinct de la connexion cabinet (CGP) #}
            <div class="flex items-center gap-1 sm:gap-2">
                <a href="{{ path('website_client_access') }}"
                   class="rounded-full px-3 py-2 text-[14px] font-medium text-slate-900 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">
                    Espace client
                </a>
                <a href="{{ path('app_login') }}"
                   class="hidden rounded-full px-3 py-2 text-[14px] font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40 sm:block">
                    Connexion cabinet
                </a>
                <twig:Button as="a" href="{{ path('app_register') }}" variant="dark" size="sm" class="rounded-full px-4" aria-label="Créer un compte {{ company_name }} gratuitement">
                    Essayer<span class="hidden sm:inline">&nbsp;gratuitement</span>
                </twig:Button>
            </div>
        </div>
    </nav>
</header>

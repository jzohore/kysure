{% extends '@app/settings/base_settings.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block settings_content %}

    {% set ws = workspaceInfo() %}

    <div class="grid gap-6 lg:grid-cols-3">

        {# ── Solde de minutes ── #}
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Minutes d'entretien</p>
            <div class="flex items-baseline gap-2">
                <span class="text-4xl font-bold text-slate-900 tracking-tight tabular-nums">{{ ws.remainingMeetingMinutes|default(0) }}</span>
                <span class="text-sm text-slate-500">/ {{ ws.meetingMinutesAllocated|default(0) }} min allouées</span>
            </div>

            {% set pct = ws.meetingMinutesAllocated|default(0) > 0 ? (ws.remainingMeetingMinutes / ws.meetingMinutesAllocated * 100)|round : 0 %}
            <div class="mt-4 h-2 w-full rounded-full bg-slate-100" aria-hidden="true">
                <div class="h-2 rounded-full {{ pct <= 15 ? 'bg-amber-500' : 'bg-emerald-500' }}" style="width: {{ pct }}%;"></div>
            </div>

            <div class="mt-5">
                <twig:Button as="a" href="{{ path('app_pricing') }}#packs" variant="primary" size="sm">
                    {{ ux_icon('lucide:plus', { class: 'size-4 mr-1.5' }) }}
                    Acheter des minutes
                </twig:Button>
            </div>
        </div>

        {# ── Abonnement (résumé) ── #}
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Abonnement</p>
            {% if ws.hasActiveSubscription %}
                <p class="text-sm font-semibold text-emerald-700">Actif</p>
                <a href="{{ path('app_settings_subscription') }}" class="mt-3 inline-block text-sm font-medium text-indigo-600 hover:underline">Gérer →</a>
            {% else %}
                <p class="text-sm text-slate-600">Aucun abonnement — vous êtes en essai gratuit.</p>
                <a href="{{ path('app_pricing') }}" class="mt-3 inline-block text-sm font-medium text-indigo-600 hover:underline">Voir les offres →</a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% extends '@app/onboarding/base_onboarding.html.twig' %}

{% set current_step = 4 %}

{% block title %}Configuration terminée | {{ company_name }}{% endblock %}

{% block form_content %}

    {# Écran de fin : un récapitulatif RÉEL de ce qui est configuré (aucun faux chargement). Les lignes apparaissent
       l'une après l'autre en CSS pur (classe .hero-enter, désactivée sous prefers-reduced-motion). #}
    <div class="text-center">

        <div class="hero-enter mx-auto mb-8 flex size-20 items-center justify-center rounded-full border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
            {{ ux_icon('lucide:check', { class: 'size-9 text-emerald-600', 'aria-hidden': 'true' }) }}
        </div>

        <h1 class="hero-enter text-balance text-4xl font-semibold leading-[1.08] tracking-[-0.03em] text-slate-900 sm:text-5xl" style="--reveal-delay: 80ms">
            Tout est prêt, {{ app.user.firstName|default('bienvenue') }}.
        </h1>
        <p class="hero-enter mx-auto mt-5 max-w-md text-lg leading-relaxed text-slate-600" style="--reveal-delay: 160ms">
            Votre espace est configuré. Voici ce qui vous attend.
        </p>
    </div>

    <ul class="mt-10 space-y-3" aria-label="Récapitulatif de votre configuration">

        <li class="hero-enter flex items-start gap-4 rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4" style="--reveal-delay: 260ms">
            {{ ux_icon('lucide:building-2', { class: 'mt-0.5 size-5 shrink-0 text-slate-600', 'aria-hidden': 'true' }) }}
            <div>
                <p class="text-[15px] font-semibold text-slate-900">Espace de travail</p>
                <p class="text-[14px] text-slate-600">{{ workspace_name }} · compte {{ account_type_label }}</p>
            </div>
        </li>

        {% if regulatory_profile_complete %}
            <li class="hero-enter flex items-start gap-4 rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4" style="--reveal-delay: 340ms">
                {{ ux_icon('lucide:file-badge', { class: 'mt-0.5 size-5 shrink-0 text-slate-600', 'aria-hidden': 'true' }) }}
                <div>
                    <p class="text-[15px] font-semibold text-slate-900">Profil réglementaire</p>
                    <p class="text-[14px] text-slate-600">Renseigné : vous pouvez générer vos Documents d'entrée en relation.</p>
                </div>
            </li>
        {% else %}
            {# Profil reporté ou incomplet : rappel honnête de la conséquence, sans bloquer l'accès #}
            <li class="hero-enter flex items-start gap-4 rounded-2xl border border-l-4 border-slate-200 border-l-amber-500 bg-white p-4" style="--reveal-delay: 340ms">
                {{ ux_icon('lucide:file-badge', { class: 'mt-0.5 size-5 shrink-0 text-slate-600', 'aria-hidden': 'true' }) }}
                <div>
                    <p class="text-[15px] font-semibold text-slate-900">Profil réglementaire à compléter</p>
                    <p class="text-[14px] leading-relaxed text-slate-600">
                        Tant qu'il est incomplet, la génération du DER reste indisponible. Retrouvez-le dans Paramètres › Profil réglementaire et dans la checklist du tableau de bord.
                    </p>
                </div>
            </li>
        {% endif %}

        {% if trial_dossiers is not null %}
            <li class="hero-enter flex items-start gap-4 rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4" style="--reveal-delay: 420ms">
                {{ ux_icon('lucide:sparkles', { class: 'mt-0.5 size-5 shrink-0 text-slate-600', 'aria-hidden': 'true' }) }}
                <div>
                    <p class="text-[15px] font-semibold text-slate-900">Essai gratuit</p>
                    <p class="text-[14px] text-slate-600">
                        {{ trial_dossiers }} dossier{{ trial_dossiers > 1 ? 's' : '' }} et {{ trial_minutes }}&nbsp;min d'entretien offerts, sans carte bancaire.
                    </p>
                </div>
            </li>
        {% endif %}
    </ul>

    <form action="{{ path('app_onboarding_completed') }}" method="post" class="hero-enter mt-10" style="--reveal-delay: 520ms">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding_completed') }}">
        <twig:Button type="submit" variant="dark" class="h-12 w-full rounded-full text-base">
            Accéder à mon espace
            {{ ux_icon('lucide:arrow-right', { class: 'size-4', 'aria-hidden': 'true' }) }}
        </twig:Button>
        <p class="mt-4 text-center text-[13px] text-slate-600">Vous pourrez modifier ces informations à tout moment dans les paramètres.</p>
    </form>

{% endblock %}

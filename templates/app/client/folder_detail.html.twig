{% extends '@app/client/layout_client.html.twig' %}

{% block title %}Détail du dossier | {{ company_name|default('KYSURE') }}{% endblock %}

{% block client_main %}
    <div class="mb-8">
        <a href="{{ path('portal_folders_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300 rounded-md">
            <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
            Retour
        </a>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ folder.title }}</h1>
                <p class="text-sm text-slate-500 mt-1">Réf: {{ folder.reference }} • Ouvert le {{ folder.openedAt|date('d/m/Y') }}</p>
            </div>

            <span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium ring-1 ring-inset shadow-sm w-fit {{ folder.status.badgeClasses }}">
                {{ folder.status.label }}
            </span>
        </div>
    </div>

    {# ============================================================= #}
    {# CE QUE VOUS AVEZ DÉJÀ FAIT                                     #}
    {# ============================================================= #}
    {% if folder.der %}
        <section class="mb-8">
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-2">
                <twig:ux:icon name="tabler:circle-check" class="size-4 text-emerald-600" aria-hidden="true" />
                Ce que vous avez déjà fait
            </h2>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-start gap-4 min-w-0">
                    <div class="p-2.5 bg-emerald-50 rounded-lg ring-1 ring-inset ring-emerald-500/20 shrink-0">
                        <twig:ux:icon name="tabler:signature" class="size-6 text-emerald-600" aria-hidden="true" />
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-semibold text-slate-900">Document d'Entrée en Relation</h3>
                        <p class="text-sm text-slate-500 mt-0.5 flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:lock" class="size-3.5 text-emerald-500" aria-hidden="true" />
                            Accusé de réception le {{ folder.der.acknowledgedAt|date('d/m/Y à H:i') }}
                        </p>
                        <p class="text-[11px] text-slate-400 font-mono mt-1 truncate" title="{{ folder.der.pdfSha256 }}">
                            Empreinte : {{ folder.der.pdfSha256 }}
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <a href="{{ folder.der.pdfStoragePath|private_url }}" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 px-3 py-2 rounded-lg transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300">
                        <twig:ux:icon name="tabler:download" class="size-4 text-slate-400" aria-hidden="true" />
                        Le DER
                    </a>
                    {% if folder.der.certificateStoragePath %}
                        <a href="{{ folder.der.certificateStoragePath|private_url }}" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 bg-slate-50 border border-slate-200 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300">
                            <twig:ux:icon name="tabler:shield-check" class="size-4" aria-hidden="true" />
                            <span class="sr-only sm:not-sr-only">Attestation</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# RAPPORTS D'ADÉQUATION REMIS PAR LE CONSEILLER (lot 5)         #}
    {# ============================================================= #}
    {% if folder.adequacyReports is not empty %}
        <section class="mb-8" aria-labelledby="heading-adequacy-reports">
            <h2 id="heading-adequacy-reports" class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-2">
                <twig:ux:icon name="tabler:file-certificate" class="size-4 text-slate-500" aria-hidden="true" />
                Vos rapports d'adéquation
            </h2>

            <ul class="bg-white rounded-xl border border-slate-200 shadow-sm divide-y divide-slate-100">
                {% for report in folder.adequacyReports %}
                    <li class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="min-w-0">
                            <h3 class="text-base font-semibold {{ report.inForce ? 'text-slate-900' : 'text-slate-600' }}">
                                Rapport d'adéquation — version {{ report.version }}
                                {% if not report.inForce %}<span class="ml-1 text-sm font-normal text-slate-500">(remplacé)</span>{% endif %}
                            </h3>
                            <p class="text-sm text-slate-500 mt-0.5">
                                Remis le {{ report.validatedAt|date('d/m/Y') }} :
                                {{ report.inForce ? 'il explique en quoi le conseil de votre conseiller correspond à votre situation.' : 'cette version a été remplacée, elle reste disponible pour vos archives.' }}
                            </p>
                            <p class="text-[11px] text-slate-400 font-mono mt-1 truncate" title="{{ report.contentHash }}">Empreinte : {{ report.contentHash }}</p>
                        </div>
                        <a href="{{ path('portal_adequacy_report_pdf', {slugId: report.slugId}) }}" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 px-3 py-2 rounded-lg transition-colors shadow-sm shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300">
                            <twig:ux:icon name="tabler:download" class="size-4 text-slate-400" aria-hidden="true" />
                            Télécharger
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# CE QU'IL VOUS RESTE À FAIRE (liste des pièces + soumission)   #}
    {# ============================================================= #}
    <section>
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-2">
            <twig:ux:icon name="tabler:list-check" class="size-4 text-amber-600" aria-hidden="true" />
            Ce qu'il vous reste à faire
        </h2>

        <twig:ClientPortalDocumentListComponent folderId="{{ folder.id }}" />
    </section>
{% endblock %}

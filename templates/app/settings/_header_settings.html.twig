<div class="mb-6 lg:mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ page_title }}</h1>
    <p class="text-sm text-slate-500 mt-1">{{ sub_title }}</p>
</div>

{# 1. Le conteneur "Mobile-First" : overflow-x-auto permet le swipe sur mobile #}
<div class="w-full overflow-x-auto mb-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

    {# 2. min-w-max empêche les liens de s'écraser les uns sur les autres #}
    <nav class="flex items-center gap-6 sm:gap-8 min-w-max pb-1" aria-label="Settings Navigation">

        {% set current_route = app.request.attributes.get('_route') %}

        {# Macro simplifiée pour les liens #}
        {% macro nav_link(route, label, current_route) %}
            {% set is_active = (current_route == route) %}
            <a href="{{ path(route) }}"
                {# 3. shrink-0 et whitespace-nowrap sont obligatoires pour le mobile #}
               class="shrink-0 whitespace-nowrap pb-4 text-sm font-medium transition-all duration-200 cursor-pointer
                      {{ is_active
               ? 'text-violet-600 underline decoration-violet-600 decoration-2 underline-offset-[13px]'
               : 'text-slate-500 hover:text-violet-600 hover:underline hover:decoration-violet-600/30 hover:underline-offset-[13px]'
               }}">
                {{ label }}
            </a>
        {% endmacro %}

        {% import _self as ui %}

        {# Les liens de navigation #}
        {{ ui.nav_link('app_settings_account', 'Mon compte', current_route) }}

        {% if workspace_can('edit_cabinet') %}
            {{ ui.nav_link('app_settings_regulatory_profile', 'Profil réglementaire', current_route) }}
            {{ ui.nav_link('app_settings_organization', 'Organisation', current_route) }}
        {% endif %}

        {% if workspace_can('billing') %}
            {{ ui.nav_link('app_settings_subscription', 'Abonnement', current_route) }}
            {{ ui.nav_link('app_settings_billing', 'Usage & minutes', current_route) }}
            {{ ui.nav_link('app_pricing', 'Offres & tarifs', current_route) }}
        {% endif %}

        {{ ui.nav_link('app_settings_logs', 'Audit Logs', current_route) }}
        {{ ui.nav_link('app_employees_list', 'Équipe & Accès', current_route) }}

        {% if workspace_can('manage_permissions') %}
            {{ ui.nav_link('app_settings_team_permissions', 'Rôles & permissions', current_route) }}
        {% endif %}

    </nav>
</div>

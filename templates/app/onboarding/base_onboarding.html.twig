<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# SEO : Onboarding = privé, donc on bloque les moteurs, mais on garde une structure propre #}
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="Configurez votre espace de travail {{ company_name|default(company_name) }} en quelques étapes.">

    <title>{% block title %}{{ company_name|default(company_name) }} | Onboarding{% endblock %}</title>
    {% include '_favicons.html.twig' %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="min-h-full bg-white font-sans text-slate-900 selection:bg-blue-100">

{# Étapes du parcours de configuration — l'étape courante vient du gabarit enfant (`current_step`). #}
{% set steps = ['Espace de travail', 'Type de compte', 'Profil réglementaire', 'Finalisation'] %}
{% set step = current_step|default(1) %}

{# ACCESSIBILITÉ : Lien d'évitement #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-slate-900 focus:text-white focus:rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900">
    Aller au contenu principal
</a>

<div class="relative isolate flex min-h-screen flex-col">

    {# Halo très discret en tête de page : profondeur sans bruit visuel #}
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] bg-gradient-to-b from-slate-50 to-white" aria-hidden="true"></div>

    <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-5 py-5 sm:px-8">
        <div class="flex items-center gap-2">
            <div class="flex size-7 items-center justify-center rounded bg-black text-sm font-bold text-white" aria-hidden="true">K</div>
            <span class="text-[17px] font-bold tracking-tight text-slate-900">{{ company_name|default(company_name) }}</span>
        </div>
        <a href="mailto:support@{{ company_name|default(company_name)|lower }}.com?subject=Aide Onboarding : {{ app.user.email|default('') }}"
           class="rounded-full px-3 py-1.5 text-[14px] text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">
            Besoin d'aide ?
        </a>
    </header>

    <main id="main-content" tabindex="-1" class="flex flex-1 flex-col items-center px-5 pb-20 pt-6 outline-none sm:px-8 sm:pt-14">
        <div class="w-full max-w-xl">

            {# Progression : un segment par étape (le texte porte le sens, les segments sont visuels) #}
            <nav aria-label="Progression de la configuration" class="mb-10">
                <ol class="flex gap-1.5">
                    {% for label in steps %}
                        <li class="h-1 flex-1 rounded-full transition-colors duration-500 {{ loop.index <= step ? 'bg-slate-900' : 'bg-slate-200' }}"
                            {% if loop.index == step %}aria-current="step"{% endif %}>
                            <span class="sr-only">{{ loop.index }}. {{ label }}{% if loop.index < step %} : terminé{% elseif loop.index == step %} : étape actuelle{% endif %}</span>
                        </li>
                    {% endfor %}
                </ol>
            </nav>

            <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">
                Étape {{ step }} sur {{ steps|length }} · {{ steps[step - 1] }}
            </p>

            <div class="mt-4 animate-in fade-in slide-in-from-bottom-4 duration-700 motion-reduce:animate-none">
                {% block form_content %}{% endblock %}
            </div>

            <p class="mt-10 flex items-center justify-center gap-2 text-[13px] text-slate-600">
                {{ ux_icon('lucide:lock', { class: 'size-3.5', 'aria-hidden': 'true' }) }}
                Connexion sécurisée
            </p>
        </div>
    </main>
</div>
{% include '@app/partials/_flashes.html.twig' %}
</body>
</html>

{% extends '@website/base.html.twig' %}

{% block title %}Connexion — {{ company_name }}{% endblock %}

{% block body %}
    <main class="flex min-h-screen w-full bg-white text-[#1a1a1a] font-sans antialiased selection:bg-[#cce4ff]">

        {# =========================================================
           MOITIÉ GAUCHE : ESPACE STRUCTURÉ (Gradient Subtil)
           ========================================================= #}
        <aside class="relative hidden w-1/2 flex-col border-r border-[#e6e6e6] bg-gradient-to-b from-[#f7f7f5] via-[#f7f7f5] to-[#f0f7ff] p-12 lg:flex overflow-hidden">

            {# Halo de lumière discret pour la profondeur #}
            <div class="absolute -bottom-24 -left-24 size-96 bg-blue-100/40 blur-[100px] rounded-full pointer-events-none"></div>

            {# Logo #}
            <div class="relative z-10 flex items-center gap-2 text-[17px] font-bold tracking-tight mb-20">
                <div class="flex size-7 items-center justify-center rounded bg-black text-white font-bold text-sm" aria-hidden="true">K</div>
                <a href="{{ path('website_home') }}" title="Retour à l'accueil {{ company_name }}">
                    {{ company_name }}
                </a>
            </div>

            {# Contenu central #}
            <div class="relative z-10 max-w-sm space-y-12">
                <header class="space-y-4">
                    <h2 class="text-[40px] font-bold leading-[1.1] tracking-tight text-[#1a1a1a]">
                        Votre espace <br>
                        <span class="text-[#0060df]">conformité.</span>
                    </h2>
                    <p class="text-[17px] text-[#666] leading-relaxed">
                        Retrouvez tous vos outils de vigilance centralisés en un seul endroit.
                    </p>
                </header>

                {# Liste de rappel avec Symfony UX Icons #}
                <nav class="space-y-6" aria-label="Aperçu des fonctionnalités">

                    <div class="flex items-start gap-4 group">
                        <div class="size-10 shrink-0 rounded-lg bg-white/80 border border-[#e6e6e6] flex items-center justify-center shadow-sm group-hover:border-[#0060df]/30 transition-colors">
                            <twig:ux:icon name="lucide:folder-kanban" class="size-5 text-slate-600" />
                        </div>
                        <div>
                            <h3 class="text-[15px] font-bold text-[#1a1a1a]">Gestion des dossiers</h3>
                            <p class="text-[13px] text-[#999]">Centralisez vos KYC et KYB par client.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 group">
                        <div class="size-10 shrink-0 rounded-lg bg-white/80 border border-[#e6e6e6] flex items-center justify-center shadow-sm group-hover:border-[#0060df]/30 transition-colors">
                            <twig:ux:icon name="lucide:user-search" class="size-5 text-slate-600" />
                        </div>
                        <div>
                            <h3 class="text-[15px] font-bold text-[#1a1a1a]">Screening instantané</h3>
                            <p class="text-[13px] text-[#999]">Interrogez les listes PPE et Sanctions.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 group">
                        <div class="size-10 shrink-0 rounded-lg bg-white/80 border border-[#e6e6e6] flex items-center justify-center shadow-sm group-hover:border-[#0060df]/30 transition-colors">
                            <twig:ux:icon name="lucide:file-badge" class="size-5 text-slate-600" />
                        </div>
                        <div>
                            <h3 class="text-[15px] font-bold text-[#1a1a1a]">Piste d'audit</h3>
                            <p class="text-[13px] text-[#999]">Générez vos rapports certifiés Tracfin.</p>
                        </div>
                    </div>
                </nav>
            </div>

            {# Bas de page #}
            <div class="relative z-10 mt-auto pt-12">
                <div class="h-[1px] w-12 bg-[#e6e6e6] mb-4"></div>
                <p class="text-[11px] font-bold text-[#bbb] uppercase tracking-widest">
                    Simple · Sécurisé · Conforme
                </p>
            </div>
        </aside>

        {# =========================================================
           MOITIÉ DROITE : LE FORMULAIRE
           ========================================================= #}
        <section class="relative flex w-full flex-col items-center justify-center p-6 lg:w-1/2 sm:p-12">

            {# Logo Mobile uniquement #}
            <div class="absolute left-6 top-6 flex items-center gap-2 lg:hidden">
                <div class="flex size-7 items-center justify-center rounded bg-black text-white font-bold text-sm">K</div>
                <span class="font-bold text-[#1a1a1a]">{{ company_name }}</span>
            </div>

            {# Bouton de switch Inscription #}
            <div class="absolute right-6 top-6 md:right-8 md:top-8 z-10">
                <a href="{{ path('app_register') }}" class="text-[14px] font-bold text-[#4d4d4d] hover:text-black transition-colors px-4 py-2 hover:bg-[#f5f5f5] rounded-[6px]">
                    Créer un compte
                </a>
            </div>

            {# Formulaire #}
            <div class="w-full max-w-[350px] space-y-8">
                <header class="space-y-3">
                    <h1 class="text-[28px] font-bold tracking-tight text-[#1a1a1a]">Bon retour.</h1>
                    <p class="text-[15px] text-[#666] leading-relaxed">
                        Saisissez votre adresse email professionnelle pour vous connecter.
                    </p>
                </header>

                <div class="py-2">
                    <twig:LoginUserFormComponent></twig:LoginUserFormComponent>
                </div>

                {# Orientation des clients finaux : cette page est celle des professionnels #}
                <div class="rounded-xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-4">
                    <p class="text-[14px] font-semibold text-slate-900">Vous êtes client d’un cabinet&nbsp;?</p>
                    <p class="mt-1 text-[13px] leading-relaxed text-slate-600">
                        Cette page est destinée aux professionnels.
                        <a href="{{ path('website_client_access') }}" class="font-medium text-slate-900 underline underline-offset-4 hover:text-blue-700 focus-visible:rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">Accéder à l’espace client</a>
                    </p>
                </div>

                <footer class="pt-4 border-t border-[#f0f0f0]">
                    <p class="text-center text-[12px] text-[#999]">
                        En continuant, vous acceptez nos
                        <a href="#" class="text-[#666] underline underline-offset-4 hover:text-black transition-colors">CGU</a> et notre
                        <a href="#" class="text-[#666] underline underline-offset-4 hover:text-black transition-colors">Politique de confidentialité</a>.
                    </p>
                </footer>
            </div>
        </section>
    </main>
{% endblock %}

{
    "name": "symfony/skeleton",
    "type": "project",
    "license": "MIT",
    "description": "A minimal Symfony project recommended to create bare bones applications",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.18",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "aws/aws-sdk-php": "^3.392.2",
        "babdev/pagerfanta-bundle": "^4.6",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.8",
        "dragonmantank/cron-expression": "^3.6",
        "endroid/qr-code": "^6.1",
        "endroid/qr-code-bundle": "^7.0",
        "geoip2/geoip2": "^3.4",
        "intervention/image": "^4.2.1",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "league/flysystem-bundle": "^3.7.1",
        "matomo/device-detector": "^6.5.1",
        "mindee/mindee": "^2.9.0",
        "pagerfanta/doctrine-orm-adapter": "^4.8",
        "pagerfanta/twig": "^4.8",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.3",
        "scheb/2fa-bundle": "^8.6.1",
        "scheb/2fa-google-authenticator": "^8.6.1",
        "scheb/2fa-trusted-device": "^8.6.1",
        "sensiolabs/gotenberg-bundle": "^1.4.0",
        "sentry/sentry-symfony": "^5.12",
        "stripe/stripe-php": "^20.3.1",
        "symfony/amqp-messenger": "8.0.*",
        "symfony/asset": "8.0.*",
        "symfony/asset-mapper": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/doctrine-messenger": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/expression-language": "8.0.*",
        "symfony/flex": "^2.10",
        "symfony/form": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/lock": "8.0.*",
        "symfony/mailer": "8.0.*",
        "symfony/mercure-bundle": "^0.4.3",
        "symfony/messenger": "8.0.*",
        "symfony/mime": "8.0.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "8.0.*",
        "symfony/process": "8.0.*",
        "symfony/property-access": "8.0.*",
        "symfony/property-info": "8.0.*",
        "symfony/rate-limiter": "8.0.*",
        "symfony/resend-mailer": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/scheduler": "8.0.*",
        "symfony/security-bundle": "8.0.*",
        "symfony/serializer": "8.0.*",
        "symfony/slack-notifier": "8.0.*",
        "symfony/twig-bridge": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/uid": "8.0.*",
        "symfony/ux-chartjs": "^3.4",
        "symfony/ux-icons": "^3.4",
        "symfony/ux-live-component": "^3.4",
        "symfony/ux-toolkit": "^3.4",
        "symfony/ux-turbo": "^3.4",
        "symfony/ux-twig-component": "^3.1",
        "symfony/validator": "8.0.*",
        "symfony/webhook": "8.0.*",
        "symfony/workflow": "8.0.*",
        "symfony/yaml": "8.0.*",
        "symfonycasts/tailwind-bundle": "^0.12.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.0.0",
        "twig/extra-bundle": "^3.24",
        "twig/html-extra": "^3.24.0",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^2.12|^3.28",
        "webmozart/assert": "^2.4.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts",
            "@env:sanitize"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "rector": "vendor/bin/rector process",
        "rector-check": "vendor/bin/rector process --dry-run",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff -v",
        "phpstan": "vendor/bin/phpstan analyze src --level=8 --memory-limit=2G",
        "deptrac": "php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/deptrac analyze",
        "security-audit": "composer audit",
        "init-product": "bin/console app:init-products",
        "seed-user": "bin/console app:user:seed",
        "seed-workspace": "bin/console app:workspace:seed",
        "lint": "bin/console lint:twig templates && bin/console lint:yaml config",
        "env:sanitize": "php bin/sanitize-env.php",
        "format": [
            "@rector",
            "@fix"
        ],
        "check": [
            "@env:sanitize",
            "@rector-check",
            "@cs-check",
            "@lint",
            "@phpstan",
            "@deptrac",
            "@security-audit"
        ],
        "init-pro": [
            "@init-product",
            "@seed-user",
            "@seed-workspace"
        ],
        "test": "vendor/bin/phpunit",
        "tests-application": "./bin/phpunit --testdox tests/Application",
        "messenger": "php bin/console messenger:consume --all -vv",
        "tailwind": "php bin/console tailwind:build --watch"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*",
            "docker": true
        }
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.1",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "phpro/grumphp": "^2.23",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.1",
        "rector/rector": "^2.6.2",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "8.0.*",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.0.*",
        "symfony/web-profiler-bundle": "8.0.*"
    }
}

{% extends '@admin/base_admin.html.twig' %}
{# templates/admin/dashboard/index.html.twig #}

{% block title %}Kysure | Administration Système{% endblock %}

{% block page_title %}Vue d'ensemble{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Page class="text-xs">Administration</twig:Breadcrumb:Page>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}


        <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Centre de <span class="text-violet-600">contrôle</span></h1>
                <p class="text-sm text-slate-500 mt-1">Supervision globale de l'activité, des revenus et de la santé du système.</p>
            </div>
            <div class="flex items-center gap-3">
                <button class="px-4 py-2 bg-white border border-slate-200 text-sm font-medium text-slate-700 rounded-xl hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
                    {{ ux_icon('lucide:download', { class: 'size-4' }) }}
                    Exporter les logs
                </button>
            </div>
        </header>

        {# ========================================================= #}
        {# GRID PRINCIPALE : 1/3 (Stats) - 2/3 (Listes)              #}
        {# ========================================================= #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

            {# ----------------------------------------------------- #}
            {# COLONNE GAUCHE : STATISTIQUES (Sans Card)             #}
            {# lg:col-span-4 prend 4 colonnes sur 12 (soit 1/3)      #}
            {# ----------------------------------------------------- #}
            <div class="lg:col-span-4 space-y-10 sticky top-24">

                {# GROUPE 1 : Business & Système #}
                <div>
                    <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Business & Système</h2>
                    <ul class="space-y-1">

                        {# MRR #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-emerald-100 rounded-lg text-emerald-700">
                                    {{ ux_icon('lucide:euro', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Revenus (MRR)</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.mrr|default(0)|format_currency('EUR', {fraction_digit: 0}, 'fr') }}</span>
                                <div class="text-[10px] font-bold text-emerald-600">+8%</div>
                            </div>
                        </li>

                        {# Workspaces #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-blue-100 rounded-lg text-blue-700">
                                    {{ ux_icon('lucide:building-2', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Workspaces Actifs</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.activeWorkspaces|default(0) }}</span>
                                <div class="text-[10px] text-slate-400">sur {{ stats.totalWorkspaces|default(0) }}</div>
                            </div>
                        </li>

                        {# Support #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-amber-100 rounded-lg text-amber-700">
                                    {{ ux_icon('lucide:life-buoy', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Tickets ouverts</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.openTickets|default(0) }}</span>
                                <div><a href="{{ path('app_support_list')|default('#') }}" class="text-[10px] font-medium text-amber-600 hover:underline">Gérer</a></div>
                            </div>
                        </li>

                        {# API #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-indigo-100 rounded-lg text-indigo-700">
                                    {{ ux_icon('lucide:activity', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Succès API</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.apiSuccessRate|default(100) }}%</span>
                                <div class="text-[10px] text-slate-400">24h glissantes</div>
                            </div>
                        </li>
                    </ul>
                </div>

                {# GROUPE 2 : Adoption & Usage #}
                <div>
                    <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Adoption & Usage</h2>
                    <ul class="space-y-1">

                        {# KYC #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-violet-100 rounded-lg text-violet-700">
                                    {{ ux_icon('lucide:user-check', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Dossiers KYC</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.totalKycCreated|default(0) }}</span>
                                <div class="text-[10px] text-slate-400">Total généré</div>
                            </div>
                        </li>

                        {# Screenings #}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 bg-violet-100 rounded-lg text-violet-700">
                                    {{ ux_icon('lucide:shield-alert', { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">Screenings LCB-FT</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900">{{ stats.totalScreeningsDone|default(0) }}</span>
                                <div class="text-[10px] text-slate-400">Analyses effectuées</div>
                            </div>
                        </li>

                    </ul>
                </div>

            </div>

            {# ----------------------------------------------------- #}
            {# COLONNE DROITE : LES LISTES D'ACTIVITÉ                #}
            {# lg:col-span-8 prend 8 colonnes sur 12 (soit 2/3)      #}
            {# ----------------------------------------------------- #}
            <div class="lg:col-span-8 space-y-6">

                {# LISTE 1 : DERNIÈRES INSCRIPTIONS #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col">
                    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            {{ ux_icon('lucide:users', { class: 'size-4 text-slate-400' }) }}
                            Nouveaux Workspaces
                        </h2>
                        <a href="{{ path('admin_workspaces_list')|default('#') }}" class="text-xs font-medium text-violet-600 hover:text-violet-700">Voir tout</a>
                    </div>

                    <div class="p-2 space-y-1">
                        {% for workspace in stats.latestWorkspaces %}
                            <a href="{{ path('admin_workspaces_show', {slugId: workspace.slugId}) }}" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-lg transition-colors group cursor-pointer">
                                <div class="flex items-center gap-4">
                                    <div class="size-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-sm uppercase border border-slate-200">
                                        {# Affichage des 2 premières lettres du nom #}
                                        {{ workspace.name|slice(0, 2) }}
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900 group-hover:text-violet-700 transition-colors">{{ workspace.name }}</p>
                                        {# Si le Workspace a une relation Owner/User, affiche l'email. Sinon affiche la date de création complète #}
                                        <p class="text-xs text-slate-500">Inscrit le {{ workspace.createdAt|date('d/m/Y') }}</p>
                                    </div>
                                </div>
                                <div class="text-right flex items-center gap-4">
                                    {# Gérer le badge en fonction de ton entité #}
                                    {% if workspace.isFirm %}
                                        <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-700 ring-1 ring-inset ring-blue-600/20">Cabinet</span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-700 ring-1 ring-inset ring-slate-600/20">Client</span>
                                    {% endif %}

                                    <div class="text-right">
                                        <p class="text-xs font-medium text-slate-700">{{ workspace.createdAt|date('H:i') }}</p>
                                    </div>
                                </div>
                            </a>
                        {% else %}
                            <div class="text-center p-4 text-sm text-slate-500">
                                Aucun workspace inscrit récemment.
                            </div>
                        {% endfor %}
                    </div>
                </section>

                {# LISTE 2 : ALERTES D'AUDIT / SYSTÈME #}
                {# ALERTES D'AUDIT / SYSTÈME #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col">
                    {# --- EN-TÊTE DU COMPOSANT --- #}
                    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            Journal d'Audit Récent
                        </h2>
                        <a href="{{ path('admin_audit_logs_list')|default('#') }}" class="text-xs font-bold text-[#6e2f1e] hover:text-[#5a2517] transition-colors">
                            Voir tous les logs &rarr;
                        </a>
                    </div>

                    {# --- LISTE COMPACTE DES LOGS --- #}
                    <div class="p-2 space-y-1">
                        {% for log in stats.latestAuditLogs %}
                            <div class="flex items-center justify-between p-3 hover:bg-slate-50/80 rounded-lg transition-colors group cursor-pointer border border-transparent hover:border-slate-200/60">

                                {# Gauche : Acteur & Action #}
                                <div class="flex items-center gap-3 min-w-0 pr-2">

                                    {# Avatar / Icône Acteur #}
                                    <div class="size-8 shrink-0 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center shadow-sm" aria-hidden="true">
                                        {% if log.payload.actor_email is defined and 'system' in log.payload.actor_email|lower %}
                                            <twig:ux:icon name="tabler:cpu" class="size-4 text-slate-500" />
                                        {% else %}
                                            <twig:ux:icon name="tabler:user-shield" class="size-4 text-slate-600" />
                                        {% endif %}
                                    </div>

                                    {# Informations Acteur & Badge Événement #}
                                    <div class="flex flex-col min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            {# Badge Événement Dynamique (Utilise le helpergetBadgeColor() de l'enum) #}
                                            {% if log.eventName %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border {{ log.eventName.getBadgeColor() }}">
                                    {{ log.eventName.getLabel() }}
                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border bg-slate-100 text-slate-600 border-slate-200">
                                    Événement inconnu
                                </span>
                                            {% endif %}
                                        </div>

                                        {# Acteur #}
                                        <div class="flex items-center gap-1.5 mt-1 text-xs text-slate-600">
                            <span class="font-bold text-slate-900 truncate">
                                {{ log.payload.actor_name|default('Système Kysure') }}
                            </span>
                                            {% if log.payload.actor_email is defined and log.payload.actor_email %}
                                                <span class="text-slate-400">&bull;</span>
                                                <span class="text-[11px] text-slate-500 truncate font-mono">
                                    {{ log.payload.actor_email }}
                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {# Droite : Horodatage #}
                                <div class="text-right shrink-0">
                                    <p class="text-xs font-bold text-slate-900">{{ log.occurredAt|date('d/m/Y') }}</p>
                                    <p class="text-[11px] text-slate-500 flex items-center justify-end gap-1 font-mono mt-0.5">
                                        <twig:ux:icon name="tabler:clock" class="size-3 text-slate-400" />
                                        {{ log.occurredAt|date('H:i:s') }}
                                    </p>
                                </div>

                            </div>
                        {% else %}
                            <div class="text-center py-8 px-4 text-xs text-slate-500 flex flex-col items-center justify-center gap-2">
                                <twig:ux:icon name="tabler:file-off" class="size-8 text-slate-300" />
                                <p class="font-medium">Aucun événement d'audit récent enregistre.</p>
                            </div>
                        {% endfor %}
                    </div>
                </section>

            </div>
        </div>

{% endblock %}

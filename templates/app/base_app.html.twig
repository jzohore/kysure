<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"> {# Sécurité mobile : empêche le zoom auto #}
    <meta name="robots" content="noindex, nofollow"> {# Sécurité : On n'indexe pas l'admin #}

    <title>{% block title %}{{ company_name }} | Dashboard{% endblock %}</title>

    <link rel="canonical" href="{{ app.request.getSchemeAndHttpHost() ~ app.request.getRequestUri() }}">
    {# Favicon propre #}
    {% include '_favicons.html.twig' %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% block stylesheets %}{% endblock %}
</head>

{# On ajoute le contrôleur Stimulus au body pour gérer l'ouverture/fermeture du menu #}
<body class="h-full text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-700" data-controller="support">

{# Skip to content : Accessibilité essentielle #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-blue-600">
    Passer au contenu principal
</a>

<div class="flex h-screen overflow-hidden bg-[#faf9f5]" data-controller="sidebar">

    {# Sidebar flottante partagée #}
    {% set _nav_items = [] %}
    {% for item in enum('App\\Infrastructure\\Shared\\Menu\\ComplianceMenuItem').cases %}
        {% set _nav_items = _nav_items|merge([{
            icon: item.icon,
            label: item.label,
            href: path(item.route),
            active: app.request.attributes.get('_route') == item.route,
        }]) %}
    {% endfor %}
    {% include '@app/partials/_sidebar.html.twig' with {
        brand: company_name,
        brand_href: path('app_dashboard'),
        sections: [{ items: _nav_items }],
        user_name: app.user.fullName,
        user_email: app.user.email,
        user_initials: app.user.initials,
        user_links: [
            { icon: 'lucide:settings', label: 'Paramètres', href: path('app_settings_account') },
            { icon: 'lucide:life-buoy', label: 'Support', href: path('app_support_list') },
            { icon: 'lucide:log-out', label: 'Déconnexion', href: path('app_logout'), danger: true },
        ],
    } only %}

    {% set dynamic_breadcrumbs %}
        {% block breadcrumb_items %}{% endblock %}
    {% endset %}
    {% set title_page %}
        {% block page_title %}Vue d'ensemble{% endblock %}
    {% endset %}

    <main id="main-content" class="flex-1 flex flex-col min-w-0 w-full">

        {# ==========================================
           BANNIÈRE CONNEXION SUPPORT (impersonation)
           Visible tant qu'un opérateur KYSURE agit en tant que ce collaborateur.
           ========================================== #}
        {% set _impersonation = app.session.get('_support_impersonation') %}
        {% if _impersonation %}
            <div class="flex-shrink-0 bg-amber-500 text-amber-950 px-4 sm:px-6 py-2 flex items-center justify-between gap-3 text-xs font-medium z-40">
                <div class="flex items-center gap-2 min-w-0">
                    <twig:ux:icon name="tabler:spy" class="size-4 shrink-0" />
                    <span class="truncate">
                        Connexion support active — vous agissez en tant que
                        <strong>{{ _impersonation.target_name }}</strong> ({{ _impersonation.target_email }}).
                        Opérateur : {{ _impersonation.operator_name }}.
                    </span>
                </div>
                <form method="post" action="{{ path('app_support_impersonate_stop') }}" class="shrink-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('stop-impersonation') }}">
                    <button type="submit"
                            class="rounded-md bg-amber-950 px-3 py-1 font-bold text-amber-50 hover:bg-amber-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-amber-500">
                        Quitter la session support
                    </button>
                </form>
            </div>
        {% endif %}

        {# ==========================================
       HEADER (Esprit Figma : Dense & Minimaliste)
       ========================================== #}
        {# h-14 (56px) sur desktop pour un look compact, h-16 sur mobile #}
        <header class="flex-shrink-0 min-h-16 sm:min-h-14 bg-[#faf9f5]/80 backdrop-blur-md flex items-center justify-between px-4 sm:px-6 z-30 sticky top-0">

            {# --- PARTIE GAUCHE : Navigation --- #}
            <div class="flex items-center gap-3 overflow-hidden">

                {# Bouton Hamburger (Visible que sur mobile) #}
                <button type="button"
                        data-action="click->sidebar#open"
                        class="md:hidden p-2 -ml-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">
                    <twig:ux:icon name="lucide:menu" class="w-5 h-5" />
                </button>

                {# Breadcrumb complet (Desktop) - Typographie affinée #}
                <nav aria-label="Fil d'ariane" class="hidden sm:block">
                    <twig:Breadcrumb>
                        <twig:Breadcrumb:List class="gap-1.5">
                            <twig:Breadcrumb:Item>
                                <twig:Breadcrumb:Link href="{{ path('app_dashboard') }}" class="flex items-center gap-1.5 text-slate-500 hover:text-slate-800 transition-colors">
                                    <twig:ux:icon name="material-symbols:home-rounded" class="size-3.5" />
                                    <span class="text-[13px] font-medium">
                                    {{ workspaceInfo().name | lower | capitalize }}
                                </span>
                                </twig:Breadcrumb:Link>
                            </twig:Breadcrumb:Item>

                            {{ dynamic_breadcrumbs }}

                            <twig:Breadcrumb:Separator class="[&>svg]:size-3.5 text-slate-300" />
                            <twig:Breadcrumb:Item>
                                <twig:Breadcrumb:Page class="text-[13px] font-medium text-slate-800">
                                    {{ title_page }}
                                </twig:Breadcrumb:Page>
                            </twig:Breadcrumb:Item>
                        </twig:Breadcrumb:List>
                    </twig:Breadcrumb>
                </nav>

                {# Titre simple (Mobile) #}
                <h1 class="sm:hidden font-semibold text-[14px] text-slate-800 truncate">
                    {{ title_page }}
                </h1>
            </div>

            {# --- PARTIE DROITE : Actions --- #}
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">

                {# 1. Badge Crédits / Essai (Style Pill minimaliste) #}
{#                {% if workspaceInfo().isFirm %}#}
{#                    {% set isTrial = subInfo().status == 'trialing' %}#}
{#                    {% if isTrial and subInfo().trialDaysRemaining <= 10 and subInfo().trialDaysRemaining > 0 %}#}
{#                        <a href="{{ path('app_settings_subscription') }}"#}
{#                           class="hidden sm:inline-flex items-center rounded-md bg-amber-50 px-2 h-8 text-[12px] font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20 hover:bg-amber-100 transition-colors">#}
{#                            Essai : {{ subInfo().trialDaysRemaining }} j#}
{#                        </a>#}
{#                    {% endif %}#}
{#                {% endif %}#}

                {% block header_actions %}{% endblock %}

                {% block button_page %}
                    {# 2. Bouton d'action principal (+) - size-8 sur Desktop #}
                    <div class="relative group inline-block">
                        <button type="button"
                                aria-haspopup="menu"
                                class="flex items-center justify-center size-9 sm:size-8 rounded-md bg-violet-600 text-white shadow-sm hover:bg-violet-700 transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-1">
                            {{ ux_icon('lucide:plus', { class: 'size-4' }) }}
                        </button>

                        {# MENU DÉROULANT (+) : Architecture ultra-dense #}
                        <div role="menu"
                             class="absolute right-0 mt-1.5 w-56 bg-white rounded-lg shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-slate-200/80 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 focus-within:opacity-100 focus-within:visible focus-within:translate-y-0 transition-all duration-150 z-50">

                            <div class="p-1">

                                {# ACTION 1 : Le fameux "Zéro Friction" (Déclenche le Modal) #}
                                <a href="{{ path('app_onboarding_qr') }}"
                                   target="_blank"
                                   role="menuitem"
                                   class="flex items-center gap-2.5 px-2 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors text-left cursor-pointer outline-none focus:bg-slate-50">
                                    {{ ux_icon('lucide:qr-code', { class: 'size-3.5 text-indigo-500' }) }}
                                    Onboarding Flash
                                </a>

                                <div class="h-px bg-slate-100 my-1 mx-2"></div>

                                <div class="px-2 py-1.5 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">
                                    Création à distance
                                </div>

                                {# ACTION 2 : La saisie manuelle classique #}
                                <a href="{{ path('app_compliance_new') }}"
                                   role="menuitem"
                                   class="flex items-center gap-2.5 px-2 py-1.5 text-[13px] font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors outline-none focus:bg-slate-50">
                                    {{ ux_icon('lucide:folder-plus', { class: 'size-3.5 text-slate-400' }) }}
                                    Saisie manuelle du dossier
                                </a>

                            </div>
                        </div>
                    </div>
                {% endblock %}
            </div>
        </header>

        {# CONTENU PRINCIPAL #}
        <div class="flex-1 overflow-y-auto">
            <div class="max-w-6xl mx-auto p-4 sm:p-6 md:p-8 space-y-6 sm:space-y-8 pb-24">

                {# ── Incitation 2FA (non bloquante) : bandeau une ligne, masquable
                   pour la session, réapparaît à la connexion suivante. ── #}
                {% if app.user and not is_granted('IS_IMPERSONATOR') and not app.user.isGoogleAuthenticatorEnabled() %}
                    <div data-controller="dismissible" data-dismissible-key-value="twofa-nudge" hidden
                         class="flex items-center gap-3 rounded-lg border border-slate-200 border-l-2 border-l-amber-500 bg-white px-3 py-2 text-sm">
                        <span class="shrink-0 text-amber-500" aria-hidden="true">{{ ux_icon('lucide:shield-alert', { class: 'size-4' }) }}</span>
                        <p class="min-w-0 flex-1 text-slate-600 truncate">
                            Double authentification non activée.
                            <a href="{{ path('app_settings_account') }}" class="font-medium text-slate-900 hover:underline">Activer maintenant</a>
                        </p>
                        <button type="button" data-action="dismissible#dismiss"
                                class="shrink-0 rounded p-1 text-slate-400 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
                                aria-label="Masquer ce rappel pour cette session">
                            {{ ux_icon('lucide:x', { class: 'size-3.5' }) }}
                        </button>
                    </div>
                {% endif %}

                {% block content %}{% endblock %}
            </div>
        </div>
    </main>

</div>
{% include '@app/partials/_flashes.html.twig' %}
{% if  app.user.profile.dismissOnboarding %}
<twig:SupportChatComponent userUuid="{{ app.user.id }}" urlContext="{{ app.request.uri }}"></twig:SupportChatComponent>
{% endif %}
{% if app.environment in ['dev', 'staging'] %}
    {% include '@app/partials/_feedback_widget.html.twig' %}
{% endif %}
</body>
</html>

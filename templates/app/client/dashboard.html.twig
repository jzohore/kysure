{# 🚨 CORRECTIF N°1 : On utilise le layout global, et SURTOUT PAS le layout billing #}
{% extends '@app/client/layout_client.html.twig' %}

{% block title %}Mon Espace Sécurisé | {{ company_name }}{% endblock %}


{% block client_main %}
    {# 1. HEADER PAGE #}
    <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            Bonjour {{ dashboard.clientFirstName }},
        </h1>
        <p class="text-sm sm:text-base text-slate-600 mt-1">
            Voici un résumé de votre situation réglementaire.
        </p>
    </div>

    {# 2. LA PRIORITÉ : LE DOSSIER ACTIF (Pleine largeur) #}
    {% if dashboard.activeFolder %}
        {% set status = dashboard.portalStatus %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8">
            <div class="border-l-4 {{ status.accentBorderClass }} p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
                    <div class="flex items-start gap-4">
                        <div class="p-2.5 rounded-lg ring-1 ring-inset {{ status.iconWrapClasses }} shrink-0">
                            <twig:ux:icon name="tabler:shield-lock" class="size-6" aria-hidden="true" />
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-slate-900 tracking-tight">
                                {{ dashboard.activeFolder.title }}
                            </h2>
                            <p class="text-sm text-slate-600 mt-1.5 leading-relaxed max-w-xl">
                                {% if status.value == 'action_required' %}
                                    Votre cabinet requiert <strong>{{ dashboard.pendingDocumentsCount }} pièce(s) justificative(s)</strong> pour finaliser la mise en conformité de votre dossier.
                                {% elseif status.value == 'under_review' %}
                                    Votre dossier a été transmis à votre cabinet. L'analyse est en cours&nbsp;: aucune action n'est requise de votre part, vous serez prévenu·e dès qu'elle sera terminée.
                                {% else %}
                                    L'ensemble de vos documents réglementaires a été vérifié et validé.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {{ status.badgeClasses }}">
                            {{ status.label }}
                        </span>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    {% if status.value == 'action_required' %}
                        <a href="{{ path('app_portal_folder_detail', {id: dashboard.activeFolder.id}) }}"
                           class="inline-flex items-center justify-center gap-2 bg-[#0B261C] text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B261C] focus-visible:ring-offset-2 transition-all shadow-sm">
                            Transmettre mes pièces
                            <twig:ux:icon name="tabler:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                        </a>
                    {% else %}
                        <a href="{{ path('app_portal_folder_detail', {id: dashboard.activeFolder.id}) }}"
                           class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300 rounded-md transition-colors">
                            Voir le détail
                            <twig:ux:icon name="tabler:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {# 2bis. PROFIL INVESTISSEUR #}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8">
        <div class="flex items-start gap-4">
            <div class="p-2.5 rounded-lg bg-indigo-50 ring-1 ring-inset ring-indigo-100 shrink-0">
                <twig:ux:icon name="tabler:chart-bar" class="size-5 text-indigo-600" aria-hidden="true" />
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="font-medium text-slate-900">Votre profil investisseur pour {{ dashboard.cabinetName }}</h3>
                <p class="text-sm text-slate-500 mt-0.5">
                    {{ dashboard.investorProfileStatus.description }}
                </p>
            </div>
            <a href="{{ path('app_portal_investor_profile') }}"
               class="shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300 rounded-md transition-colors">
                {{ dashboard.investorProfileStatus.ctaLabel }}
                <twig:ux:icon name="tabler:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
            </a>
        </div>
    </div>

    {# 3. MON CONSEILLER #}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2">
            <twig:ux:icon name="tabler:building-bank" class="size-4 text-slate-400" aria-hidden="true" />
            Votre cabinet
        </h3>
        <div class="flex items-start gap-4">
            <div class="size-12 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0">
                <span class="text-lg font-bold text-slate-400" aria-hidden="true">{{ dashboard.cabinetName|first }}</span>
            </div>
            <div>
                <h4 class="font-medium text-slate-900">{{ dashboard.cabinetName }}</h4>
                <p class="text-sm text-slate-500 mt-0.5">Conseil en gestion de patrimoine</p>

                {% if dashboard.cabinetContactEmail %}
                    <a href="mailto:{{ dashboard.cabinetContactEmail }}" class="mt-3 inline-flex items-center gap-2 text-sm text-slate-600 hover:text-slate-900 transition-colors group">
                        <twig:ux:icon name="tabler:mail" class="size-4 text-slate-400" aria-hidden="true" />
                        {{ dashboard.cabinetContactEmail }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

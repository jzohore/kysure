<div {{ attributes }} class="space-y-6">
    {% set items = this.workspaces %}
    <div class="flex flex-col lg:flex-row gap-4 justify-between items-center mb-6">

        {# Groupe Gauche : Recherche + Select Statut #}
        <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">

            {# Barre de recherche #}
            <div class="relative w-full sm:w-72">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none" aria-hidden="true">
                    <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" />
                </div>
                <input type="search"
                       aria-label="Rechercher un cabinet"
                       placeholder="Nom, SIRET, raison sociale..."
                       data-model="query"
                       value="{{ query }}"
                       class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 sm:text-sm transition-colors shadow-sm" />
            </div>

            {# Filtre par Industrie / Secteur #}


        </div>

        {# Groupe Droite : Compteur #}
        <div class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-md shadow-sm border border-slate-200 w-full sm:w-auto text-center" aria-live="polite">
            <span class="text-slate-900 font-bold">{{ items.nbResults }}</span> cabinet(s)
        </div>

    </div>

    {% if items.nbResults == 0 %}

        {# --- 1. L'ÉTAT VIDE (Empty State) --- #}
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
            <div class="text-center py-12">
                <div class="inline-flex items-center justify-center size-12 rounded-xl bg-slate-100 text-slate-400 mb-4 shadow-sm ring-1 ring-slate-200">
                    <twig:ux:icon name="tabler:building-off" class="size-6" />
                </div>
                <h3 class="text-lg font-bold text-slate-900">Aucun cabinet trouvé</h3>
                <p class="text-sm text-slate-500 max-w-sm mx-auto mt-1">
                    Aucun workspace ne correspond à vos critères de recherche.
                </p>
                {% if query is not empty or statusFilter is not empty %}
                    <button data-action="live#action" data-live-action-param="resetSearch" class="mt-4 inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-md transition-colors">
                        Effacer les filtres
                    </button>
                {% endif %}
            </div>
        </div>

    {% else %}
        {# --- 2. TABLEAU DES WORKSPACES --- #}
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" aria-label="Liste des cabinets Kysure">
                    <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                        <th scope="col" class="py-3.5 px-4">Workspace / Raison Sociale</th>
                        <th scope="col" class="py-3.5 px-4">SIRET</th>
                        <th scope="col" class="py-3.5 px-4">Secteur</th>
                        <th scope="col" class="py-3.5 px-4">État</th>
                        <th scope="col" class="py-3.5 px-4">Date de création</th>
                        <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                    {% for workspace in items %}
                        <tr class="hover:bg-slate-50/80 transition-colors">

                            {# Workspace / Raison Sociale #}
                            <td class="py-3.5 px-4 font-medium text-slate-900">
                                <div class="flex items-center gap-3">
                                    <div class="size-8 shrink-0 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center shadow-sm">
                                        <twig:ux:icon name="tabler:building" class="size-4" />
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-900">{{ workspace.name }}</p>
                                        <p class="text-xs text-slate-500 font-normal">{{ workspace.legalName }}</p>
                                    </div>
                                </div>
                            </td>

                            {# SIRET #}
                            <td class="py-3.5 px-4 font-mono text-xs text-slate-600">
                                {{ workspace.siret }}
                            </td>

                            {# Secteur #}
                            <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                        {{ workspace.industry.value|default('Autre') }}
                                    </span>
                            </td>

                            {# État #}
                            <td class="py-3.5 px-4">
                                {% if workspace.etatAdministratif == 'A' %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span> Actif
                                        </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="size-1.5 rounded-full bg-amber-500"></span> Inactif
                                        </span>
                                {% endif %}
                            </td>

                            {# Date de création #}
                            <td class="py-3.5 px-4">
                                <div class="text-xs text-slate-600">
                                    <p class="font-medium">{{ workspace.createdAt|date('d/m/Y') }}</p>
                                    <p class="text-slate-400">{{ workspace.createdAt|date('H:i') }}</p>
                                </div>
                            </td>

                            {# Actions #}
                            <td class="py-3.5 px-4 text-right">
                                <a href="{{ path('admin_workspaces_show', {slugId: workspace.slugId}) }}" class="inline-flex items-center justify-center p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors" title="Gérer le cabinet">
                                    <twig:ux:icon name="tabler:adjustments" class="size-4" />
                                    <span class="sr-only">Gérer</span>
                                </a>
                            </td>

                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# --- 3. PAGINATION --- #}
            <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                <div class="flex-1 flex justify-between sm:hidden">
                    <button type="button" data-action="live#action" data-live-action-param="previousPage" class="px-3 py-1.5 border border-slate-300 text-xs font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50" {% if not items.hasPreviousPage %}disabled{% endif %}>
                        Précédent
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="nextPage" class="px-3 py-1.5 border border-slate-300 text-xs font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 disabled:opacity-50" {% if not items.hasNextPage %}disabled{% endif %}>
                        Suivant
                    </button>
                </div>

                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs text-slate-600">
                            Page <span class="font-bold text-slate-900">{{ items.currentPage }}</span> sur <span class="font-bold text-slate-900">{{ items.nbPages }}</span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <button type="button" data-action="live#action" data-live-action-param="previousPage" class="relative inline-flex items-center px-2 py-1.5 rounded-l-md border border-slate-300 bg-white text-xs font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed" {% if not items.hasPreviousPage %}disabled{% endif %}>
                                <twig:ux:icon name="tabler:chevron-left" class="size-4" />
                            </button>
                            <span class="relative inline-flex items-center px-3 py-1.5 border border-slate-300 bg-slate-100 text-xs font-bold text-slate-900">
                                {{ items.currentPage }}
                            </span>
                            <button type="button" data-action="live#action" data-live-action-param="nextPage" class="relative inline-flex items-center px-2 py-1.5 rounded-r-md border border-slate-300 bg-white text-xs font-medium text-slate-500 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed" {% if not items.hasNextPage %}disabled{% endif %}>
                                <twig:ux:icon name="tabler:chevron-right" class="size-4" />
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<div {{ attributes }}>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8" aria-labelledby="step-one-title">
        {# En-tête de l'étape #}
        <div class="mb-8 flex items-start justify-between gap-4">
            <div>
                <p class="text-sm text-slate-500">Étape 1</p>
                <h3 id="step-one-title" class="mt-1 font-serif text-2xl tracking-tight text-slate-900">Qui est le client ?</h3>
            </div>

            {% if not this.isEditing and this.complianceDTO.contactFirstName is not empty %}
                <span class="inline-flex shrink-0 items-center gap-2 text-sm text-slate-600" role="status">
                    <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                    Complété
                </span>
            {% endif %}
        </div>

        {# --------------------------------------------- #}
        {# MODE ÉDITION (Formulaire)                     #}
        {# --------------------------------------------- #}
        {% if this.isEditing %}

            {{ form_start(form, {
                attr: {
                    novalidate: true,
                    'data-action': 'submit->live#action:prevent',
                    'data-live-action-param': 'save',
                }
            }) }}

            <div class="space-y-6">
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <div>{{ form_row(form.firstName) }}</div>
                    <div>{{ form_row(form.lastName) }}</div>
                </div>
                <div>{{ form_row(form.email) }}</div>

                {# Un seul champ « Adresse postale » : l'autocomplétion (Base Adresse
                   Nationale) s'applique directement dessus, la saisie libre reste possible. #}
                <div data-controller="address-autocomplete" data-address-autocomplete-min-value="4" class="space-y-2">
                    {{ form_label(form.address) }}
                    <div class="relative">
                        {{ form_widget(form.address, { attr: {
                            'data-address-autocomplete-target': 'field',
                            'data-action': 'input->address-autocomplete#search keydown->address-autocomplete#keydown',
                            autocomplete: 'off',
                        } }) }}
                        <div data-address-autocomplete-target="results" hidden
                             class="absolute left-0 right-0 top-full z-20 mt-1 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg"></div>
                    </div>
                    {{ form_help(form.address) }}
                    {{ form_errors(form.address) }}
                </div>
            </div>

            <div class="mt-8 flex items-center justify-end border-t border-slate-100 pt-6">

                {# Variable pour savoir si c'est une création ou une update #}
                {% set isUpdate =  this.complianceDTO.contactFirstName is not empty %}

                <twig:Button as="button" type="submit" variant="dark" class="w-full px-8 sm:w-auto">
                    {# État normal #}
                    <span data-loading="action(save)|hide">
                        {{ isUpdate ? 'Mettre à jour' : 'Enregistrer et continuer' }}
                    </span>

                    {# État de chargement (loading) #}
                    <span data-loading="action(save)|show" class="hidden items-center gap-2">
                        <twig:ux:icon name="tabler:loader" class="size-4 animate-spin" aria-hidden="true" />
                        {{ isUpdate ? 'Mise à jour…' : 'Enregistrement…' }}
                    </span>
                </twig:Button>
            </div>

            {{ form_end(form) }}

            {# --------------------------------------------- #}
            {# MODE LECTURE (Résumé propre)                  #}
            {# --------------------------------------------- #}
        {% else %}

            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

                <div class="flex items-center gap-4">
                    {# Avatar généré avec les initiales #}
                    <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-medium text-slate-600" aria-hidden="true">
                        {{ this.complianceDTO.contactFirstName|first|upper }}{{ this.complianceDTO.contactLastName|first|upper }}
                    </div>

                    <div class="min-w-0">
                        <p class="truncate text-base font-medium text-slate-900">
                            {{ this.complianceDTO.contactFirstName }} {{ this.complianceDTO.contactLastName }}
                        </p>
                        <p class="mt-0.5 flex items-center gap-1.5 text-sm text-slate-600">
                            <twig:ux:icon name="tabler:mail" class="size-4 shrink-0 text-slate-400" aria-hidden="true" />
                            <span class="truncate">{{ this.complianceDTO.contactEmail }}</span>
                        </p>
                    </div>
                </div>

                <twig:Button variant="outline" size="sm" data-action="live#action" data-live-action-param="activateEditing" class="w-full sm:w-auto">
                    <twig:ux:icon name="tabler:edit" class="size-4" aria-hidden="true" />
                    Modifier les informations
                </twig:Button>

            </div>

        {% endif %}
    </section>

</div>

{# 🚨 CORRECTIF N°1 : On utilise le layout global, et SURTOUT PAS le layout billing #}
{% extends '@app/client/layout_client.html.twig' %}

{% block title %}Mon Espace Sécurisé | {{ company_name }}{% endblock %}


{% block client_main %}
    <div class="mb-10">
        <h1 class="font-serif text-3xl tracking-tight text-slate-900 sm:text-4xl">
            Bonjour {{ dashboard.clientFirstName }}
        </h1>
        <p class="mt-2 text-[15px] text-slate-600">
            {% if dashboard.cabinetRelationships|length > 1 %}
                Votre situation réglementaire auprès de vos {{ dashboard.cabinetRelationships|length }} cabinets.
            {% else %}
                Votre situation réglementaire.
            {% endif %}
        </p>
    </div>

    {# Un client peut être suivi par plusieurs cabinets à la fois : une section par relation active.
       Séparation par l'en-tête du cabinet et un grand espace, pas par des boîtes imbriquées. #}
    <div class="space-y-14">
        {% for relationship in dashboard.cabinetRelationships %}
            {% set status = relationship.activeFolder.status %}
            {% set next_action = relationship.nextAction %}
            {% set profile = relationship.investorProfileStatus %}
            {% set cabinet_name = relationship.activeFolder.workspaceName %}
            {% set folder_url = path('portal_folders_show', {id: relationship.activeFolder.id}) %}

            <section aria-labelledby="cabinet-{{ loop.index }}-title">
                {# En-tête du cabinet #}
                <div class="mb-3 flex items-center justify-between gap-4 px-1">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white" aria-hidden="true">{{ cabinet_name|first|upper }}</span>
                        <h2 id="cabinet-{{ loop.index }}-title" class="truncate text-lg font-semibold tracking-tight text-slate-900">{{ cabinet_name }}</h2>
                    </div>
                    {% if relationship.cabinetContactEmail %}
                        <a href="mailto:{{ relationship.cabinetContactEmail }}"
                           class="hidden min-w-0 items-center gap-1.5 rounded-md text-sm text-slate-500 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300 sm:inline-flex">
                            <twig:ux:icon name="lucide:mail" class="size-4 shrink-0" aria-hidden="true" />
                            <span class="truncate">{{ relationship.cabinetContactEmail }}</span>
                        </a>
                    {% endif %}
                </div>

                {# Une seule carte à plat, deux lignes séparées par un filet #}
                <div class="divide-y divide-slate-200/80 overflow-hidden rounded-2xl border border-slate-200/80 bg-white">

                    {# Ligne 1 — Dossier de conformité #}
                    <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-5 sm:p-6">
                        <div class="flex min-w-0 flex-1 items-start gap-4">
                            <span class="mt-0.5 shrink-0 rounded-lg p-2 ring-1 ring-inset {{ status.iconWrapClasses }}">
                                <twig:ux:icon name="lucide:shield-check" class="size-5" aria-hidden="true" />
                            </span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <h3 class="font-medium text-slate-900">{{ relationship.activeFolder.title }}</h3>
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset {{ status.badgeClasses }}">{{ status.label }}</span>
                                </div>
                                <p class="mt-1 max-w-xl text-sm leading-relaxed text-slate-600">
                                    {# L'action réellement attendue (nextAction), pas seulement le statut du dossier. #}
                                    {% if next_action == 'documents' %}
                                        Votre cabinet requiert <strong class="font-semibold text-slate-900">{{ relationship.pendingDocumentsCount }} pièce(s) justificative(s)</strong> pour finaliser votre dossier.
                                    {% elseif next_action == 'submit' %}
                                        Toutes vos pièces sont déposées. <strong class="font-semibold text-slate-900">Soumettez votre dossier</strong> pour que votre cabinet puisse l'analyser.
                                    {% elseif next_action == 'consent' %}
                                        Votre conseiller vous demande votre accord pour recevoir vos documents dans cet espace sécurisé.
                                    {% elseif status.value == 'action_required' %}
                                        Votre cabinet attend des informations de votre part pour finaliser votre dossier.
                                    {% elseif status.value == 'under_review' and relationship.allDocumentsValid %}
                                        Toutes vos pièces sont conformes. Votre cabinet finalise la validation de votre dossier : aucune action de votre part.
                                    {% elseif status.value == 'under_review' %}
                                        Dossier transmis, analyse en cours. Aucune action n'est requise de votre part.
                                    {% else %}
                                        L'ensemble de vos documents a été vérifié et validé.
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0">
                            {% if next_action %}
                                <a href="{{ folder_url }}"
                                   class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:w-auto">
                                    {{ {documents: 'Transmettre mes pièces', submit: 'Soumettre mon dossier', consent: 'Donner mon accord'}[next_action] }}
                                    <twig:ux:icon name="lucide:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                                </a>
                            {% else %}
                                <a href="{{ folder_url }}"
                                   class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300">
                                    Voir le détail
                                    <twig:ux:icon name="lucide:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    {# Ligne 2 — Profil investisseur : l'état (fait / à faire) se lit au premier coup d'œil #}
                    <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-5 sm:p-6">
                        <div class="flex min-w-0 flex-1 items-start gap-4">
                            {% if profile.isCompletedByClient %}
                                <span class="mt-0.5 shrink-0 rounded-lg bg-emerald-50 p-2 text-emerald-700 ring-1 ring-inset ring-emerald-200">
                                    <twig:ux:icon name="lucide:circle-check" class="size-5" aria-hidden="true" />
                                </span>
                            {% else %}
                                <span class="mt-0.5 shrink-0 rounded-lg bg-slate-50 p-2 text-slate-500 ring-1 ring-inset ring-slate-200">
                                    <twig:ux:icon name="lucide:chart-no-axes-column" class="size-5" aria-hidden="true" />
                                </span>
                            {% endif %}
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <h3 class="font-medium text-slate-900">Profil investisseur</h3>
                                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset {{ profile.isCompletedByClient ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-amber-50 text-amber-700 ring-amber-200' }}">{{ profile.badgeLabel }}</span>
                                </div>
                                <p class="mt-1 max-w-xl text-sm leading-relaxed text-slate-600">{{ profile.description }}</p>
                            </div>
                        </div>
                        <div class="shrink-0">
                            {% if profile.isCompletedByClient %}
                                <a href="{{ path('portal_investor_profile', {folderId: relationship.activeFolder.id}) }}"
                                   class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-300">
                                    {{ profile.ctaLabel }}
                                    <twig:ux:icon name="lucide:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                                </a>
                            {% else %}
                                <a href="{{ path('portal_investor_profile', {folderId: relationship.activeFolder.id}) }}"
                                   class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-900 shadow-sm transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:w-auto">
                                    {{ profile.ctaLabel }}
                                    <twig:ux:icon name="lucide:arrow-right" class="size-4 opacity-70" aria-hidden="true" />
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}

{# components/Compliance/GenerateDERComponent.html.twig #}

<div {{ attributes.defaults({
    'data-controller': 'mercure-sync',
    'data-mercure-sync-topic-value': mercure('folder_' ~ this.complianceFolder.slugId)
}) }}>
    {% include 'components/partials/_live_alerts.html.twig' with {
        message: this.actionMessage|default(null),
        type: this.actionMessageType|default('success')
    } %}

    {% set acknowledgement = this.acknowledgement %}
    {% set der_document = this.derDocument %}
    {% set last_revoked = this.lastRevokedAcknowledgement %}
    {% set compliance_folder_status_value = this.complianceDTO.statusValue %}
    {% if this.isStepDerVisible %}
        <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8" aria-labelledby="step-der-title">

            {# ========================================== #}
            {# 1. HEADER DU COMPOSANT                     #}
            {# ========================================== #}
            <header class="mb-8">
                <p class="text-sm text-slate-500">Étape 2</p>
                <h3 id="step-der-title" class="mt-1 font-serif text-2xl tracking-tight text-slate-900">Génération du DER</h3>
                {# Rappel légal affiché en clair : il ne dépend plus d'un survol #}
                <p class="mt-3 max-w-xl text-sm text-slate-600">
                    Le Document d'Entrée en Relation est obligatoire (AMF/ACPR) avant toute collecte de pièces KYC.
                    Il intègre automatiquement les données réglementaires de votre cabinet.
                </p>
            </header>

            {# ========================================== #}
            {# 3. ÉTAT : DER ACQUITTÉ (PREUVE LÉGALE)      #}
            {# ========================================== #}
            {# Clé sur l'accusé lui-même : le dossier a déjà avancé à AWAITING_CLIENT
               (cf. AcknowledgeDerUseCase), le statut du dossier ne vaut donc plus
               "der_signed" au moment où le CGP consulte l'écran. #}
            {% if acknowledgement %}
                <div class="animate-fade-in border-l-2 border-emerald-500 pl-5">
                    <h4 class="flex items-center gap-2 text-base font-medium text-slate-900">
                        <twig:ux:icon name="tabler:shield-check-filled" class="size-5 text-emerald-600" aria-hidden="true" />
                        Accusé de réception du DER
                    </h4>

                    <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                        <div>
                            <dt class="text-xs text-slate-500">Horodatage</dt>
                            <dd class="mt-1 text-sm text-slate-900">{{ acknowledgement.acknowledgedAt|date('d/m/Y à H:i') }}</dd>
                        </div>

                        <div>
                            <dt class="text-xs text-slate-500">Accusé par</dt>
                            <dd class="mt-1 text-sm text-slate-900">{{ acknowledgement.declaredName }}</dd>
                        </div>

                        <div class="sm:col-span-2">
                            <dt class="text-xs text-slate-500">Empreinte du document (SHA-256)</dt>
                            <dd class="mt-1 flex items-start gap-2" data-controller="copy-to-clipboard">
                                <span data-copy-to-clipboard-target="source" class="break-all font-mono text-xs text-slate-600">{{ acknowledgement.pdfSha256 }}</span>
                                <button type="button" data-action="copy-to-clipboard#copy" aria-label="Copier l'empreinte du document"
                                        class="shrink-0 rounded p-1 text-slate-400 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                                    <twig:ux:icon name="lucide:copy" data-copy-to-clipboard-target="icon" class="size-3.5" aria-hidden="true" />
                                </button>
                            </dd>
                        </div>

                        {% if acknowledgement.certificateSha256 %}
                            <div class="sm:col-span-2">
                                <dt class="text-xs text-slate-500">Empreinte de l'attestation (SHA-256)</dt>
                                <dd class="mt-1 flex items-start gap-2" data-controller="copy-to-clipboard">
                                    <span data-copy-to-clipboard-target="source" class="break-all font-mono text-xs text-slate-600">{{ acknowledgement.certificateSha256 }}</span>
                                    <button type="button" data-action="copy-to-clipboard#copy" aria-label="Copier l'empreinte de l'attestation"
                                            class="shrink-0 rounded p-1 text-slate-400 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                                        <twig:ux:icon name="lucide:copy" data-copy-to-clipboard-target="icon" class="size-3.5" aria-hidden="true" />
                                    </button>
                                </dd>
                            </div>
                        {% endif %}
                    </dl>

                    <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-5">
                        {% if this.derPdfPath %}
                            <twig:Button as="a" href="{{ this.derPdfPath|private_url }}" target="_blank" rel="noopener noreferrer" variant="outline" size="sm">
                                <twig:ux:icon name="tabler:file-download" class="size-4" aria-hidden="true" />
                                Télécharger le DER
                            </twig:Button>
                        {% endif %}

                        {% if acknowledgement.certificateStoragePath %}
                            <twig:Button as="a" href="{{ acknowledgement.certificateStoragePath|private_url }}" target="_blank" rel="noopener noreferrer" variant="outline" size="sm">
                                <twig:ux:icon name="tabler:certificate" class="size-4 text-emerald-600" aria-hidden="true" />
                                Attestation d'accusé de réception
                            </twig:Button>
                        {% endif %}

                        <details class="group ml-auto text-sm">
                            <summary class="flex cursor-pointer list-none items-center gap-1 rounded text-slate-500 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400">
                                <twig:ux:icon name="lucide:chevron-down" class="size-4 transition-transform group-open:rotate-180" aria-hidden="true" />
                                Révoquer l'accusé
                            </summary>
                            <div class="mt-3 w-72 rounded-xl border border-slate-200 bg-white p-4">
                                <p class="mb-3 text-xs text-slate-600">
                                    Action irréversible : le dossier repasse en attente et le client devra accuser réception d'un nouveau DER.
                                </p>
                                <label for="der-revoke-reason" class="block text-sm font-medium text-slate-900">Motif de révocation (obligatoire)</label>
                                <textarea id="der-revoke-reason" rows="2" required data-model="revokeReason"
                                          class="mt-1.5 block w-full rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400"></textarea>
                                <twig:Button type="button" variant="destructive" size="sm" class="mt-3 w-full"
                                             data-action="live#action" data-live-action-param="revokeAcknowledgement">
                                    Révoquer et exiger un nouveau DER
                                </twig:Button>
                            </div>
                        </details>
                    </div>
                </div>

                {# ========================================== #}
                {# 3.5 ÉTAT : REFUS CLIENT OU RÉVOCATION CABINET #}
                {# ========================================== #}
            {% elseif compliance_folder_status_value == 'der_rejected' %}
                {% set der_document = this.derDocument %}
                {% set is_revocation = last_revoked and not (der_document and der_document.derDeclinedAt) %}
                <div class="animate-fade-in border-l-2 border-rose-500 pl-5" role="alert">
                    <h4 class="flex items-center gap-2 text-base font-medium text-slate-900">
                        <twig:ux:icon name="tabler:shield-x" class="size-5 text-rose-600" aria-hidden="true" />
                        {{ is_revocation ? 'Accusé de réception révoqué' : 'DER refusé par le client' }}
                    </h4>

                    {% if is_revocation %}
                        {# Preuve archivée : consultable même après révocation, jamais supprimée. #}
                        <p class="mt-3 text-sm text-slate-700">
                            Vous avez révoqué l'accusé de réception signé par
                            <strong class="font-medium text-slate-900">{{ last_revoked.declaredName }}</strong>
                            le {{ last_revoked.revokedAt|date('d/m/Y à H:i') }}.
                        </p>
                        <p class="mt-2 text-sm text-slate-700"><span class="font-medium text-slate-900">Motif :</span> {{ last_revoked.revokeReason }}</p>
                        <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-4 rounded-xl bg-slate-50 p-5 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs text-slate-500">Accusé archivé le</dt>
                                <dd class="mt-1 text-sm text-slate-900">{{ last_revoked.acknowledgedAt|date('d/m/Y à H:i') }}</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-slate-500">Révoqué par</dt>
                                <dd class="mt-1 text-sm text-slate-900">{{ last_revoked.revokedByName }}</dd>
                            </div>
                            <div class="sm:col-span-2">
                                <dt class="text-xs text-slate-500">Empreinte du document archivé (SHA-256)</dt>
                                <dd class="mt-1 break-all font-mono text-xs text-slate-600">{{ last_revoked.pdfSha256 }}</dd>
                            </div>
                        </dl>
                    {% else %}
                        <p class="mt-3 text-sm text-slate-700">
                            Le client a déclaré ne pas reconnaître le document
                            {% if der_document and der_document.derDeclinedAt %}
                                le {{ der_document.derDeclinedAt|date('d/m/Y à H:i') }}
                            {% endif %}.
                            Le processus d'entrée en relation est suspendu.
                        </p>
                        {% if der_document and der_document.derDeclineReason %}
                            <p class="mt-2 text-sm text-slate-700"><span class="font-medium text-slate-900">Motif :</span> {{ der_document.derDeclineReason }}</p>
                        {% endif %}
                    {% endif %}
                    <div class="mt-6 border-t border-slate-100 pt-5">
                        <twig:Button type="button" variant="outline" size="sm"
                                     data-action="live#action" data-live-action-param="generateDer"
                                     data-loading="action(generateDer)|addAttribute(disabled)">
                            <twig:ux:icon name="tabler:refresh" class="size-4" data-loading="action(generateDer)|hide" aria-hidden="true" />
                            <span data-loading="action(generateDer)|hide">Générer un nouveau DER</span>
                            <span data-loading="action(generateDer)|show" class="hidden text-slate-500">Génération…</span>
                        </twig:Button>
                    </div>
                </div>

                {# ========================================== #}
                {# 3.6 ÉTAT : PROFIL INCOMPLET (BLOQUANT)     #}
                {# ========================================== #}
            {% elseif not this.profileValid %}
                <div class="animate-fade-in flex flex-col justify-between gap-4 border-l-2 border-amber-400 pl-5 sm:flex-row sm:items-center" role="status">
                    <div class="flex items-start gap-3">
                        <twig:ux:icon name="tabler:alert-triangle-filled" class="mt-0.5 size-5 shrink-0 text-amber-500" aria-hidden="true" />
                        <p class="text-sm text-slate-700">Les informations réglementaires de votre cabinet (ex : ORIAS) sont incomplètes.</p>
                    </div>

                    <twig:Button as="a" href="{{ path('app_settings_regulatory_profile') }}" target="_blank" variant="outline" size="sm" class="shrink-0">
                        <twig:ux:icon name="tabler:external-link" class="size-4" aria-hidden="true" />
                        Compléter mon profil
                    </twig:Button>
                </div>

                {# ========================================== #}
                {# 4. ÉTAT : GÉNÉRATION & ACTIONS             #}
                {# ========================================== #}
            {% else %}
                {% set der_document = this.derDocument %}
                {% if der_document and der_document.derLinkSentAt %}
                    <div class="mb-6 flex items-start gap-3 border-l-2 border-amber-400 pl-4" role="status">
                        <twig:ux:icon name="tabler:mail-forward" class="mt-0.5 size-4 shrink-0 text-amber-600" aria-hidden="true" />
                        <div>
                            <h5 class="text-sm font-medium text-slate-900">Lien envoyé au client</h5>
                            <p class="mt-0.5 text-sm text-slate-600">
                                Transmis le {{ der_document.derLinkSentAt|date('d/m/Y à H:i') }}. En attente de son accusé de réception.
                            </p>
                        </div>
                    </div>
                {% endif %}
                <div class="animate-fade-in">

                    {# Données du cabinet reprises dans le document #}
                    <div class="group mb-6 flex items-center justify-between gap-4 rounded-xl bg-slate-50 p-5">
                        <div class="flex items-center gap-3">
                            <twig:ux:icon name="tabler:building-bank" class="size-5 shrink-0 text-slate-400" aria-hidden="true" />
                            <div>
                                <span class="block text-sm font-medium text-slate-900">Données du cabinet</span>
                                <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600">
                                    <span>ORIAS : {{ workspace_info.workspaceInfo.oriasNumber|default('N/A') }}</span>
                                    <span class="size-1 rounded-full bg-slate-300" aria-hidden="true"></span>
                                    <span>RC Pro : {{ workspace_info.workspaceInfo.rcProInsurer|default('N/A') }}</span>
                                </div>
                            </div>
                        </div>
                        <a href="{{ path('app_settings_regulatory_profile') }}" target="_blank" rel="noopener"
                           class="shrink-0 rounded-md text-sm text-slate-600 underline-offset-4 hover:text-slate-900 hover:underline focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 sm:opacity-0 sm:transition-opacity sm:group-hover:opacity-100">
                            Modifier
                        </a>
                    </div>

                    {# Zone d'actions dynamiques #}
                    <div data-controller="actions-panel" class="space-y-4">
                        {% if this.derPdfPath %}
                            <div data-loading="action(generateDer)|hide" class="space-y-3">

                                <twig:Button as="a" href="{{ this.derPdfPath|private_url }}" target="_blank" rel="noopener noreferrer" variant="outline" class="w-full">
                                    <twig:ux:icon name="tabler:eye" class="text-slate-400" aria-hidden="true" />
                                    Aperçu de la version de travail
                                </twig:Button>

                                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                    <twig:SendDerActionComponent folder="{{ this.complianceFolder }}"></twig:SendDerActionComponent>

                                    <twig:Button type="button" variant="outline" data-action="click->actions-panel#toggleMonitoring" class="w-full">
                                        <twig:ux:icon name="tabler:help-circle" class="text-slate-400" aria-hidden="true" />
                                        Besoin d'aide ?
                                    </twig:Button>
                                </div>

                                <div data-actions-panel-target="sendForm" class="hidden"></div>
                                <div data-actions-panel-target="monitoringForm" class="hidden"></div>

                                <div class="mt-3 border-t border-slate-100 pt-3">
                                    <twig:Button type="button" variant="ghost" size="sm" class="w-full" data-action="live#action" data-live-action-param="generateDer" data-loading="action(generateDer)|addAttribute(disabled)">
                                        <twig:ux:icon name="tabler:refresh" data-loading="action(generateDer)|hide" aria-hidden="true" />
                                        <twig:ux:icon name="tabler:loader" data-loading="action(generateDer)|show" class="hidden animate-spin" aria-hidden="true" />
                                        <span data-loading="action(generateDer)|hide">Regénérer avec les nouvelles données</span>
                                        <span data-loading="action(generateDer)|show" class="hidden">Mise à jour du document…</span>
                                    </twig:Button>
                                </div>
                            </div>

                        {% elseif this.isGenerating %}
                            <twig:Button disabled variant="secondary" class="w-full">
                                <twig:ux:icon name="tabler:loader" class="animate-spin" aria-hidden="true" />
                                Génération du DER en cours…
                            </twig:Button>

                        {% else %}
                            {# Action principale de l'étape #}
                            <twig:Button type="button"
                                         variant="dark"
                                         class="w-full py-3"
                                         data-action="live#action"
                                         data-live-action-param="generateDer"
                                         data-loading="action(generateDer)|addAttribute(disabled)">
                                <twig:ux:icon name="tabler:file-invoice" data-loading="action(generateDer)|hide" class="text-slate-300" aria-hidden="true" />
                                <span data-loading="action(generateDer)|hide">Générer le DER</span>
                                <twig:ux:icon name="tabler:loader" data-loading="action(generateDer)|show" class="hidden animate-spin text-slate-300" aria-hidden="true" />
                                <span data-loading="action(generateDer)|show" class="hidden">Lancement du processus…</span>
                            </twig:Button>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

        </section>
    {% else %}

        <p class="border-l-2 border-slate-300 py-1 pl-4 text-sm text-slate-600">
            Validez les informations du client pour débloquer la génération du DER.
        </p>

    {% endif %}
</div>

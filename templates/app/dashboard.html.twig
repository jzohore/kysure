{% extends '@app/base_app.html.twig' %}

{% block title %}{{ page_title }} - {{ company_name }}{% endblock %}

{% block content %}

    {# ═══════════════ EN-TÊTE ═══════════════ #}
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">
                Espace <span class="text-indigo-600">{{ dashboard.workspaceName|lower|capitalize }}</span>
            </h1>
            <p class="text-sm text-slate-500 mt-1">Suivi de vos dossiers de conformité, criblages et journal d'activité.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <twig:Button as="a" href="{{ path('app_screening_new') }}" variant="outline" size="sm">Nouveau criblage</twig:Button>
            <twig:Button as="a" href="{{ path('app_compliance_new') }}" variant="dark" size="sm">
                {{ ux_icon('lucide:plus', { class: 'size-4 mr-1.5' }) }}
                Nouveau dossier
            </twig:Button>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        {# ─────────── COLONNE GAUCHE : INDICATEURS (liste) ─────────── #}
        <div class="lg:col-span-4 space-y-10 lg:sticky lg:top-24">

            {# GROUPE 1 : Quota #}
            <div>
                <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Quota</h2>
                <ul class="space-y-1">
                    <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                        <div class="flex items-center gap-3">
                            <div class="p-1.5 bg-emerald-100 rounded-lg text-emerald-700" aria-hidden="true">
                                {{ ux_icon('lucide:folder-check', { class: 'size-4' }) }}
                            </div>
                            <span class="text-sm font-medium text-slate-600">Dossiers de conformité</span>
                        </div>
                        <div class="text-right">
                            {% if dashboard.hasActiveSubscription %}
                                <span class="text-lg font-bold text-slate-900">Illimité</span>
                                <div class="text-[10px] text-slate-400">abonnement actif</div>
                            {% else %}
                                <span class="text-lg font-bold {{ dashboard.trialLow ? 'text-amber-600' : 'text-slate-900' }} tabular-nums">{{ dashboard.trialDossiersRemaining }}</span>
                                <div class="text-[10px] {{ dashboard.trialLow ? 'text-amber-600' : 'text-slate-400' }}">
                                    {% if dashboard.trialLow %}<a href="{{ path('app_pricing') }}" class="font-medium hover:underline">choisir une offre</a>{% else %}restants (essai){% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </li>
                    <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                        <div class="flex items-center gap-3">
                            <div class="p-1.5 bg-indigo-100 rounded-lg text-indigo-700" aria-hidden="true">
                                {{ ux_icon('lucide:mic', { class: 'size-4' }) }}
                            </div>
                            <span class="text-sm font-medium text-slate-600">Minutes d'entretien</span>
                        </div>
                        <div class="text-right">
                            <span class="text-lg font-bold {{ dashboard.minutesLow ? 'text-amber-600' : 'text-slate-900' }} tabular-nums">{{ dashboard.remainingMeetingMinutes }}</span>
                            <div class="text-[10px] {{ dashboard.minutesLow ? 'text-amber-600' : 'text-slate-400' }}">
                                {% if dashboard.minutesLow %}<a href="{{ path('app_pricing') }}" class="font-medium hover:underline">recharger</a>{% else %}sur {{ dashboard.meetingMinutesAllocated }} min{% endif %}
                            </div>
                        </div>
                    </li>
                </ul>
            </div>

            {# GROUPE 2 : Activité #}
            <div>
                <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">Activité</h2>
                <ul class="space-y-1">
                    {% set indicators = [
                        { icon: 'lucide:layers', badge: 'bg-slate-100 text-slate-700', label: 'Dossiers actifs', value: dashboard.activeFoldersCount, sub: 'en cours de traitement', href: path('app_compliance_list') },
                        { icon: 'lucide:file-pen', badge: 'bg-slate-100 text-slate-700', label: 'Brouillons', value: dashboard.draftFoldersCount, sub: 'à compléter', href: path('app_compliance_list') },
                        { icon: 'lucide:file-warning', badge: 'bg-amber-100 text-amber-700', label: 'Pièces manquantes', value: dashboard.pendingDocsCount, sub: 'en attente du client', href: path('app_compliance_list') },
                        { icon: 'lucide:search-check', badge: 'bg-blue-100 text-blue-700', label: 'KYC à vérifier', value: dashboard.inReviewCount, sub: 'à analyser', href: path('app_compliance_list') },
                        { icon: 'lucide:shield-alert', badge: 'bg-violet-100 text-violet-700', label: 'Criblages LCB-FT en cours', value: dashboard.pendingScreeningsCount, sub: 'à analyser', href: path('app_screening_list') },
                        { icon: 'lucide:alert-triangle', badge: 'bg-red-100 text-red-700', label: 'Corrections requises', value: dashboard.needsCorrectionCount, sub: 'dossiers à reprendre', href: path('app_compliance_list') },
                        { icon: 'lucide:badge-check', badge: 'bg-emerald-100 text-emerald-700', label: 'Dossiers conformes', value: dashboard.approvedCount, sub: 'validés', href: path('app_compliance_list') },
                        { icon: 'lucide:bar-chart-3', badge: 'bg-indigo-100 text-indigo-700', label: 'Profils investisseurs', value: dashboard.investorProfilesToValidateCount, sub: 'à valider', href: '#profils-a-valider' },
                        { icon: 'lucide:users', badge: 'bg-slate-100 text-slate-700', label: 'Clients suivis', value: dashboard.clientsCount, sub: 'relations actives', href: path('app_clients_list') },
                    ] %}
                    {% for it in indicators %}
                        <li class="flex items-center justify-between py-3 border-b border-slate-200/60">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 {{ it.badge }} rounded-lg" aria-hidden="true">
                                    {{ ux_icon(it.icon, { class: 'size-4' }) }}
                                </div>
                                <span class="text-sm font-medium text-slate-600">{{ it.label }}</span>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-slate-900 tabular-nums">{{ it.value }}</span>
                                <div class="text-[10px] text-slate-400">
                                    <a href="{{ it.href }}" class="hover:underline">{{ it.sub }}</a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        {# ─────────── COLONNE DROITE : LISTES D'ACTIVITÉ ─────────── #}
        <div class="lg:col-span-8 space-y-6">

            {# PROFILS INVESTISSEURS À VALIDER #}
            <section id="profils-a-valider" class="bg-white rounded-xl border border-slate-200 shadow-sm scroll-mt-6">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        {{ ux_icon('lucide:bar-chart-3', { class: 'size-4 text-slate-400' }) }}
                        Profils investisseurs à valider
                    </h2>
                </div>
                <div class="p-2 space-y-1">
                    {% for assessment in dashboard.pendingInvestorProfileValidations %}
                        <a href="{{ path('app_clients_show', { slugId: assessment.client.slugId }) }}#profil-investisseur"
                           class="flex items-center justify-between p-3 rounded-lg hover:bg-slate-50/80 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 pr-2">
                                <div class="size-8 shrink-0 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100 flex items-center justify-center" aria-hidden="true">
                                    {{ ux_icon('lucide:bar-chart-3', { class: 'size-4' }) }}
                                </div>
                                <div class="flex flex-col min-w-0">
                                    <span class="text-sm font-semibold text-slate-900 truncate group-hover:text-indigo-700">
                                        {{ assessment.client.firstName }} {{ assessment.client.lastName }}
                                    </span>
                                    <span class="text-[11px] text-slate-500 tabular-nums">
                                        Soumis le {{ assessment.submittedAt|date('d/m/Y') }}
                                    </span>
                                </div>
                            </div>
                            <span class="shrink-0 inline-flex items-center gap-1.5 rounded-md bg-amber-50 px-2 py-1 text-[10px] font-bold text-amber-700 ring-1 ring-inset ring-amber-600/20">
                                À valider
                            </span>
                        </a>
                    {% else %}
                        <div class="text-center py-10 px-4 text-sm text-slate-500 flex flex-col items-center gap-2">
                            {{ ux_icon('lucide:badge-check', { class: 'size-8 text-slate-300' }) }}
                            <p>Aucun profil investisseur en attente de validation.</p>
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# DERNIERS DOSSIERS #}
            <section class="bg-white rounded-xl border border-slate-200 shadow-sm">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        {{ ux_icon('lucide:folder-clock', { class: 'size-4 text-slate-400' }) }}
                        Derniers dossiers
                    </h2>
                    <a href="{{ path('app_compliance_list') }}" class="text-xs font-medium text-indigo-600 hover:text-indigo-700">Voir tout →</a>
                </div>
                <div class="p-2 space-y-1">
                    {% for folder in dashboard.latestFolders %}
                        <a href="{{ path('app_compliance_show', { slugId: folder.slugId }) }}"
                           class="flex items-center justify-between p-3 rounded-lg hover:bg-slate-50/80 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 pr-2">
                                <div class="size-8 shrink-0 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center" aria-hidden="true">
                                    {{ ux_icon('lucide:folder', { class: 'size-4' }) }}
                                </div>
                                <div class="flex flex-col min-w-0">
                                    <span class="text-sm font-semibold text-slate-900 truncate group-hover:text-indigo-700">
                                        {{ folder.client ? folder.client.firstName ~ ' ' ~ folder.client.lastName : folder.reference }}
                                    </span>
                                    <span class="text-[11px] text-slate-500 tabular-nums">
                                        {{ folder.reference }} · {{ folder.createdAt|date('d/m/Y') }}
                                    </span>
                                </div>
                            </div>
                            <span class="shrink-0 {{ folder.status.getBadgeClasses() }}">
                                {{ folder.status.getLabel() }}
                            </span>
                        </a>
                    {% else %}
                        <div class="text-center py-10 px-4 text-sm text-slate-500 flex flex-col items-center gap-2">
                            {{ ux_icon('lucide:folder-plus', { class: 'size-8 text-slate-300' }) }}
                            <p>Aucun dossier créé pour l'instant.</p>
                            <a href="{{ path('app_compliance_new') }}" class="text-xs font-medium text-indigo-600 hover:underline">Créer un dossier</a>
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# CRIBLAGES RÉCENTS #}
            <section class="bg-white rounded-xl border border-slate-200 shadow-sm">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        {{ ux_icon('lucide:radar', { class: 'size-4 text-slate-400' }) }}
                        Criblages récents
                    </h2>
                    <a href="{{ path('app_screening_list') }}" class="text-xs font-medium text-indigo-600 hover:text-indigo-700">Voir tout →</a>
                </div>
                <div class="p-2 space-y-1">
                    {% for screening in dashboard.latestScreenings %}
                        {% set badge = {
                            'wait': 'bg-slate-100 text-slate-600 border-slate-200',
                            'pending': 'bg-amber-50 text-amber-700 border-amber-200',
                            'generated': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                            'failed': 'bg-rose-50 text-rose-700 border-rose-200',
                        } %}
                        <a href="{{ path('app_screening_show', { slugId: screening.slugId }) }}"
                           class="flex items-center justify-between p-3 rounded-lg hover:bg-slate-50/80 transition-colors group">
                            <div class="flex items-center gap-3 min-w-0 pr-2">
                                <div class="size-8 shrink-0 rounded-full bg-violet-50 text-violet-600 border border-violet-100 flex items-center justify-center" aria-hidden="true">
                                    {{ ux_icon('lucide:user-search', { class: 'size-4' }) }}
                                </div>
                                <div class="flex flex-col min-w-0">
                                    <span class="text-sm font-semibold text-slate-900 truncate group-hover:text-indigo-700">{{ screening.query }}</span>
                                    <span class="text-[11px] text-slate-500 tabular-nums">
                                        {{ screening.createdAt|date('d/m/Y H:i') }} · {{ screening.totalMatches }} correspondance{{ screening.totalMatches > 1 ? 's' : '' }}
                                    </span>
                                </div>
                            </div>
                            <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border {{ badge[screening.status.value]|default(badge.wait) }}">
                                {{ screening.status.getLabel() }}
                            </span>
                        </a>
                    {% else %}
                        <div class="text-center py-10 px-4 text-sm text-slate-500 flex flex-col items-center gap-2">
                            {{ ux_icon('lucide:radar', { class: 'size-8 text-slate-300' }) }}
                            <p>Aucun criblage lancé pour l'instant.</p>
                            <a href="{{ path('app_screening_new') }}" class="text-xs font-medium text-indigo-600 hover:underline">Lancer un criblage</a>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>

    {# ═══════════════ WIDGET ONBOARDING ═══════════════ #}
    {% if not app.user.profile.dismissOnboarding and not dashboard.isOnboardingComplete %}
        {% set steps_done = dashboard.onboardingDoneSteps %}
        {% set steps_total = dashboard.onboardingTotalSteps %}
        {% set progress_pct = (steps_done / steps_total * 100)|round %}

        <div data-controller="onboarding"
             data-onboarding-target="widget"
             data-onboarding-dismiss-url-value="{{ path('app_user_dismiss_onboarding') }}"
             class="fixed bottom-6 right-6 lg:right-12 w-[340px] bg-white rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-slate-200 z-40 flex flex-col transition-all duration-500 ease-in-out">

            <div class="flex items-stretch border-b border-slate-100">
                <button type="button"
                        data-action="onboarding#toggle"
                        data-onboarding-target="header"
                        aria-expanded="true"
                        aria-controls="onboarding-steps"
                        class="flex-1 min-w-0 px-4 py-3 flex justify-between items-center gap-2 cursor-pointer select-none hover:bg-slate-50 transition-colors rounded-tl-xl text-left">
                    <span class="flex flex-col gap-1 min-w-0">
                        <span class="text-sm font-semibold text-slate-900 truncate">Configuration du compte</span>
                        <span class="text-xs text-slate-500 tabular-nums">{{ steps_done }} / {{ steps_total }} étapes terminées</span>
                    </span>
                    <span class="p-1 text-slate-400 shrink-0" aria-hidden="true" data-onboarding-target="chevron">
                        {{ ux_icon('lucide:chevron-down', { class: 'size-4 transition-transform' }) }}
                    </span>
                </button>
                <button type="button"
                        data-action="onboarding#dismiss"
                        aria-label="Ne plus afficher cette check-list"
                        class="px-3 text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition-colors rounded-tr-xl">
                    {{ ux_icon('lucide:x', { class: 'size-4' }) }}
                </button>
            </div>

            <div class="h-1 w-full bg-slate-100" aria-hidden="true">
                <div class="h-1 bg-emerald-500 transition-all duration-500" style="width: {{ progress_pct }}%;"></div>
            </div>

            {% set is_org = dashboard.isOrgCompleted %}
            {% set is_profile = dashboard.isRegProfileValid %}
            {% set is_2fa = dashboard.is2faEnabled %}
            {% set has_folder = dashboard.hasFirstFolder %}
            {% set is_team = dashboard.isTeamStepDone %}

            <div id="onboarding-steps" data-onboarding-target="content" class="overflow-hidden transition-all duration-300 max-h-[520px]">
                <ul class="p-2 space-y-0.5">
                    {{ _self.step(true, 'Compte vérifié', 'Compte vérifié', null) }}
                    {{ _self.step(is_org, 'Renseigner votre organisation', 'Organisation identifiée', path('app_settings_organization')) }}
                    {{ _self.step(is_profile, 'Compléter le profil réglementaire', 'Profil réglementaire renseigné', path('app_settings_regulatory_profile')) }}
                    {{ _self.step(is_2fa, 'Activer la double authentification', 'Double authentification activée', path('app_settings_account'), '+1 dossier offert') }}
                    {{ _self.step(has_folder, 'Créer un premier dossier', 'Premier dossier créé', path('app_compliance_new')) }}
                    {% if dashboard.isFirm %}
                        {% if dashboard.hasActiveSubscription %}
                            {{ _self.step(true, '', 'Accès illimité activé', null) }}
                        {% else %}
                            {{ _self.step(is_team, 'Inviter un collaborateur', 'Collaborateur invité', path('app_employees_invitation')) }}
                        {% endif %}
                    {% endif %}
                </ul>
            </div>
        </div>
    {% endif %}
{% endblock %}

{# ─────────── Macro : une ligne de la check-list ─────────── #}
{% macro step(done, todo_label, done_label, href, hint = null) %}
    <li class="flex items-start gap-3 p-2.5 rounded-lg {{ done ? 'opacity-60' : 'hover:bg-slate-50 transition-colors group' }}">
        <span class="mt-0.5 size-4 rounded-full flex items-center justify-center shrink-0 {{ done ? 'bg-emerald-100' : 'border-[1.5px] border-indigo-500' }}" aria-hidden="true">
            {% if done %}{{ ux_icon('lucide:check', { class: 'size-2.5 text-emerald-600' }) }}{% endif %}
        </span>
        <span class="flex-1 min-w-0">
            {% if done %}
                <span class="text-sm font-medium text-slate-500 line-through decoration-slate-300">{{ done_label }}</span>
            {% else %}
                <a href="{{ href }}" class="block outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">
                    <span class="block text-sm font-medium text-slate-700 group-hover:text-indigo-600 transition-colors">{{ todo_label }}</span>
                    {% if hint %}<span class="block text-xs text-emerald-600 font-medium mt-0.5">{{ hint }}</span>{% endif %}
                </a>
            {% endif %}
        </span>
    </li>
{% endmacro %}

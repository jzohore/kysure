{# Maquette décorative — espace client sécurisé / collecte des pièces (exemple illustratif). #}
<div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5" aria-hidden="true">
    <div class="flex items-center justify-between">
        <p class="text-[13px] font-semibold text-slate-900">Pièces à fournir</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] text-slate-600">
            {{ ux_icon('lucide:lock', { class: 'size-3.5' }) }} Espace client sécurisé
        </span>
    </div>

    <ul class="mt-5 space-y-3">
        <li class="flex items-center justify-between rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white px-4 py-3">
            <span class="flex items-center gap-3 text-[13px] text-slate-900">
                {{ ux_icon('lucide:id-card', { class: 'size-4 text-slate-600' }) }} Pièce d'identité
            </span>
            <span class="text-[12px] font-medium text-emerald-700">Reçue</span>
        </li>
        <li class="flex items-center justify-between rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white px-4 py-3">
            <span class="flex items-center gap-3 text-[13px] text-slate-900">
                {{ ux_icon('lucide:house', { class: 'size-4 text-slate-600' }) }} Justificatif de domicile
            </span>
            <span class="text-[12px] font-medium text-emerald-700">Reçue</span>
        </li>
        <li class="flex items-center justify-between rounded-2xl border border-l-4 border-slate-200 border-l-amber-500 bg-white px-4 py-3">
            <span class="flex items-center gap-3 text-[13px] text-slate-900">
                {{ ux_icon('lucide:landmark', { class: 'size-4 text-slate-600' }) }} Justificatif d'origine des fonds
            </span>
            <span class="text-[12px] font-medium text-amber-700">En attente</span>
        </li>
    </ul>

    <p class="mt-5 text-[12px] text-slate-600">Connexion par lien magique : aucun mot de passe à retenir pour votre client.</p>
</div>

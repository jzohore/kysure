{
    # 🛡️ KYSURE SECOPS : WORKAROUND BUG FRANKENPHP #2535
    # On force HTTP/1.1 (h1) pour prévenir le crash mémoire Go (Panic)
    # lors de l'annulation des requêtes AJAX (très fréquent avec LiveComponents).
    servers {
        protocols h1
    }

    skip_install_trust

    {$CADDY_GLOBAL_OPTIONS}

    frankenphp {
       {$FRANKENPHP_CONFIG}

       # 🚀 KYSURE PERF : Le mode Worker garde Symfony en RAM
       worker {
          file ./public/index.php
          {$FRANKENPHP_WORKER_CONFIG}
       }
    }
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
    log {
       {$CADDY_SERVER_LOG_OPTIONS}
       # Redact the authorization query parameter that can be set by Mercure
       format filter {
          request>uri query {
             replace authorization REDACTED
          }
       }
    }

    root /app/public
    encode zstd br gzip

    mercure {
       # Mercure récent : les directives publisher_jwt / subscriber_jwt ci-dessous relèvent du mode
       # « compatibilité » (protocole v8) ; sans cette ligne FrankenPHP refuse de démarrer.
       protocol_version_compatibility 8
       # Hub nommé : SERVER_NAME déclare deux adresses (« localhost, php:80 »), donc deux serveurs HTTP ;
       # sans nom, Mercure refuse plus d'un hub anonyme. Même nom = un seul hub partagé.
       name kysure
       # Publisher JWT key
       publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
       # Subscriber JWT key
       subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
       # Allow anonymous subscribers (double-check that it's what you want)
       anonymous
       # Enable the subscription API (double-check that it's what you want)
       subscriptions
       # Extra directives
       {$MERCURE_EXTRA_DIRECTIVES}
    }

    vulcain

    {$CADDY_SERVER_EXTRA_DIRECTIVES}

    # Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
    header ?Permissions-Policy "browsing-topics=()"

    # AssetMapper versionne les fichiers (digest dans le nom) : cache navigateur permanent.
    # Crucial tant que HTTP/1.1 est forcé (workaround #2535) : zéro revalidation par module JS.
    @immutableAssets path /assets/*
    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

    @phpRoute {
       not path /.well-known/mercure*
       not file {path}
    }
    rewrite @phpRoute index.php

    @frontController path index.php
    php @frontController

    file_server {
       hide *.php
    }
}

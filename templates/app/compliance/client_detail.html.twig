{% extends '@app/base_app.html.twig' %}

{% block title %}{{ client.fullName }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ client.fullName }}{% endblock %}

{% set StatusEnum = enum('App\\Domain\\Compliance\\Enum\\ComplianceFolderStatus') %}

{% block content %}
    <a href="{{ path('app_clients_list') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 mb-4">
        <twig:ux:icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
        Mes clients
    </a>

    {# ===== En-tête client ===== #}
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <span class="size-14 shrink-0 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-base font-bold text-slate-500" aria-hidden="true">
                {{ client.fullName|split(' ')|map(p => p|first|upper)|join('')|slice(0, 2) }}
            </span>
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-xl font-bold text-slate-900 tracking-tight">{{ client.fullName }}</h1>
                    {% if client.pendingConfirmation %}
                        <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                            <twig:ux:icon name="tabler:clock" class="size-3.5" aria-hidden="true" /> En attente de confirmation
                        </span>
                    {% elseif client.isActif %}
                        <span class="inline-flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                            <twig:ux:icon name="tabler:circle-check-filled" class="size-3.5" aria-hidden="true" /> Actif
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-500/20">
                            <twig:ux:icon name="tabler:x" class="size-3.5" aria-hidden="true" /> Inactif
                        </span>
                    {% endif %}
                </div>
                {% if not client.pendingConfirmation %}
                    <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500">
                        <span class="inline-flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:mail" class="size-4 text-slate-400" aria-hidden="true" />
                            <span class="break-all">{{ client.email }}</span>
                        </span>
                        {% if client.phoneNumber %}
                            <span class="inline-flex items-center gap-1.5">
                                <twig:ux:icon name="tabler:phone" class="size-4 text-slate-400" aria-hidden="true" />
                                {{ client.phoneNumber }}
                            </span>
                        {% endif %}
                        <span class="inline-flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:calendar" class="size-4 text-slate-400" aria-hidden="true" />
                            {% if client.clientSinceFormatted %}Client depuis le {{ client.clientSinceFormatted }}{% else %}Compte créé le {{ client.createdAtFormatted }}{% endif %}
                        </span>
                    </div>
                {% else %}
                    <p class="mt-1 text-sm text-slate-500">Nom saisi lors de l'ajout. Les coordonnées complètes s'afficheront à la confirmation.</p>
                {% endif %}
            </div>

            {# Action primaire : nouveau dossier (choix du type) #}
            <twig:Dialog id="new_folder_type" class="sm:max-w-md">
                <twig:Dialog:Trigger>
                    <twig:Button variant="dark" {{ ...dialog_trigger_attrs }}>
                        <twig:ux:icon name="tabler:folder-plus" class="size-4" aria-hidden="true" />
                        Nouveau dossier
                    </twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content>
                    <twig:Dialog:Header>
                        <twig:Dialog:Title class="text-slate-900">Type de dossier</twig:Dialog:Title>
                        <twig:Dialog:Description class="text-slate-600">
                            Le dossier sera greffé à {{ client.fullName }}. Choisissez la nature du client final.
                        </twig:Dialog:Description>
                    </twig:Dialog:Header>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
                        <form method="post" action="{{ path('app_clients_create_folder', {slugId: client.slugId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('client_new_folder_' ~ client.slugId) }}">
                            <input type="hidden" name="type" value="individual">
                            <button type="submit" class="w-full h-full rounded-xl border border-slate-200 p-4 text-left hover:border-slate-900 hover:bg-slate-50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
                                <twig:ux:icon name="tabler:user" class="size-6 text-slate-700 mb-2" aria-hidden="true" />
                                <p class="font-semibold text-slate-900 text-sm">Personne physique</p>
                                <p class="text-xs text-slate-500 mt-0.5">Un particulier. Identité pré-remplie, DER prêt à générer.</p>
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_clients_create_folder', {slugId: client.slugId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('client_new_folder_' ~ client.slugId) }}">
                            <input type="hidden" name="type" value="business">
                            <button type="submit" class="w-full h-full rounded-xl border border-slate-200 p-4 text-left hover:border-slate-900 hover:bg-slate-50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">
                                <twig:ux:icon name="tabler:building" class="size-6 text-slate-700 mb-2" aria-hidden="true" />
                                <p class="font-semibold text-slate-900 text-sm">Personne morale</p>
                                <p class="text-xs text-slate-500 mt-0.5">Une société. Saisie du bénéficiaire effectif à l'étape suivante.</p>
                            </button>
                        </form>
                    </div>
                </twig:Dialog:Content>
            </twig:Dialog>
        </div>

        {% if client.folders is not empty %}
            <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
                <span><strong class="text-slate-900">{{ client.folders|length }}</strong> dossier(s)</span>
                <span><strong class="text-slate-900">{{ client.activeFolderCount }}</strong> en cours</span>
                <span><strong class="text-slate-900">{{ client.closedFolderCount }}</strong> clôturé(s)</span>
            </div>
        {% endif %}
    </div>

    {% if client.pendingConfirmation %}
        <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-5 mb-6 flex items-start gap-3">
            <twig:ux:icon name="tabler:clock" class="size-5 text-amber-600 shrink-0 mt-0.5" aria-hidden="true" />
            <div class="text-sm text-amber-900">
                <p class="font-semibold">Relation à confirmer</p>
                <p class="text-amber-800 mt-1">
                    Ce client a été ajouté à votre portefeuille. Ses coordonnées complètes (e-mail, téléphone)
                    s'afficheront dès qu'il aura accusé réception de son premier document. Créez-lui un dossier
                    et envoyez-lui son DER pour lancer la démarche.
                </p>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# ===== Colonne principale : dossiers ===== #}
        <div class="lg:col-span-2 space-y-4">
            <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest">Dossiers de conformité</h2>

            {% for folder in client.folders %}
                {% set st = StatusEnum.from(folder.statusValue) %}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden {% if folder.underLegalHold %}border-l-4 border-l-red-500{% elseif folder.relationshipEnded %}border-l-4 border-l-amber-500{% endif %}">
                    <div class="p-5">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-start gap-3 min-w-0">
                                <span class="size-9 shrink-0 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center" aria-hidden="true">
                                    <twig:ux:icon name="{{ folder.type == 'business' ? 'tabler:building' : 'tabler:user' }}" class="size-5 text-slate-500" />
                                </span>
                                <div class="min-w-0">
                                    <a href="{{ path('app_compliance_show', {slugId: folder.slugId}) }}" class="font-semibold text-slate-900 hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded">
                                        {{ folder.reference }}
                                    </a>
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        {{ folder.type == 'business' ? 'Personne morale' : 'Personne physique' }} · ouvert le {{ folder.openedAtFormatted }}
                                    </p>
                                </div>
                            </div>
                            <span class="{{ st.badgeClasses }} shrink-0">{{ st.label }}</span>
                        </div>

                        {# Indicateurs de contenu #}
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-200">
                                <twig:ux:icon name="{{ folder.derAcknowledged ? 'tabler:signature' : (folder.hasDer ? 'tabler:file-check' : 'tabler:file-off') }}" class="size-3.5 {{ folder.derAcknowledged ? 'text-emerald-600' : 'text-slate-400' }}" aria-hidden="true" />
                                DER : {{ folder.derAcknowledged ? 'accusé de réception' : (folder.hasDer ? 'émis' : 'non émis') }}
                            </span>
                            <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-200">
                                <twig:ux:icon name="tabler:file-text" class="size-3.5 text-slate-400" aria-hidden="true" />
                                Pièces : {{ folder.validatedDocumentCount }} / {{ folder.documentCount }} validées
                            </span>
                            {% if folder.relationshipEnded %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                                    <twig:ux:icon name="tabler:archive" class="size-3.5" aria-hidden="true" />
                                    Relation clôturée · conservation jusqu'au {{ folder.purgeDueAtFormatted }}
                                </span>
                            {% endif %}
                            {% if folder.underLegalHold %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                                    <twig:ux:icon name="tabler:lock" class="size-3.5" aria-hidden="true" />
                                    Verrou de litige
                                </span>
                            {% endif %}
                        </div>

                        {# Suivi : timeline des évènements système #}
                        {% if folder.recentEvents is not empty %}
                            <details class="mt-4 group">
                                <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-slate-900">
                                    <twig:ux:icon name="tabler:history" class="size-4" aria-hidden="true" />
                                    Suivi du dossier
                                    <twig:ux:icon name="tabler:chevron-down" class="size-4 transition-transform group-open:rotate-180" aria-hidden="true" />
                                </summary>
                                <ol class="mt-3 border-l border-slate-200 pl-4 space-y-3">
                                    {% for event in folder.recentEvents %}
                                        <li class="relative">
                                            <span class="absolute -left-[21px] top-1 size-2 rounded-full bg-slate-300 ring-2 ring-white" aria-hidden="true"></span>
                                            <p class="text-xs font-semibold text-slate-800">{{ event.title }}</p>
                                            {% if event.description %}<p class="text-xs text-slate-500 mt-0.5">{{ event.description }}</p>{% endif %}
                                            {% if event.at %}<p class="text-[11px] text-slate-400 mt-0.5">{{ event.at }}</p>{% endif %}
                                        </li>
                                    {% endfor %}
                                </ol>
                                <a href="{{ path('app_compliance_show', {slugId: folder.slugId}) }}" class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700">
                                    Ouvrir le dossier complet
                                    <twig:ux:icon name="tabler:arrow-right" class="size-3.5" aria-hidden="true" />
                                </a>
                            </details>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="bg-white rounded-2xl border border-dashed border-slate-200 py-12 text-center">
                    <twig:ux:icon name="tabler:folder-open" class="size-8 text-slate-300 mx-auto mb-3" aria-hidden="true" />
                    <p class="text-sm font-medium text-slate-600">Aucun dossier pour ce client</p>
                    <p class="text-xs text-slate-400 mt-1">Créez son premier dossier de conformité avec le bouton « Nouveau dossier ».</p>
                </div>
            {% endfor %}

            <twig:InvestorProfileReviewComponent clientSlugId="{{ client.slugId }}" />
        </div>

        {# ===== Colonne latérale : actions ===== #}
        <div class="space-y-6">
            {% if client.isWorkspaceAdmin %}
                {# --- Retrait / suppression --- #}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2 flex items-center gap-1.5">
                        <twig:ux:icon name="tabler:trash" class="size-4" aria-hidden="true" />
                        {{ client.removalDeletesAccount ? 'Supprimer le client' : 'Retirer du portefeuille' }}
                    </h2>
                    {% if client.canBeRemoved %}
                        {% if client.removalDeletesAccount %}
                            <p class="text-xs text-slate-500 mb-3">
                                Ce client n'a <strong>aucun dossier</strong> et n'est rattaché qu'à votre cabinet.
                                Le retirer <strong>supprime définitivement son compte</strong>.
                            </p>
                        {% else %}
                            <p class="text-xs text-slate-500 mb-3">
                                Ce client n'a aucun dossier engagé chez vous. Le retirer supprime ses brouillons et le détache
                                de votre cabinet ; son compte est conservé (il travaille avec un autre cabinet).
                            </p>
                        {% endif %}

                        <twig:AlertDialog id="remove-client">
                            <twig:AlertDialog:Trigger>
                                <twig:Button variant="{{ client.removalDeletesAccount ? 'destructive' : 'outline' }}" class="w-full" {{ ...trigger_attrs }}>
                                    {{ client.removalDeletesAccount ? 'Supprimer le compte' : 'Retirer du portefeuille' }}
                                </twig:Button>
                            </twig:AlertDialog:Trigger>
                            <twig:AlertDialog:Content>
                                <form method="post" action="{{ path('app_clients_remove', {slugId: client.slugId}) }}" class="grid gap-4">
                                    <input type="hidden" name="_token" value="{{ csrf_token('client_remove_' ~ client.slugId) }}">
                                    <twig:AlertDialog:Header>
                                        <twig:AlertDialog:Title>
                                            {{ client.removalDeletesAccount ? 'Supprimer définitivement ce compte ?' : ('Retirer ' ~ client.fullName ~ ' du portefeuille ?') }}
                                        </twig:AlertDialog:Title>
                                        <twig:AlertDialog:Description>
                                            {% if client.removalDeletesAccount %}
                                                Le compte de {{ client.fullName }} sera supprimé et cette action est irréversible.
                                            {% else %}
                                                Ses dossiers brouillons seront supprimés et le client détaché de votre cabinet. Son compte est conservé.
                                            {% endif %}
                                        </twig:AlertDialog:Description>
                                    </twig:AlertDialog:Header>
                                    <div>
                                        <label for="remove_reason" class="block text-xs font-medium text-slate-600 mb-1">Motif</label>
                                        <select id="remove_reason" name="reason" required
                                                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-500">
                                            {% for r in removal_reasons %}
                                                <option value="{{ r.value }}">{{ r.label }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <twig:AlertDialog:Footer>
                                        <twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel>
                                        <twig:AlertDialog:Action type="submit" variant="{{ client.removalDeletesAccount ? 'destructive' : 'dark' }}">
                                            {{ client.removalDeletesAccount ? 'Supprimer' : 'Retirer' }}
                                        </twig:AlertDialog:Action>
                                    </twig:AlertDialog:Footer>
                                </form>
                            </twig:AlertDialog:Content>
                        </twig:AlertDialog>
                    {% else %}
                        <p class="text-xs text-slate-500 mb-2">{{ client.removalBlockedReason }}</p>
                        <twig:Button type="button" disabled variant="outline" class="w-full opacity-60 cursor-not-allowed">
                            Retirer du portefeuille
                        </twig:Button>
                    {% endif %}
                </div>

                {# --- Clôture de la relation d'affaires --- #}
                {% if client.canCloseRelationship %}
                    <div class="bg-white rounded-2xl border border-red-200 shadow-sm p-5">
                        <h2 class="text-xs font-bold text-red-600 uppercase tracking-widest mb-2 flex items-center gap-1.5">
                            <twig:ux:icon name="tabler:alert-triangle" class="size-4" aria-hidden="true" />
                            Clôturer la relation d'affaires
                        </h2>
                        <p class="text-xs text-slate-500 mb-3">
                            <strong>Irréversible.</strong> Chaque dossier engagé sera clôturé et conservé 5 ans (art. L.561-12 CMF).
                            Le client recevra un e-mail. La rupture pour soupçon LCB-FT n'exonère pas de l'obligation déclarative Tracfin.
                        </p>

                        <twig:AlertDialog id="end-relationship">
                            <twig:AlertDialog:Trigger>
                                <twig:Button variant="destructive" class="w-full" {{ ...trigger_attrs }}>Clôturer la relation</twig:Button>
                            </twig:AlertDialog:Trigger>
                            <twig:AlertDialog:Content>
                                <form method="post" action="{{ path('app_clients_end_relationship', {slugId: client.slugId}) }}" class="grid gap-4">
                                    <input type="hidden" name="_token" value="{{ csrf_token('client_end_relationship_' ~ client.slugId) }}">
                                    <twig:AlertDialog:Header>
                                        <twig:AlertDialog:Title>Clôturer la relation avec {{ client.fullName }} ?</twig:AlertDialog:Title>
                                        <twig:AlertDialog:Description>
                                            Action irréversible. Les dossiers engagés passent en fin de relation (conservation 5 ans),
                                            les brouillons vierges sont supprimés, et le client reçoit un e-mail.
                                        </twig:AlertDialog:Description>
                                    </twig:AlertDialog:Header>
                                    <div>
                                        <label for="end_reason" class="block text-xs font-medium text-slate-600 mb-1">Motif</label>
                                        <select id="end_reason" name="reason" required
                                                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
                                            {% for r in end_reasons %}
                                                <option value="{{ r.value }}">{{ r.label }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div>
                                        <label for="confirm_name" class="block text-xs font-medium text-slate-600 mb-1">Retapez le nom du client pour confirmer</label>
                                        <input id="confirm_name" type="text" name="confirm_name" required autocomplete="off" placeholder="{{ client.fullName }}"
                                               class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
                                    </div>
                                    <twig:AlertDialog:Footer>
                                        <twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel>
                                        <twig:AlertDialog:Action type="submit" variant="destructive">Clôturer la relation</twig:AlertDialog:Action>
                                    </twig:AlertDialog:Footer>
                                </form>
                            </twig:AlertDialog:Content>
                        </twig:AlertDialog>
                    </div>
                {% endif %}
            {% endif %}

            {# --- Récapitulatif coordonnées --- #}
            {% if not client.pendingConfirmation %}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3 text-sm">
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest">Coordonnées</h2>
                    <div class="flex justify-between gap-4"><span class="text-slate-500">E-mail</span><span class="font-medium text-slate-900 text-right break-all">{{ client.email }}</span></div>
                    {% if client.phoneNumber %}
                        <div class="flex justify-between"><span class="text-slate-500">Téléphone</span><span class="font-medium text-slate-900">{{ client.phoneNumber }}</span></div>
                    {% endif %}
                    <div class="flex justify-between"><span class="text-slate-500">Compte créé</span><span class="font-medium text-slate-900">{{ client.createdAtFormatted }}</span></div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{# Maquette décorative — entretien enregistré, synthèse IA, rapport validé (exemple illustratif). #}
<div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5" aria-hidden="true">
    <div class="flex items-center gap-3">
        <span class="flex size-9 items-center justify-center rounded-xl border border-slate-200 bg-slate-50">
            {{ ux_icon('lucide:mic', { class: 'size-4 text-slate-600' }) }}
        </span>
        <div class="flex h-6 flex-1 items-center gap-[3px]">
            {% for h in [30, 55, 80, 45, 95, 60, 35, 75, 50, 85, 40, 65, 30, 70, 45, 55, 25, 60] %}
                <span class="w-1 rounded-full bg-slate-300" style="height: {{ h }}%"></span>
            {% endfor %}
        </div>
        <span class="text-[12px] tabular-nums text-slate-600">42:18</span>
    </div>

    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4">
        <p class="inline-flex items-center gap-2 text-[12px] font-semibold text-slate-900">
            {{ ux_icon('lucide:sparkles', { class: 'size-3.5 text-slate-600' }) }} Synthèse proposée
        </p>
        <ul class="mt-3 space-y-2 text-[12px] text-slate-600">
            <li>· Objectifs : préparer la retraite, transmettre</li>
            <li>· Horizon de placement et tolérance au risque</li>
            <li>· Situation patrimoniale et origine des fonds</li>
        </ul>
    </div>

    <div class="mt-4 rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4">
        <div class="flex items-center gap-3">
            {{ ux_icon('lucide:badge-check', { class: 'size-5 text-emerald-600' }) }}
            <div>
                <p class="text-[13px] font-semibold text-slate-900">Rapport validé par le conseiller</p>
                <p class="text-[12px] text-slate-600">Figé et daté : toute révocation est tracée</p>
            </div>
        </div>
    </div>
</div>

{# Maquette décorative — lecture OCR d'une pièce (exemple illustratif, données fictives). #}
<div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5" aria-hidden="true">
    <div class="flex items-center gap-4">
        <div class="flex h-20 w-32 shrink-0 flex-col justify-between rounded-xl border border-slate-200 bg-slate-50 p-3">
            <div class="h-2 w-1/2 rounded-full bg-slate-200"></div>
            <div class="space-y-1.5">
                <div class="h-1.5 w-full rounded-full bg-slate-200"></div>
                <div class="h-1.5 w-3/4 rounded-full bg-slate-200"></div>
            </div>
        </div>
        {{ ux_icon('lucide:arrow-right', { class: 'size-5 shrink-0 text-slate-600' }) }}
        <p class="text-[13px] font-semibold text-slate-900">Champs lus automatiquement</p>
    </div>

    <dl class="mt-5 divide-y divide-slate-100 rounded-2xl border border-slate-200">
        <div class="flex items-center justify-between px-4 py-3">
            <dt class="text-[12px] text-slate-600">Nom</dt>
            <dd class="text-[13px] font-medium text-slate-900">MARTIN</dd>
        </div>
        <div class="flex items-center justify-between px-4 py-3">
            <dt class="text-[12px] text-slate-600">Prénom</dt>
            <dd class="text-[13px] font-medium text-slate-900">Camille</dd>
        </div>
        <div class="flex items-center justify-between px-4 py-3">
            <dt class="text-[12px] text-slate-600">Date de naissance</dt>
            <dd class="text-[13px] font-medium text-slate-900">12/03/1980</dd>
        </div>
        <div class="flex items-center justify-between border-l-4 border-l-amber-500 px-4 py-3">
            <dt class="text-[12px] text-slate-600">Date d'expiration</dt>
            <dd class="text-[13px] font-medium text-amber-700">À vérifier</dd>
        </div>
    </dl>
</div>

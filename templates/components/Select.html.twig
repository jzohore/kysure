{# @block content The default block #}
{# Même palette que Input.html.twig (bordure, fond, anneau de focus) : un select et un champ texte côte à côte doivent être identiques. #}
<select
    class="{{ 'flex h-10 w-full items-center justify-between rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-400 disabled:opacity-50 transition-colors [&>span]:line-clamp-1 ' ~ attributes.render('class')|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</select>

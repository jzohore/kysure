<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# SEO : Portail privé, on bloque les moteurs de recherche #}
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="Transmission sécurisée de votre dossier de conformité pour {{ folder.workspaceName|default('votre conseiller') }}.">

    <title>{% block title %}Dossier de conformité | {{ folder.workspaceName|default('Shield') }}{% endblock %}</title>
    <link rel="canonical" href="{{ app.request.getSchemeAndHttpHost() ~ app.request.getRequestUri() }}">

    {# Favicon propre #}
    {% include '_favicons.html.twig' %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full font-sans text-slate-900 bg-slate-50 selection:bg-indigo-100 selection:text-indigo-900">

{# ACCESSIBILITÉ #}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-slate-900 focus:text-white focus:rounded-md">
    Aller au contenu principal
</a>
{% block header %}
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0 z-30 shadow-sm sticky top-0">
        <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-slate-900 tracking-tight">{{ company_name|default('Shield') }}</span>
        </div>
        <a href="{{ path('app_dashboard') }}" class="group p-2 hover:bg-slate-50 rounded-full transition-all flex items-center gap-2" title="Revenir au tableau de bord">
            <span class="text-xs font-medium text-slate-400 group-hover:text-slate-600 hidden sm:block">Quitter</span>
            <twig:ux:icon name="lucide:x" class="size-5 text-slate-400 group-hover:text-slate-900" />
        </a>
    </header>
{% endblock %}

<div class="flex h-screen flex-col md:flex-row overflow-hidden">

    {# ========================================== #}
    {# HEADER MOBILE (Caché sur desktop)          #}
    {# ========================================== #}
    <header class="md:hidden py-4 px-6 bg-white border-b border-slate-200 flex items-center justify-between shrink-0 shadow-sm relative z-20">

    </header>


    {# ========================================== #}
    {# LA ZONE DROITE CENTRALE (Scrollable)       #}
    {# ========================================== #}
    <div class="flex-1 flex flex-col relative overflow-y-auto bg-slate-50/50">

        {# La fameuse grille de fond "Tech" #}
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

        {# Le MAIN qui va accueillir tes cartes blanches dynamiquement #}
        <main id="main-content" class="flex-1 flex flex-col items-center justify-center p-6 lg:p-12 relative z-10">
            <div class="w-full {{ container_width|default('max-w-xl') }} animate-in fade-in slide-in-from-bottom-4 duration-700 my-auto">

                {# La carte blanche universelle pour le contenu du formulaire #}
                {% block portal_content %}{% endblock %}

            </div>
        </main>

        {# FOOTER (Assistance & Branding SaaS sur mobile/desktop) #}
        {% if app.current_route != 'app_compliance_method_new' %}
        <footer class="p-6 text-center text-sm text-slate-500 relative z-10 shrink-0 flex flex-col items-center justify-center gap-2 mt-auto">
            <div>
                Un problème technique&nbsp;? Contactez votre conseiller, qui vous a transmis ce lien.
            </div>
            {# Affichage du SaaS uniquement sur mobile en bas, car sur desktop il est déjà dans la sidebar #}
            <div class="md:hidden text-[10px] text-slate-400 flex items-center gap-1 mt-2">
                <twig:ux:icon name="tabler:lock" class="size-3" /> Sécurisé par {{ company_name }}
            </div>
        </footer>
        {% endif %}

    </div>
</div>

{# Overlays flottants (position: fixed) — rendus HORS de toute zone animée
   pour ne pas hériter d'un bloc conteneur créé par un ancêtre `transform`. #}
{% block floating_widgets %}{% endblock %}

{% include '@app/partials/_flashes.html.twig' %}
</body>

</html>

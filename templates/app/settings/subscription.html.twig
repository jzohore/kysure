{% extends '@app/settings/base_settings.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block settings_content %}

    {% set ws = workspaceInfo() %}
    {% set active = subInfo.hasActiveAccess %}

    <div class="grid gap-6 lg:grid-cols-3">

        {# ── Offre actuelle ── #}
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 {{ subInfo.isPaused ? 'border-l-4 border-l-amber-500' : '' }} p-6 shadow-sm">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Offre actuelle</p>

            {% if subInfo.isPaused %}
                <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-bold text-slate-900 tracking-tight">
                        {{ subInfo.planReference == 'cabinet' ? 'Cabinet' : 'Indépendant' }}
                    </span>
                    <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">Suspendu</span>
                </div>
                <p class="mt-1 text-sm text-slate-500">Facturation interrompue, accès gelé. Reprenez quand vous voulez.</p>
                <form method="post" action="{{ path('app_settings_subscription_resume') }}" class="mt-4" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('subscription-resume') }}">
                    <twig:Button type="submit" variant="dark" size="sm">Reprendre l'abonnement</twig:Button>
                </form>
            {% elseif active %}
                <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-bold text-slate-900 tracking-tight">
                        {{ subInfo.planReference == 'cabinet' ? 'Cabinet' : 'Indépendant' }}
                    </span>
                    <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-bold text-emerald-700">
                        {{ subInfo.status == 'trialing' ? 'Essai' : 'Actif' }}
                    </span>
                </div>
                <p class="mt-1 text-sm text-slate-500 tabular-nums">
                    {{ subInfo.seatsCount }} siège{{ subInfo.seatsCount > 1 ? 's' : '' }}
                    {% if subInfo.basePrice %} · {{ subInfo.basePrice|number_format(0, ',', ' ') }} € / siège / mois{% endif %}
                </p>
                {% if subInfo.currentPeriodEnd %}
                    <p class="mt-1 text-xs text-slate-400">
                        {{ subInfo.cancelAtPeriodEnd ? 'Se termine le' : 'Prochain renouvellement le' }}
                        {{ subInfo.currentPeriodEnd|date('d/m/Y') }}
                    </p>
                {% endif %}

                {% if not subInfo.cancelAtPeriodEnd %}
                    <a href="{{ path('app_settings_subscription_cancel') }}" class="mt-4 inline-block text-sm font-medium text-rose-600 hover:underline">
                        Résilier l'abonnement
                    </a>
                {% endif %}
            {% else %}
                <p class="text-sm text-slate-600">
                    Vous n'avez pas d'abonnement actif — vous êtes en essai gratuit
                    (<span class="tabular-nums">{{ ws.remainingMeetingMinutes|default(0) }}</span> min restantes).
                </p>
                <div class="mt-4">
                    <twig:Button as="a" href="{{ path('app_pricing') }}" variant="dark" size="sm">Voir les offres</twig:Button>
                </div>
            {% endif %}
        </div>

        {# ── Minutes d'entretien ── #}
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Minutes d'entretien</p>
            <div class="flex items-baseline gap-1">
                <span class="text-3xl font-bold text-slate-900 tabular-nums">{{ ws.remainingMeetingMinutes|default(0) }}</span>
                <span class="text-sm text-slate-500">/ {{ ws.meetingMinutesAllocated|default(0) }}</span>
            </div>
            <a href="{{ path('app_pricing') }}#packs" class="mt-3 inline-block text-sm font-medium text-indigo-600 hover:underline">Acheter des minutes →</a>
        </div>
    </div>

    {# ── Sièges (cabinet abonné) ── #}
    {% set seats = seatInfo() %}
    {% if seats.isFirm %}
        <div class="mt-6 bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Sièges</p>
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold {{ seats.remaining == 0 ? 'text-amber-600' : 'text-slate-900' }} tabular-nums">{{ seats.used }}</span>
                        <span class="text-sm text-slate-500">/ {{ seats.allowed }} utilisés</span>
                    </div>
                    <p class="mt-1 text-xs text-slate-400">Un siège = un collaborateur actif ou une invitation en attente.</p>
                </div>

                {% if active %}
                    <form method="post" action="{{ path('app_billing_seats') }}" class="flex items-end gap-2" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('billing_seats') }}">
                        <label class="flex flex-col gap-1">
                            <span class="text-xs font-medium text-slate-500">Total de sièges</span>
                            <input type="number" name="seats" min="{{ max(seats.used, 2) }}" value="{{ seats.allowed }}"
                                   class="w-24 rounded-md border border-slate-300 px-2 py-1.5 text-sm tabular-nums focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        </label>
                        <twig:Button type="submit" variant="outline" size="sm">Mettre à jour</twig:Button>
                    </form>
                {% else %}
                    <a href="{{ path('app_pricing') }}" class="text-sm font-medium text-indigo-600 hover:underline">Passer à l'abonnement pour ajouter des sièges →</a>
                {% endif %}
            </div>
            <p class="mt-3 text-[11px] text-slate-400">La modification est facturée au prorata sur votre prochaine facture.</p>
        </div>
    {% endif %}

    {# ── Factures ── #}
    {% if subInfo.invoices is not empty %}
        <section class="mt-6 bg-white rounded-xl border border-slate-200 shadow-sm">
            <div class="p-5 border-b border-slate-100">
                <h2 class="text-sm font-bold text-slate-900">Factures</h2>
            </div>
            <ul class="divide-y divide-slate-100">
                {% for invoice in subInfo.invoices %}
                    <li class="flex items-center justify-between px-5 py-3 text-sm">
                        <span class="text-slate-600 tabular-nums">{{ invoice.date|date('d/m/Y') }}</span>
                        <span class="font-medium text-slate-900 tabular-nums">{{ invoice.amount|number_format(2, ',', ' ') }} €</span>
                        <span class="text-xs text-slate-400">{{ invoice.status }}</span>
                        {% if invoice.pdf_url %}
                            <a href="{{ invoice.pdf_url }}" target="_blank" rel="noopener" class="text-xs font-medium text-indigo-600 hover:underline">PDF</a>
                        {% else %}
                            <span></span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}

{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block button_page %}
    <twig:Button as="a" href="{{ path('admin_team_new') }}" variant="link" size="sm">
        <twig:ux:icon name="ic:baseline-plus" />
        Nouveau membre
    </twig:Button>
{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Équipe KYSURE</h1>
        <p class="text-sm text-slate-500 mt-1">
            Comptes du back-office. Créer, modifier le profil ou le rôle, suspendre, archiver ou supprimer —
            chaque action est tracée dans le journal d'audit et notifiée par e-mail au membre concerné.
        </p>
    </div>

    <twig:AdminAccountsListComponent />
{% endblock %}

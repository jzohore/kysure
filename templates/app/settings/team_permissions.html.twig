{% extends '@app/settings/base_settings.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block settings_content %}

    <div class="max-w-3xl space-y-8 pb-12">
        <form method="POST" action="{{ path('app_settings_team_permissions') }}"
              class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('team-permissions') }}">

            <div class="border-b border-slate-100 p-6">
                <h3 class="font-semibold tracking-tight text-slate-900">Actions déléguées aux collaborateurs</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Ce qui n'est pas coché reste réservé aux administrateurs. La facturation, la révocation
                    d'un membre et le verrou de litige ne sont jamais délégables.
                </p>
            </div>

            <div class="divide-y divide-slate-100">
                {% set toggles = [
                    { name: 'collab_can_invite', label: 'Inviter, renvoyer et annuler des invitations', on: workspace.collabCanInvite },
                    { name: 'collab_can_manage_portfolio', label: 'Ajouter des clients au portefeuille (le retrait reste admin)', on: workspace.collabCanManagePortfolio },
                    { name: 'collab_can_edit_cabinet', label: 'Modifier la fiche et les réglages du cabinet', on: workspace.collabCanEditCabinet },
                    { name: 'collab_can_archive_folder', label: 'Archiver un dossier de conformité', on: workspace.collabCanArchiveFolder },
                ] %}

                {% for toggle in toggles %}
                    <label class="flex items-start justify-between gap-4 p-6" for="{{ toggle.name }}">
                        <span class="text-sm font-medium text-slate-900">{{ toggle.label }}</span>
                        <input type="checkbox" id="{{ toggle.name }}" name="{{ toggle.name }}" value="1"
                               {{ toggle.on ? 'checked' : '' }}
                               class="mt-0.5 size-4 shrink-0 rounded border-slate-300 text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-300">
                    </label>
                {% endfor %}
            </div>

            <div class="border-t border-slate-100 p-6">
                <h3 class="font-semibold tracking-tight text-slate-900">Validation des actes de conformité</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Qui peut valider ou rejeter un dossier KYC et un rapport d'entretien.
                </p>
                <div class="mt-4 space-y-2">
                    {% for mode in validation_modes %}
                        <label class="flex items-center gap-3 rounded-lg border border-slate-200 p-3 text-sm has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/30" for="mode-{{ mode.value }}">
                            <input type="radio" id="mode-{{ mode.value }}" name="validation_mode" value="{{ mode.value }}"
                                   {{ workspace.validationMode == mode ? 'checked' : '' }}
                                   class="size-4 text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-300">
                            <span class="font-medium text-slate-900">{{ mode.getLabel() }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="flex justify-end border-t border-slate-100 p-6">
                <twig:Button type="submit" variant="dark">Enregistrer</twig:Button>
            </div>
        </form>
    </div>
{% endblock %}

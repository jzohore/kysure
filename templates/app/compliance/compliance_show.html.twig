{% extends '@app/base_app.html.twig' %}

{# Macros au niveau racine du template (Twig 3.28+ : macro dans un block déprécié). Appel : _self.nom() #}

{# Liens de consultation de la pièce. Pièce à deux faces (CNI) : un lien nommé par face, pour ne jamais en perdre une de vue. #}
{% macro file_links(doc, label) %}
    {% if doc.storagePath %}
        {% set faces = doc.backStoragePath
            ? [{ name: 'Voir le recto', path: doc.storagePath }, { name: 'Voir le verso', path: doc.backStoragePath }]
            : [{ name: 'Voir le document', path: doc.storagePath }] %}
        {% for face in faces %}
            <a href="{{ face.path|private_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ label }} — {{ face.name|lower }}"
               class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-slate-700 underline-offset-4 hover:text-slate-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                <twig:ux:icon name="tabler:eye" class="size-4 text-slate-400" aria-hidden="true" />
                {{ face.name }}
            </a>
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Données lues par l'analyse automatique, en liste de définitions aérée. #}
{% macro render_ocr(ocrData) %}
    {% set labels = {
        'first_name': 'Prénom', 'last_name': 'Nom de famille', 'birth_date': 'Date de naissance',
        'birth_place': 'Lieu de naissance', 'id_number': 'Numéro de pièce', 'nationality': 'Nationalité',
        'gender': 'Sexe', 'document_type': 'Type de document', 'company_name': 'Nom de la société',
        'registration_number': 'Immatriculation (SIREN/RCS)', 'legal_form': 'Forme juridique',
        'share_capital': 'Capital social', 'date_of_registration': 'Date d\'immatriculation',
        'registered_address': 'Siège social', 'duration_of_company': 'Durée de la société',
        'activity_code_ape': 'Code APE', 'management': 'Dirigeants', 'establishments': 'Établissements secondaires',
        'mrz': 'Bande de lecture optique (MRZ)', 'address': 'Adresse',
        'holder_name': 'Titulaire', 'document_date': 'Date du document', 'date_of_expiry': 'Date d\'expiration',
        'iban': 'IBAN', 'bic': 'BIC'
    } %}

    <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
        {% for key, value in ocrData %}
            <div class="{{ value is iterable ? 'sm:col-span-2' : '' }}">
                <dt class="text-xs text-slate-500">
                    {{ labels[key]|default(key|replace({'_': ' '})|capitalize) }}
                </dt>
                <dd class="mt-1 text-sm text-slate-900">
                    {% if value is empty %}
                        <span class="italic text-slate-400">Non détecté</span>
                    {% elseif key in ['birth_date', 'date_of_registration', 'document_date', 'date_of_expiry'] %}
                        {{ value|date('d/m/Y') }}
                    {% elseif key == 'share_capital' %}
                        {{ value|number_format(0, ',', ' ') }} €
                    {% elseif key == 'management' %}
                        <ul class="mt-1 grid grid-cols-1 gap-3 sm:grid-cols-2">
                            {% for person in value %}
                                <li class="rounded-xl border border-slate-200 bg-white p-3">
                                    <span class="block font-medium text-slate-900">{{ person.name }}</span>
                                    <span class="block text-xs text-slate-500">{{ person.role }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% elseif key == 'establishments' %}
                        <ul class="mt-1 grid grid-cols-1 gap-3 sm:grid-cols-2">
                            {% for est in value %}
                                <li class="rounded-xl border border-slate-200 bg-white p-3">
                                    <span class="block font-medium text-slate-900">{{ est.activity|default('Activité non précisée') }}</span>
                                    <span class="block text-xs text-slate-500">{{ est.address }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% elseif key == 'mrz' %}
                        <div class="mt-1 overflow-x-auto rounded-xl border border-slate-200 bg-white p-3 font-mono text-xs tracking-widest text-slate-700" aria-label="Zone de lecture optique">
                            {% for line_val in value %}
                                <div class="whitespace-nowrap">{{ line_val }}</div>
                            {% endfor %}
                        </div>
                    {% elseif key == 'iban' %}
                        {# Donnée bancaire : jamais affichée en entier (minimisation) #}
                        <span class="tabular-nums">{{ value|slice(0, 4) }} •••• •••• {{ value|slice(-4) }}</span>
                    {% elseif key == 'address' and value is not iterable %}
                        {# Textract et le service OCR local renvoient l'adresse en une ligne ; Mindee, un objet structuré #}
                        {{ value }}
                    {% elseif key == 'address' %}
                        {{ value.full_address|default(value.city ~ (value.department ? ' (' ~ value.department ~ ')' : '')) }}
                    {% else %}
                        {{ value }}
                    {% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>
{% endmacro %}

{# Nom du fichier d'une pièce. Un document généré par KYSURE (DER) n'a pas de nom d'origine : seul son chemin est connu. #}
{% macro file_label(doc) %}
    {%- if doc.isAwaitingClient -%}
        En attente du client
    {%- elseif doc.filename -%}
        {{ doc.filename }}
    {%- elseif doc.storagePath -%}
        {{ doc.statusValue in ['generated', 'acknowledged'] ? 'PDF généré par KYSURE' : 'Fichier reçu' }}
    {%- else -%}
        Aucun fichier
    {%- endif -%}
{% endmacro %}

{# État de l'analyse automatique à gauche, action « Analyser / Relancer » à droite.
   Action réservée à l'équipe KYSURE et au dev (chaque analyse peut être facturée par le fournisseur OCR). #}
{% macro ocr_footer(doc, folderSlug) %}
    {% set canAnalyse = (app.environment == 'dev' or is_granted('ROLE_ADMIN'))
        and doc.storagePath and doc.statusValue == 'uploaded' and doc.ocrState in ['completed', 'unavailable'] %}
    {% if doc.ocrState in ['in_progress', 'manual_check', 'unavailable', 'completed'] %}
        <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">{{ _self.render_ocr_state(doc.ocrState, doc.ocrFindings, doc.ocrAnalyzedAt) }}</div>
            {% if canAnalyse %}
                <form action="{{ path('app_compliance_document_ocr_rerun', { slugId: folderSlug, documentId: doc.id }) }}" method="post" class="shrink-0 sm:ml-auto">
                    <input type="hidden" name="_token" value="{{ csrf_token('rerun_ocr_' ~ doc.id) }}">
                    <twig:Button type="submit" variant="ghost" size="sm" aria-label="{{ doc.ocrState == 'completed' ? 'Relancer' : 'Lancer' }} l'analyse automatique du document {{ doc.typeLabel }}">
                        {% if doc.ocrState == 'completed' %}
                            <twig:ux:icon name="tabler:refresh" class="size-4 text-slate-500" aria-hidden="true" /> Relancer l'analyse
                        {% else %}
                            <twig:ux:icon name="tabler:scan" class="size-4 text-slate-500" aria-hidden="true" /> Analyser le document
                        {% endif %}
                    </twig:Button>
                </form>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{# Décision du conseiller sur une pièce. Avant décision : « Refuser » / « Valider ». Après : qui, quand, et
   « Annuler » tant que c'est réversible (validation, ou refus pas encore signalé au client). #}
{% macro review_bar(doc, folderSlug, canReview) %}
    {% set csrf = csrf_token('review_doc_' ~ doc.id) %}
    {% if doc.statusValue == 'valid' and doc.reviewedAt %}
        <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-center gap-2 text-sm text-slate-600">
                <twig:ux:icon name="tabler:circle-check" class="size-4 text-emerald-600" aria-hidden="true" />
                Validée par {{ doc.reviewedByName }} le {{ doc.reviewedAt|date('d/m/Y à H:i') }}
            </p>
            {% if canReview and doc.canCancelReview %}
                {{ _self.cancel_review_dialog(doc, folderSlug, csrf, 'Annuler la validation') }}
            {% endif %}
        </div>
    {% elseif doc.statusValue == 'rejected' and doc.reviewedAt %}
        <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-slate-600">
                <twig:ux:icon name="tabler:circle-x" class="size-4 text-rose-600" aria-hidden="true" />
                Refusée par {{ doc.reviewedByName }} le {{ doc.reviewedAt|date('d/m/Y à H:i') }} ·
                {% if doc.correctionRequestedAt %}
                    signalée au client le {{ doc.correctionRequestedAt|date('d/m/Y') }}
                {% else %}
                    <span class="font-medium text-amber-800">pas encore signalée au client</span>
                {% endif %}
            </p>
            {% if canReview and doc.canCancelReview %}
                {{ _self.cancel_review_dialog(doc, folderSlug, csrf, 'Annuler le refus') }}
            {% endif %}
        </div>
    {% elseif canReview and doc.awaitsReview %}
        <div class="mt-6 flex flex-col gap-4 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-600">À vérifier : validez la pièce, ou refusez-la avec un motif communiqué au client.</p>
            <div class="flex shrink-0 items-center gap-2">
                <twig:Dialog id="reject_doc_{{ doc.id }}" class="sm:max-w-lg">
                    <twig:Dialog:Trigger>
                        <twig:Button variant="outline" size="sm" {{ ...dialog_trigger_attrs }}>
                            <twig:ux:icon name="tabler:x" class="size-4" aria-hidden="true" /> Refuser
                        </twig:Button>
                    </twig:Dialog:Trigger>
                    <twig:Dialog:Content>
                        <twig:Dialog:Header>
                            <twig:Dialog:Title class="text-slate-900">Refuser « {{ doc.typeLabel }} »</twig:Dialog:Title>
                            <twig:Dialog:Description class="text-slate-600">
                                Le motif sera lu par le client. Rien ne lui est envoyé maintenant : vous lui signalerez
                                toutes les pièces refusées en une fois avec « Demander les corrections au client ».
                            </twig:Dialog:Description>
                        </twig:Dialog:Header>
                        <form method="post" action="{{ path('app_compliance_document_reject', { slugId: folderSlug, documentId: doc.id }) }}" class="mt-4 space-y-4">
                            <input type="hidden" name="_token" value="{{ csrf }}">
                            <div>
                                <label for="reject_reason_{{ doc.id }}" class="block text-sm font-medium text-slate-900">Motif</label>
                                <select id="reject_reason_{{ doc.id }}" name="reason" required class="mt-1.5 block w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                                    <option value="" disabled selected>Choisir un motif…</option>
                                    {% for reason in enum_cases('App\\Domain\\Compliance\\Enum\\DocumentRejectionReason') %}
                                        <option value="{{ reason.value }}">{{ reason.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="reject_comment_{{ doc.id }}" class="block text-sm font-medium text-slate-900">Précision pour le client</label>
                                <p id="reject_comment_help_{{ doc.id }}" class="mt-0.5 text-xs text-slate-600">Facultative, sauf pour « Autre motif ». 500 caractères maximum.</p>
                                <textarea id="reject_comment_{{ doc.id }}" name="comment" rows="3" maxlength="500" aria-describedby="reject_comment_help_{{ doc.id }}" class="mt-1.5 block w-full rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" placeholder="Ex. : merci de photographier la pièce à plat, sans reflet."></textarea>
                            </div>
                            <twig:Dialog:Footer>
                                <twig:Dialog:Close>
                                    <twig:Button type="button" variant="outline" {{ ...dialog_close_attrs }}>Annuler</twig:Button>
                                </twig:Dialog:Close>
                                <twig:Button type="submit" variant="destructive">Refuser la pièce</twig:Button>
                            </twig:Dialog:Footer>
                        </form>
                    </twig:Dialog:Content>
                </twig:Dialog>
                <form method="post" action="{{ path('app_compliance_document_validate', { slugId: folderSlug, documentId: doc.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <twig:Button type="submit" variant="success" size="sm" aria-label="Valider le document {{ doc.typeLabel }}">
                        <twig:ux:icon name="tabler:check" class="size-4" aria-hidden="true" /> Valider
                    </twig:Button>
                </form>
            </div>
        </div>
    {% endif %}
{% endmacro %}

{% macro cancel_review_dialog(doc, folderSlug, csrf, label) %}
    <twig:Dialog id="cancel_review_{{ doc.id }}" class="sm:max-w-lg">
        <twig:Dialog:Trigger>
            <twig:Button variant="ghost" size="sm" class="shrink-0" {{ ...dialog_trigger_attrs }}>
                <twig:ux:icon name="tabler:arrow-back-up" class="size-4" aria-hidden="true" /> {{ label }}
            </twig:Button>
        </twig:Dialog:Trigger>
        <twig:Dialog:Content>
            <twig:Dialog:Header>
                <twig:Dialog:Title class="text-slate-900">{{ label }} — « {{ doc.typeLabel }} »</twig:Dialog:Title>
                <twig:Dialog:Description class="text-slate-600">
                    La pièce redeviendra « à vérifier ». L'annulation et son motif sont conservés dans le journal d'audit.
                </twig:Dialog:Description>
            </twig:Dialog:Header>
            <form method="post" action="{{ path('app_compliance_document_cancel_review', { slugId: folderSlug, documentId: doc.id }) }}" class="mt-4 space-y-4">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <div>
                    <label for="cancel_reason_{{ doc.id }}" class="block text-sm font-medium text-slate-900">Motif de l'annulation</label>
                    <textarea id="cancel_reason_{{ doc.id }}" name="reason" rows="3" maxlength="500" required class="mt-1.5 block w-full rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400" placeholder="Ex. : validée par erreur, date de validité à revérifier."></textarea>
                </div>
                <twig:Dialog:Footer>
                    <twig:Dialog:Close>
                        <twig:Button type="button" variant="outline" {{ ...dialog_close_attrs }}>Fermer</twig:Button>
                    </twig:Dialog:Close>
                    <twig:Button type="submit" variant="dark">{{ label }}</twig:Button>
                </twig:Dialog:Footer>
            </form>
        </twig:Dialog:Content>
    </twig:Dialog>
{% endmacro %}

{% macro render_ocr_state(state, findings, analyzedAt = null) %}
    {% if state == 'in_progress' %}
        <p class="flex items-center gap-2 text-sm text-slate-500" role="status">
            <twig:ux:icon name="tabler:clock-hour-4" class="size-4 text-slate-400" aria-hidden="true" />
            Analyse automatique en cours…
        </p>
    {% elseif state == 'manual_check' %}
        <p class="flex items-center gap-2 text-sm text-slate-500">
            <twig:ux:icon name="tabler:eye" class="size-4 text-slate-400" aria-hidden="true" />
            Vérification manuelle : ce type de pièce n'est pas analysé automatiquement.
        </p>
    {% elseif state == 'unavailable' and findings is empty %}
        <p class="flex items-center gap-2 text-sm text-amber-800" role="status">
            <twig:ux:icon name="tabler:alert-triangle" class="size-4 text-amber-600" aria-hidden="true" />
            L'analyse automatique n'a pas abouti. Vérification manuelle requise.
        </p>
    {% endif %}
    {% if state == 'completed' and analyzedAt %}
        <p class="flex items-center gap-2 text-sm text-slate-500">
            <twig:ux:icon name="tabler:calendar-check" class="size-4 text-slate-400" aria-hidden="true" />
            Analysée le <time datetime="{{ analyzedAt|date('c') }}">{{ analyzedAt|date('d/m/Y à H:i') }}</time>
        </p>
    {% endif %}
{% endmacro %}

{# Points de vigilance relevés par l'analyse automatique : des signalements pour la revue du conseiller, jamais une décision. #}
{% macro render_findings(findings) %}
    {% if findings is not empty %}
        <div class="mt-5 border-l-2 border-amber-400 pl-4" role="status">
            <p class="text-sm font-medium text-slate-900">Points de vigilance de l'analyse automatique</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-600 marker:text-amber-400">
                {% for finding in findings %}
                    <li class="whitespace-pre-line">{{ finding }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endmacro %}

{# Statut d'une pièce : une pastille de couleur et un libellé, sans cadre. #}
{% macro status_label(status, isRequestedToClient = false) %}
    {% if isRequestedToClient or status == 'requested' %}
        {% set s = { dot: 'bg-violet-500', label: 'Demandé au client' } %}
    {% else %}
        {% set config = {
            'draft':        { dot: 'bg-slate-300',   label: 'Brouillon' },
            'pending':      { dot: 'bg-slate-300',   label: 'En attente' },
            'processing':   { dot: 'bg-indigo-500',  label: 'Traitement' },
            'generated':    { dot: 'bg-slate-400',   label: 'Généré' },
            'acknowledged': { dot: 'bg-emerald-500', label: 'Accusé de réception' },
            'uploaded':     { dot: 'bg-amber-500',   label: 'À vérifier' },
            'valid':        { dot: 'bg-emerald-500', label: 'Validé' },
            'rejected':     { dot: 'bg-rose-500',    label: 'Refusé' },
            'expired':      { dot: 'bg-slate-400',   label: 'Expiré' }
        } %}
        {% set s = config[status]|default(config['pending']) %}
    {% endif %}
    <span class="inline-flex shrink-0 items-center gap-2 text-sm text-slate-600" role="status">
        <span class="size-2 rounded-full {{ s.dot }}" aria-hidden="true"></span>
        {{ s.label }}
    </span>
{% endmacro %}

{# Une pièce du dossier : titre et statut, fichiers, puis ce qui demande l'attention du conseiller, dans l'ordre. #}
{% macro document_card(doc, folderSlug, canReview, subject) %}
    <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
            <div class="min-w-0">
                <h3 class="text-base font-medium text-slate-900">{{ doc.typeLabel }}</h3>
                <p class="mt-1 max-w-md truncate text-sm text-slate-500">{{ _self.file_label(doc) }}</p>
            </div>
            {{ _self.status_label(doc.statusValue, doc.isAwaitingClient) }}
        </div>

        {% if doc.storagePath %}
            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
                {{ _self.file_links(doc, 'Visualiser le document ' ~ subject) }}
            </div>
        {% endif %}

        {% if doc.statusValue == 'rejected' and doc.rejectionReason %}
            <div class="mt-5 border-l-2 border-rose-400 pl-4" role="alert">
                <p class="text-sm font-medium text-slate-900">Motif du refus</p>
                <p class="mt-1 whitespace-pre-line text-sm text-slate-600">{{ doc.rejectionReason }}</p>
            </div>
        {% endif %}

        {{ _self.render_findings(doc.ocrFindings) }}
        {{ _self.ocr_footer(doc, folderSlug) }}

        {% if doc.ocrData %}
            <details class="group/details mt-5">
                <summary class="flex w-fit cursor-pointer list-none select-none items-center gap-1.5 rounded-md pr-2 text-sm text-slate-600 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                    <twig:ux:icon name="tabler:chevron-right" class="size-4 transition-transform group-open/details:rotate-90" aria-hidden="true" />
                    Voir les données extraites
                </summary>
                <div class="mt-4 overflow-x-auto rounded-xl bg-slate-50 p-5 sm:p-6">
                    {{ _self.render_ocr(doc.ocrData) }}
                </div>
            </details>
        {% endif %}

        {{ _self.review_bar(doc, folderSlug, canReview) }}
    </article>
{% endmacro %}

{# Titre de section en serif, avec le décompte des pièces et celles qui attendent le conseiller. #}
{% macro section_heading(id, title, docs) %}
    {% set toReview = docs|filter(d => d.statusValue == 'uploaded')|length %}
    <div class="mb-6">
        <h2 id="{{ id }}" class="font-serif text-2xl tracking-tight text-slate-900">{{ title }}</h2>
        {% if docs|length > 0 %}
            <p class="mt-1 text-sm text-slate-500">
                {{ docs|length }} pièce{{ docs|length > 1 ? 's' : '' }}{% if toReview > 0 %} · {{ toReview }} à vérifier{% endif %}
            </p>
        {% endif %}
    </div>
{% endmacro %}

{% block title %}Dossier {{ dto.reference }} | {{ company_name }}{% endblock %}
{% block page_title %}Dossier {{ dto.reference }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('app_kyc_list') }}" class="text-xs">
            Dossiers KYC / LCB-FT
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    {# Une seule colonne de lecture : tout le dossier se parcourt de haut en bas, sans panneau latéral. #}
    <div class="mx-auto max-w-4xl px-4 pb-24 pt-6 sm:px-6 lg:px-8" data-controller="mercure-reload" data-mercure-reload-topic-value="{{ mercure('folder_' ~ dto.slugId) }}">

        <a href="{{ path('app_compliance_list') }}" class="inline-flex items-center gap-2 rounded-md text-sm text-slate-500 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
            <twig:ux:icon name="solar:arrow-left-bold" class="size-4" aria-hidden="true" />
            Retour à la liste
        </a>

        {# EN-TÊTE #}
        <header class="mt-8">
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
                <span>Dossier <span class="sr-only">référence</span> {{ dto.reference }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ dto.isKyb ? 'Personne morale (KYB)' : 'Personne physique (KYC)' }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ dto.isManual ? 'Création manuelle' : 'Création API' }}</span>
            </p>

            <h1 class="mt-3 break-words font-serif text-3xl tracking-tight text-slate-900 sm:text-4xl">
                {{ dto.headerTitle }}
            </h1>
            <p class="mt-2 text-base text-slate-600">{{ dto.headerSubtitle }}</p>

            <p class="mt-5 inline-flex items-center gap-2 text-sm text-slate-600" role="status">
                {% if dto.isArchived %}
                    <twig:ux:icon name="tabler:lock" class="size-4 text-slate-400" aria-hidden="true" />
                    Archivé
                {% else %}
                    <span class="size-2 rounded-full bg-amber-500" aria-hidden="true"></span>
                    {{ dto.statusLabel }}
                {% endif %}
            </p>

            {# Contact et actions secondaires : une seule ligne, discrète. L'action principale est la décision plus bas. #}
            <div class="mt-8 flex flex-col gap-4 border-y border-slate-200 py-5 sm:flex-row sm:items-center sm:justify-between">
                <p class="min-w-0 text-sm text-slate-600">
                    {{ dto.contactName }}
                    <span aria-hidden="true" class="mx-1.5 text-slate-300">·</span>
                    <a href="mailto:{{ dto.contactEmail }}" class="break-all rounded-sm text-slate-900 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">{{ dto.contactEmail }}</a>
                </p>

                <div class="flex flex-wrap items-center gap-2">
                    {% if not dto.isKyb %}
                        <twig:Button as="a" href="{{ path('app_compliance_wealth_profile_edit', {slugId: dto.slugId}) }}" variant="outline" size="sm">
                            <twig:ux:icon name="tabler:file-description" class="size-4" aria-hidden="true" />
                            Fiche patrimoniale (EER)
                        </twig:Button>
                    {% endif %}

                    {# Verrouillage : on ne pousse pas le CGP à envoyer le lien d'upload d'un dossier archivé #}
                    {% if not dto.isArchived %}
                        <twig:Button type="button" variant="ghost" size="sm" data-action="clipboard#copy" data-clipboard-text="{{ url('portal_kyc_confirm_token', {token: dto.slugId}) }}">
                            <twig:ux:icon name="tabler:link" class="size-4" aria-hidden="true" />
                            Copier le lien d'upload
                        </twig:Button>
                    {% endif %}

                    {# Archivage : visible pour un admin, et pour un collaborateur si le cabinet le lui a délégué (Réglages → Rôles & permissions). #}
                    {% if not dto.isArchived and workspace_can('archive_folder') %}
                        <form action="{{ path('app_compliance_archive_folder', { slugId: dto.slugId, type: dto.isKyb ? 'business' : 'individual', method: dto.method }) }}"
                              method="POST"
                              onsubmit="return confirm('Archiver ce dossier ? Il passera en lecture seule.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('archive_folder_' ~ dto.slugId) }}">
                            <twig:Button type="submit" variant="ghost" size="sm">
                                <twig:ux:icon name="tabler:archive" class="size-4" aria-hidden="true" />
                                Archiver
                            </twig:Button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </header>

        <div class="mt-12 space-y-14">
            {% if dto.isArchived %}
                <div class="flex gap-3 border-l-2 border-slate-400 pl-4" role="status">
                    <twig:ux:icon name="tabler:archive" class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
                    <p class="text-sm text-slate-600">
                        <span class="font-medium text-slate-900">Dossier archivé.</span>
                        Il est verrouillé en lecture seule pour garantir l'intégrité de la piste d'audit. L'espace de collecte client est désactivé.
                    </p>
                </div>
            {% endif %}

            {% if not dto.isArchived %}
                <twig:ComplianceFolderApprovalComponent folderSlugId="{{ dto.slugId }}" />
            {% endif %}

            {# Refus encore internes : un seul e-mail au client pour toutes les pièces à refournir. #}
            {% if can_review_documents and dto.pendingCorrectionCount > 0 %}
                <div class="flex flex-col gap-5 rounded-2xl border border-slate-200 border-l-2 border-l-amber-400 bg-white p-6 sm:flex-row sm:items-center sm:justify-between" role="status">
                    <div>
                        <p class="text-base font-medium text-slate-900">
                            {{ dto.pendingCorrectionCount }} pièce{{ dto.pendingCorrectionCount > 1 ? 's refusées' : ' refusée' }}, pas encore signalée{{ dto.pendingCorrectionCount > 1 ? 's' : '' }} au client
                        </p>
                        <p class="mt-1 text-sm text-slate-600">Le client recevra un seul e-mail listant les pièces à fournir à nouveau et leurs motifs, avec le lien de dépôt.</p>
                    </div>
                    <form method="post" action="{{ path('app_compliance_request_corrections', { slugId: dto.slugId }) }}" class="shrink-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('request_corrections_' ~ dto.slugId) }}">
                        <twig:Button type="submit" variant="dark" size="sm">
                            <twig:ux:icon name="tabler:mail-forward" class="size-4" aria-hidden="true" /> Demander les corrections au client
                        </twig:Button>
                    </form>
                </div>
            {% endif %}

            {# Les zones `data-ocr-zone` (id stable) sont rafraîchies par Mercure à la fin d'une analyse : mercure_reload_controller.js #}
            {% if dto.isKyb %}

                {# PIÈCES DE LA SOCIÉTÉ (KYB) #}
                <section id="ocr-zone-company" data-ocr-zone aria-labelledby="heading-company-docs">
                    {{ _self.section_heading('heading-company-docs', 'Pièces de la société', dto.companyDocuments) }}

                    {% if dto.companyDocuments is empty %}
                        <p class="rounded-2xl border border-dashed border-slate-300 px-6 py-12 text-center text-sm text-slate-500">
                            Aucun document requis. La liste des documents de l'entreprise s'affichera ici.
                        </p>
                    {% else %}
                        <div class="space-y-5">
                            {% for doc in dto.companyDocuments %}
                                {{ _self.document_card(doc, dto.slugId, can_review_documents, dto.headerTitle) }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                {# INTERVENANTS ET BÉNÉFICIAIRES (KYB) #}
                <section id="ocr-zone-stakeholders" data-ocr-zone aria-labelledby="heading-stakeholders">
                    {{ _self.section_heading('heading-stakeholders', 'Intervenants et bénéficiaires', []) }}

                    <div class="space-y-12">
                        {% for stakeholder in dto.stakeholders %}
                            {# Les documents sont déjà filtrés par le DTO (individualDocuments contient les docs des intervenants) #}
                            {% set stakeholderDocs = dto.individualDocuments|filter(d => d.stakeholderSlug == stakeholder.slugId) %}
                            <div>
                                <div class="flex items-center gap-4">
                                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-medium text-slate-600" aria-hidden="true">
                                        {{ stakeholder.initials|default(stakeholder.fullName|split(' ')|map(n => n|first)|join|upper) }}
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="truncate text-base font-medium text-slate-900">{{ stakeholder.fullName }}</h3>
                                        <p class="text-sm text-slate-500">
                                            {{ stakeholder.roleLabel }} · {{ stakeholder.percentage|default(0) }} %{% if stakeholder.isUbo %} · Bénéficiaire effectif{% endif %}
                                        </p>
                                    </div>
                                </div>

                                <div class="mt-5 space-y-5 sm:pl-14">
                                    {% for doc in stakeholderDocs %}
                                        {{ _self.document_card(doc, dto.slugId, can_review_documents, stakeholder.fullName) }}
                                    {% else %}
                                        <p class="text-sm italic text-slate-500">Aucun document requis pour le moment.</p>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <p class="rounded-2xl border border-dashed border-slate-300 px-6 py-12 text-center text-sm text-slate-500">
                                Aucun intervenant. La liste s'affichera après l'étape précédente.
                            </p>
                        {% endfor %}
                    </div>
                </section>

            {% else %}

                {# PIÈCES D'IDENTITÉ ET JUSTIFICATIFS (KYC) #}
                <section id="ocr-zone-individual" data-ocr-zone aria-labelledby="heading-kyc-docs">
                    {{ _self.section_heading('heading-kyc-docs', 'Pièces d\'identité et justificatifs', dto.individualDocuments) }}

                    {% if dto.individualDocuments is empty %}
                        <p class="rounded-2xl border border-dashed border-slate-300 px-6 py-12 text-center text-sm text-slate-500">Aucun document requis.</p>
                    {% else %}
                        <div class="space-y-5">
                            {% for doc in dto.individualDocuments %}
                                {{ _self.document_card(doc, dto.slugId, can_review_documents, doc.typeLabel) }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                {# ADÉQUATION PRODUIT (lot 3) : vérification d'un produit du catalogue face au profil et à l'EER #}
                <twig:ProductAdequacyCheckComponent folderSlugId="{{ dto.slugId }}" />

                {# RAPPORT D'ADÉQUATION (lot 5) : assemble les vérifications, validation CGP, PDF remis au client #}
                <twig:AdequacyReportComponent folderSlugId="{{ dto.slugId }}" />

            {% endif %}

            {# JOURNAL D'ACTIVITÉ : replié, pour ne pas alourdir la lecture #}
            <section aria-labelledby="heading-journal">
                <details class="group/journal border-t border-slate-200 pt-6">
                    <summary class="flex w-fit cursor-pointer list-none select-none items-center gap-2 rounded-md pr-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                        <twig:ux:icon name="tabler:chevron-right" class="size-4 text-slate-400 transition-transform group-open/journal:rotate-90" aria-hidden="true" />
                        <h2 id="heading-journal" class="font-serif text-2xl tracking-tight text-slate-900">Journal d'activité</h2>
                        <span class="text-sm text-slate-500">{{ dto.history|length }}</span>
                    </summary>

                    <ol class="mt-8 space-y-7 border-l border-slate-200 pl-6">
                        {# Historique formaté par le DTO #}
                        {% for history in dto.history %}
                            <li class="relative">
                                <span class="absolute -left-[29px] top-2 size-2 rounded-full bg-slate-300 ring-4 ring-background-sable" aria-hidden="true"></span>
                                <p class="text-sm font-medium text-slate-900">{{ history.title }}</p>
                                <p class="mt-1 text-sm text-slate-600">{{ history.description }}</p>
                                <p class="mt-1 text-xs text-slate-500">
                                    <span class="sr-only">Date de l'événement :</span>
                                    {{ history.date }}
                                </p>
                            </li>
                        {% else %}
                            <li class="text-sm italic text-slate-500">Aucune activité récente.</li>
                        {% endfor %}
                    </ol>
                </details>
            </section>
        </div>
    </div>
{% endblock %}

{% extends '@website/base.html.twig' %}

{% block title %}Le parcours de conformité des CGP et courtiers{% endblock %}

{% block meta_description %}{{ company_name }} automatise le parcours réglementaire des CGP et courtiers : DER et signature électronique, collecte des pièces, OCR, vérification sanctions/PPE, entretien et rapport validé. Un appui pour votre conformité AMF, ACPR et LCB-FT.{% endblock %}

{% block body %}
    {#
       Étapes du parcours produit — source unique de la section « parcours » ET du récapitulatif « temps gagné ».

       ⚠️ `minutes` : ORDRES DE GRANDEUR INDICATIFS, NON MESURÉS (par dossier, comparés à un traitement manuel).
       À valider / ajuster par le fondateur avant mise en avant commerciale. Le total et les barres du récap
       se recalculent automatiquement.
    #}
    {% set steps = [
        {
            id: 'der',
            icon: 'lucide:pen-line',
            kicker: 'Entrée en relation',
            title: 'Le DER part et revient signé, sans papier.',
            text: 'Vous éditez le Document d’entrée en relation à partir de votre profil réglementaire (ORIAS, association professionnelle, assurance RC Pro), puis votre client le signe électroniquement depuis son téléphone. La preuve de signature est horodatée et archivée au dossier.',
            before: 'Impression, envoi ou scan, relances, classement de l’exemplaire signé.',
            after: 'Un envoi, une signature électronique, un accusé et un archivage automatiques.',
            minutes: 15,
            mock: '@website/home/_mock_der.html.twig',
        },
        {
            id: 'pieces',
            icon: 'lucide:folder-open',
            kicker: 'Collecte des pièces',
            title: 'Vos clients déposent leurs pièces au bon endroit.',
            text: 'Chaque client dispose d’un espace client sécurisé, accessible par lien magique : pas de mot de passe à retenir. Il voit la liste des pièces attendues et les dépose directement dans son dossier.',
            before: 'Pièces dispersées dans des e-mails, relances une à une, fichiers à renommer.',
            after: 'Une liste claire, des dépôts rattachés au dossier, des relances ciblées sur ce qui manque.',
            minutes: 20,
            mock: '@website/home/_mock_pieces.html.twig',
        },
        {
            id: 'ocr',
            icon: 'lucide:scan-text',
            kicker: 'Lecture des pièces',
            title: 'Les informations sont lues, vous les contrôlez.',
            text: 'L’OCR extrait les informations des pièces d’identité et des justificatifs, puis les propose pré-remplies. Vous relisez, corrigez si besoin et validez : rien n’est figé sans votre contrôle.',
            before: 'Ressaisie manuelle de chaque champ, avec le risque de faute de frappe.',
            after: 'Des champs pré-remplis à vérifier plutôt qu’à retaper.',
            minutes: 10,
            mock: '@website/home/_mock_ocr.html.twig',
        },
        {
            id: 'sanctions',
            icon: 'lucide:shield-check',
            kicker: 'Sanctions et PPE',
            title: 'La vérification LCB-FT est faite, datée et conservée.',
            text: 'Votre client est confronté aux listes de sanctions et aux personnes politiquement exposées. Le résultat est daté et rattaché au dossier ; en cas de correspondance, c’est à vous d’apprécier la suite.',
            before: 'Recherches manuelles sur plusieurs sites, captures d’écran pour garder une trace.',
            after: 'Une vérification, un résultat daté au dossier, une alerte seulement quand elle se justifie.',
            minutes: 10,
            mock: '@website/home/_mock_sanctions.html.twig',
        },
        {
            id: 'entretien',
            icon: 'lucide:mic',
            kicker: 'Entretien et rapport',
            title: 'L’entretien devient un rapport que vous validez.',
            text: 'Avec l’accord de votre client, l’entretien est enregistré. Une synthèse est proposée par l’IA ; vous la relisez, la corrigez et la validez. Le rapport est alors figé et daté, et sa révocation éventuelle est tracée.',
            before: 'Prise de notes pendant l’entretien, puis rédaction du compte rendu après coup.',
            after: 'Une synthèse structurée à relire : l’IA propose, le conseiller décide.',
            minutes: 45,
            mock: '@website/home/_mock_entretien.html.twig',
        },
    ] %}
    {% set total_minutes = steps|map(s => s.minutes)|reduce((carry, m) => carry + m, 0) %}
    {% set max_minutes = max(steps|map(s => s.minutes)) %}
    {% set manifesto = 'Chaque dossier client suit le même chemin réglementaire. Aujourd’hui, vous le parcourez à la main : imprimer, relancer, ressaisir, rechercher, rédiger. ' ~ company_name ~ ' automatise ce qui est mécanique, et vous laisse ce qui engage votre responsabilité : conseiller et décider.' %}
    {% set manifesto_words = manifesto|split(' ') %}

    <div class="bg-white text-slate-900 selection:bg-blue-100" data-controller="reveal">

        {% include '@website/_header.html.twig' %}

        {# ==========================================
           1. HERO — plein écran, texte qui s'efface, maquette qui se redresse
           ========================================== #}
        <section aria-labelledby="hero-heading"
                 class="relative isolate overflow-hidden"
                 data-controller="scroll-progress"
                 data-scroll-progress-mode-value="exit">

            <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] bg-gradient-to-b from-slate-50 to-white" aria-hidden="true">
                <div class="absolute left-1/2 top-10 h-[360px] w-[720px] -translate-x-1/2 rounded-full bg-blue-100/50 blur-3xl"></div>
            </div>

            <div class="mx-auto flex min-h-[calc(100svh-60px)] max-w-6xl flex-col items-center justify-center px-5 pb-12 pt-16 text-center sm:px-6">
                <div class="hero-copy">
                    <p class="hero-enter text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">
                        Pour les CGP et les courtiers
                    </p>
                    <h1 id="hero-heading"
                        class="hero-enter mx-auto mt-5 max-w-4xl text-balance text-[44px] font-semibold leading-[1.04] tracking-[-0.035em] text-slate-900 sm:text-6xl lg:text-[84px]"
                        style="--reveal-delay: 80ms">
                        Conseillez.<br>{{ company_name }} documente.
                    </h1>
                    <p class="hero-enter mx-auto mt-6 max-w-2xl text-balance text-lg leading-relaxed text-slate-600 sm:text-xl"
                       style="--reveal-delay: 180ms">
                        Du premier contact au rapport signé, {{ company_name }} automatise le parcours réglementaire de vos clients : DER, pièces, KYC, LCB-FT, entretien.
                    </p>
                    <div class="hero-enter mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--reveal-delay: 280ms">
                        <twig:Button as="a" href="{{ path('app_register') }}" variant="dark" class="h-12 w-full rounded-full px-8 text-base sm:w-auto">
                            Essayer gratuitement
                        </twig:Button>
                        <twig:Button as="a" href="#parcours" variant="ghost" class="h-12 w-full rounded-full px-6 text-base text-slate-700 sm:w-auto">
                            Découvrir le parcours
                            {{ ux_icon('lucide:arrow-down', { class: 'size-4', 'aria-hidden': 'true' }) }}
                        </twig:Button>
                    </div>
                    <p class="hero-enter mt-4 text-[13px] text-slate-600" style="--reveal-delay: 340ms">Aucune carte bancaire requise.</p>
                </div>

                {# Maquette décorative : aperçu d'un dossier traversant les 5 étapes #}
                <div class="hero-enter mt-14 w-full max-w-5xl" style="--reveal-delay: 420ms">
                  <div class="hero-mock"
                       data-controller="scroll-progress"
                       data-scroll-progress-start-value="1.1"
                       data-scroll-progress-end-value="0.6">
                    <div class="rounded-[2rem] border border-slate-200 bg-white shadow-2xl shadow-slate-900/10" aria-hidden="true">
                        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                            <div class="flex items-center gap-1.5">
                                <span class="size-2.5 rounded-full bg-slate-200"></span>
                                <span class="size-2.5 rounded-full bg-slate-200"></span>
                                <span class="size-2.5 rounded-full bg-slate-200"></span>
                            </div>
                            <p class="text-[13px] font-semibold text-slate-900">Dossier · Camille Martin</p>
                            <span class="rounded-full border border-slate-200 px-2.5 py-1 text-[11px] text-slate-600">Exemple illustratif</span>
                        </div>
                        <div class="grid grid-cols-1 gap-3 p-5 sm:grid-cols-5">
                            {% for s in steps %}
                                {% set pending = loop.last %}
                                <div class="rounded-2xl border border-l-4 border-slate-200 bg-white p-4 text-left {{ pending ? 'border-l-amber-500' : 'border-l-emerald-500' }}">
                                    {{ ux_icon(s.icon, { class: 'size-5 text-slate-600' }) }}
                                    <p class="mt-3 text-[13px] font-semibold leading-snug text-slate-900">{{ s.kicker }}</p>
                                    <p class="mt-1 text-[12px] font-medium {{ pending ? 'text-amber-700' : 'text-emerald-700' }}">
                                        {{ pending ? 'À valider' : 'Terminé' }}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                  </div>
                </div>
            </div>
        </section>

        {# ==========================================
           2. MANIFESTE — le texte s'éclaire mot à mot au scroll
           ========================================== #}
        <section aria-labelledby="manifeste-heading" class="bg-slate-50">
            <h2 id="manifeste-heading" class="sr-only">Pourquoi {{ company_name }}</h2>
            <div class="mx-auto flex min-h-[100svh] max-w-5xl items-center px-5 py-24 sm:px-6">
                <p class="word-reveal text-[28px] font-semibold leading-[1.18] tracking-[-0.025em] text-slate-900 sm:text-5xl lg:text-6xl"
                   style="--n: {{ manifesto_words|length }}"
                   data-controller="scroll-progress"
                   data-scroll-progress-start-value="0.9"
                   data-scroll-progress-end-value="0.35">
                    {% for word in manifesto_words %}<span style="--i: {{ loop.index0 }}">{{ word }}</span> {% endfor %}
                </p>
            </div>
        </section>

        {# ==========================================
           3. PARCOURS — étapes qui défilent, maquette collante (≥ lg)
           ========================================== #}
        <section id="parcours" aria-labelledby="parcours-heading" class="scroll-mt-16 bg-white">
            <div class="mx-auto max-w-6xl px-5 pb-8 pt-24 sm:px-6 lg:pt-32">
                <header class="mx-auto max-w-3xl text-center">
                    <p class="reveal text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">Le parcours</p>
                    <h2 id="parcours-heading" class="reveal mt-4 text-balance text-4xl font-semibold tracking-[-0.03em] sm:text-6xl" style="--reveal-delay: 80ms">
                        Cinq étapes. Une seule plateforme.
                    </h2>
                    <p class="reveal mt-5 text-lg leading-relaxed text-slate-600 sm:text-xl" style="--reveal-delay: 160ms">
                        Voici ce que devient chaque dossier, et ce que vous récupérez à chaque étape.
                    </p>
                </header>
            </div>

            <div class="mx-auto max-w-6xl px-5 sm:px-6" data-controller="scroll-story">
                <div class="grid lg:grid-cols-2 lg:gap-20">

                    {# Colonne texte : une étape = un écran #}
                    <ol class="list-none">
                        {% for s in steps %}
                            <li class="story-step flex items-center border-t border-slate-100 py-16 first:border-t-0 lg:min-h-[85svh] lg:border-t-0 lg:py-10"
                                data-scroll-story-target="step"
                                {{ loop.first ? 'data-active' : '' }}>
                                <article class="w-full" aria-labelledby="etape-{{ s.id }}">
                                    <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">
                                        Étape {{ loop.index }} sur {{ loop.length }} · {{ s.kicker }}
                                    </p>
                                    <h3 id="etape-{{ s.id }}" class="mt-4 text-balance text-3xl font-semibold leading-[1.1] tracking-[-0.025em] sm:text-4xl">
                                        {{ s.title }}
                                    </h3>
                                    <p class="mt-5 text-lg leading-relaxed text-slate-600">{{ s.text }}</p>

                                    {# Maquette en ligne sur mobile (la version collante est réservée aux grands écrans) #}
                                    <div class="mt-8 flex justify-center rounded-3xl bg-slate-50 p-4 sm:p-8 lg:hidden">
                                        {% include s.mock %}
                                    </div>

                                    <dl class="mt-8 grid gap-3 sm:grid-cols-2">
                                        <div class="rounded-2xl border border-slate-200 bg-white p-4">
                                            <dt class="text-[12px] font-semibold uppercase tracking-wider text-slate-600">Sans {{ company_name }}</dt>
                                            <dd class="mt-2 text-[14px] leading-relaxed text-slate-900">{{ s.before }}</dd>
                                        </div>
                                        <div class="rounded-2xl border border-l-4 border-slate-200 border-l-emerald-500 bg-white p-4">
                                            <dt class="text-[12px] font-semibold uppercase tracking-wider text-slate-600">Avec {{ company_name }}</dt>
                                            <dd class="mt-2 text-[14px] leading-relaxed text-slate-900">{{ s.after }}</dd>
                                        </div>
                                    </dl>

                                    <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-[14px] text-slate-900">
                                        {{ ux_icon('lucide:clock', { class: 'size-4 text-slate-600', 'aria-hidden': 'true' }) }}
                                        <span>Temps gagné&nbsp;: <strong class="font-semibold tabular-nums">≈ {{ s.minutes }}&nbsp;min</strong> par dossier*</span>
                                    </p>
                                </article>
                            </li>
                        {% endfor %}
                    </ol>

                    {# Colonne collante : la maquette de l'étape active (décorative) #}
                    <div class="relative hidden lg:block" aria-hidden="true">
                        <div class="sticky top-28 h-[min(560px,calc(100svh-9rem))]">
                            <div class="absolute inset-0 rounded-[2.5rem] border border-slate-200 bg-slate-50"></div>
                            {% for s in steps %}
                                <div class="story-panel flex items-center justify-center p-8"
                                     data-scroll-story-target="panel"
                                     {{ loop.first ? 'data-active' : '' }}>
                                    {% include s.mock %}
                                </div>
                            {% endfor %}
                            <div class="absolute right-5 top-1/2 flex -translate-y-1/2 flex-col gap-2">
                                {% for s in steps %}
                                    <span class="block h-1.5 w-1.5 rounded-full bg-slate-300 transition-all duration-300 data-active:h-6 data-active:bg-blue-600"
                                          data-scroll-story-target="dot"
                                          {{ loop.first ? 'data-active' : '' }}></span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ==========================================
           4. TEMPS GAGNÉ — récapitulatif honnête, barres proportionnelles
           ========================================== #}
        <section id="temps-gagne" aria-labelledby="temps-heading" class="scroll-mt-16 bg-slate-50">
            <div class="mx-auto flex min-h-[100svh] max-w-5xl flex-col justify-center px-5 py-24 sm:px-6">
                <header class="text-center">
                    <p class="reveal text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">Le temps gagné</p>
                    <h2 id="temps-heading" class="reveal mt-4 text-balance text-4xl font-semibold tracking-[-0.03em] sm:text-6xl" style="--reveal-delay: 80ms">
                        Le temps qui revient au conseil.
                    </h2>
                    <p class="reveal mt-8 text-[64px] font-semibold leading-none tracking-[-0.045em] tabular-nums text-slate-900 sm:text-[120px]" style="--reveal-delay: 160ms">
                        ≈&nbsp;{{ total_minutes // 60 }}&nbsp;h&nbsp;{{ '%02d'|format(total_minutes % 60) }}*
                    </p>
                    <p class="reveal mx-auto mt-4 max-w-xl text-lg text-slate-600" style="--reveal-delay: 220ms">
                        de tâches manuelles en moins pour un dossier complet, de la signature du DER au rapport validé.
                    </p>
                </header>

                <ul class="mx-auto mt-14 w-full max-w-3xl space-y-5">
                    {% for s in steps %}
                        <li class="reveal" style="--reveal-delay: {{ loop.index0 * 90 }}ms">
                            <div class="flex items-baseline justify-between gap-4 text-[15px]">
                                <span class="flex items-center gap-2 font-medium text-slate-900">
                                    {{ ux_icon(s.icon, { class: 'size-4 text-slate-600', 'aria-hidden': 'true' }) }}
                                    {{ s.kicker }}
                                </span>
                                <span class="tabular-nums text-slate-600">≈&nbsp;{{ s.minutes }}&nbsp;min</span>
                            </div>
                            <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200" aria-hidden="true">
                                <div class="bar-grow h-full rounded-full bg-slate-900" style="--w: {{ (s.minutes / max_minutes * 100)|round }}%"></div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                {# TODO fondateur : valider ces ordres de grandeur avant diffusion large (cf. commentaire en tête de fichier). #}
                <p class="reveal mx-auto mt-10 max-w-3xl text-center text-[13px] leading-relaxed text-slate-600">
                    * Estimations indicatives, par dossier, comparées à un traitement manuel. Elles varient selon votre cabinet, le type de client et la complexité du dossier.
                </p>
            </div>
        </section>

        {# ==========================================
           5. CONFIANCE — traçabilité, décision humaine, accès maîtrisé
           ========================================== #}
        <section id="confiance" aria-labelledby="confiance-heading" class="scroll-mt-16 bg-white">
            <div class="mx-auto max-w-6xl px-5 py-24 sm:px-6 lg:py-32">
                <header class="mx-auto max-w-3xl text-center">
                    <p class="reveal text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">Conformité</p>
                    <h2 id="confiance-heading" class="reveal mt-4 text-balance text-4xl font-semibold tracking-[-0.03em] sm:text-6xl" style="--reveal-delay: 80ms">
                        Une conformité que vous pouvez défendre.
                    </h2>
                    <p class="reveal mt-5 text-lg leading-relaxed text-slate-600 sm:text-xl" style="--reveal-delay: 160ms">
                        Conçu avec un conseiller en gestion de patrimoine, pour les situations réelles d’un cabinet.
                    </p>
                </header>

                <div class="mt-16 grid gap-5 md:grid-cols-3">
                    <article class="reveal rounded-3xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-7">
                        {{ ux_icon('lucide:history', { class: 'size-6 text-slate-600', 'aria-hidden': 'true' }) }}
                        <h3 class="mt-5 text-xl font-semibold tracking-tight">Une piste d’audit horodatée</h3>
                        <p class="mt-3 text-[15px] leading-relaxed text-slate-600">
                            Signature, validation d’un dossier, validation ou révocation d’un rapport : chaque action qui produit un effet juridique est journalisée.
                        </p>
                    </article>
                    <article class="reveal rounded-3xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-7" style="--reveal-delay: 100ms">
                        {{ ux_icon('lucide:badge-check', { class: 'size-6 text-slate-600', 'aria-hidden': 'true' }) }}
                        <h3 class="mt-5 text-xl font-semibold tracking-tight">Vous restez décisionnaire</h3>
                        <p class="mt-3 text-[15px] leading-relaxed text-slate-600">
                            L’OCR et l’IA proposent, vous relisez et vous validez. Un rapport validé est figé : il ne peut plus être modifié en silence.
                        </p>
                    </article>
                    <article class="reveal rounded-3xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-7" style="--reveal-delay: 200ms">
                        {{ ux_icon('lucide:key-round', { class: 'size-6 text-slate-600', 'aria-hidden': 'true' }) }}
                        <h3 class="mt-5 text-xl font-semibold tracking-tight">Des accès maîtrisés</h3>
                        <p class="mt-3 text-[15px] leading-relaxed text-slate-600">
                            Connexion par lien magique à usage unique, sans mot de passe à stocker ni à oublier, pour vos clients comme pour votre équipe.
                        </p>
                    </article>
                </div>

                <p class="reveal mx-auto mt-10 max-w-3xl text-center text-[13px] leading-relaxed text-slate-600">
                    {{ company_name }} vous aide à structurer et à documenter vos obligations (KYC, LCB-FT) au regard des attentes de l’AMF et de l’ACPR. Ces autorités ne certifient pas les logiciels : vous demeurez responsable de vos décisions de conformité.
                </p>
            </div>
        </section>

        {# ==========================================
           6. ESPACE CLIENT — accès visible pour les clients des cabinets
           ========================================== #}
        <section aria-labelledby="client-heading" class="bg-slate-50">
            <div class="mx-auto max-w-5xl px-5 py-20 sm:px-6">
                <div class="reveal flex flex-col items-start justify-between gap-6 rounded-3xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-8 sm:flex-row sm:items-center">
                    <div class="flex items-start gap-4">
                        {{ ux_icon('lucide:lock', { class: 'mt-1 size-6 shrink-0 text-slate-600', 'aria-hidden': 'true' }) }}
                        <div>
                            <h2 id="client-heading" class="text-2xl font-semibold tracking-tight">Vous êtes client d’un cabinet&nbsp;?</h2>
                            <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-slate-600">
                                Retrouvez votre espace sécurisé pour déposer vos pièces, signer vos documents et suivre votre dossier. Aucun mot de passe : un lien de connexion vous est envoyé par e-mail.
                            </p>
                        </div>
                    </div>
                    <twig:Button as="a" href="{{ path('website_client_access') }}" variant="outline" class="h-11 shrink-0 rounded-full px-6 text-[15px]">
                        Accéder à mon espace client
                        {{ ux_icon('lucide:arrow-right', { class: 'size-4', 'aria-hidden': 'true' }) }}
                    </twig:Button>
                </div>
            </div>
        </section>

        {# ==========================================
           7. TARIFS — abonnement au siège, dossiers illimités, minutes d'entretien métrées.
           Montants issus de la base (PricingPlan) via GetPublicPricingUseCase, repli sur les prix de lancement.
           ========================================== #}
        <section id="tarifs" aria-labelledby="tarifs-heading" class="scroll-mt-16 bg-white">
            <div class="mx-auto max-w-6xl px-5 py-24 sm:px-6 lg:py-32">
                <header class="mx-auto max-w-3xl text-center">
                    <p class="reveal text-[13px] font-semibold uppercase tracking-[0.14em] text-blue-700">Tarifs</p>
                    <h2 id="tarifs-heading" class="reveal mt-4 text-balance text-4xl font-semibold tracking-[-0.03em] sm:text-6xl" style="--reveal-delay: 80ms">
                        Un abonnement au siège. Des dossiers sans compteur.
                    </h2>
                    <p class="reveal mt-5 text-lg leading-relaxed text-slate-600" style="--reveal-delay: 160ms">
                        Vos dossiers de conformité ne sont pas comptés (usage raisonnable). Seules les minutes d’entretien enregistrées sont mesurées : une dotation est incluse, et des packs permettent d’en ajouter.
                    </p>
                </header>

                <div class="mt-16 grid items-stretch gap-5 md:grid-cols-3">

                    {# Essai #}
                    <article class="reveal flex flex-col rounded-3xl border border-slate-200 bg-white p-8">
                        <div class="flex items-center gap-3">
                            {{ ux_icon('lucide:sparkles', { class: 'size-5 text-slate-600', 'aria-hidden': 'true' }) }}
                            <h3 class="text-xl font-semibold tracking-tight">Essai gratuit</h3>
                        </div>
                        <p class="mt-4 text-[15px] leading-relaxed text-slate-600">Pour parcourir le produit sur de vrais dossiers avant de vous engager.</p>
                        <p class="mt-6 text-4xl font-semibold tracking-tight tabular-nums">{{ pricing.trialDossiers }} dossiers</p>
                        <p class="mt-1 text-[14px] text-slate-600">+ {{ pricing.trialMeetingMinutes }}&nbsp;min d’entretien offertes</p>
                        <ul class="mt-6 space-y-3 text-[14px] text-slate-600">
                            <li class="flex items-start gap-2">{{ ux_icon('lucide:circle-check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-600', 'aria-hidden': 'true' }) }}Toutes les étapes du parcours</li>
                            <li class="flex items-start gap-2">{{ ux_icon('lucide:circle-check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-600', 'aria-hidden': 'true' }) }}Aucune carte bancaire requise</li>
                        </ul>
                    </article>

                    {# Abonnements au siège (1 carte par offre) #}
                    {% for plan in pricing.seatPlans %}
                        {% set is_cabinet = plan.minSeats > 1 %}
                        <article class="reveal flex flex-col rounded-3xl border bg-white p-8 {{ is_cabinet ? 'border-slate-200' : 'border-2 border-blue-600 shadow-lg shadow-blue-900/5' }}" style="--reveal-delay: {{ loop.index * 100 }}ms">
                            <div class="flex items-center gap-3">
                                {{ ux_icon(is_cabinet ? 'lucide:users' : 'lucide:user', { class: 'size-5 text-slate-600', 'aria-hidden': 'true' }) }}
                                <h3 class="text-xl font-semibold tracking-tight">{{ plan.label }}</h3>
                            </div>
                            <p class="mt-4 text-[15px] leading-relaxed text-slate-600">
                                {{ is_cabinet ? 'Pour les cabinets : plusieurs conseillers, un même espace de travail et un portefeuille partagé.' : 'Pour le conseiller qui exerce seul : tout le parcours, un seul siège.' }}
                            </p>
                            <p class="mt-6 flex items-baseline gap-1">
                                <span class="text-4xl font-semibold tracking-tight tabular-nums">{{ plan.formattedAmount }}&nbsp;€</span>
                                <span class="text-[14px] text-slate-600">/ siège / mois</span>
                            </p>
                            <ul class="mt-6 space-y-3 text-[14px] text-slate-600">
                                <li class="flex items-start gap-2">{{ ux_icon('lucide:circle-check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-600', 'aria-hidden': 'true' }) }}Dossiers de conformité illimités (usage raisonnable)</li>
                                <li class="flex items-start gap-2">{{ ux_icon('lucide:circle-check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-600', 'aria-hidden': 'true' }) }}{{ plan.minutes }}&nbsp;min d’entretien incluses par siège et par mois</li>
                                <li class="flex items-start gap-2">{{ ux_icon('lucide:circle-check', { class: 'mt-0.5 size-4 shrink-0 text-emerald-600', 'aria-hidden': 'true' }) }}{{ is_cabinet ? 'À partir de ' ~ plan.minSeats ~ ' sièges, collaborateurs invitables' : 'Un siège' }}</li>
                            </ul>
                        </article>
                    {% endfor %}
                </div>

                {# Packs de minutes #}
                <div class="reveal mt-10 rounded-3xl border border-l-4 border-slate-200 border-l-blue-600 bg-white p-8">
                    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                        <div class="max-w-xl">
                            <h3 class="text-xl font-semibold tracking-tight">Besoin de plus de minutes d’entretien&nbsp;?</h3>
                            <p class="mt-2 text-[14px] leading-relaxed text-slate-600">
                                Packs prépayés, paiement unique, sans expiration. Si le solde est épuisé, l’enregistrement d’un nouvel entretien est suspendu : aucun dépassement n’est facturé automatiquement.
                            </p>
                        </div>
                        <ul class="grid grid-cols-3 gap-3 sm:min-w-[420px]">
                            {% for pack in pricing.minutePacks %}
                                <li class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-center">
                                    <p class="text-[13px] text-slate-600 tabular-nums">{{ pack.minutes }}&nbsp;min</p>
                                    <p class="mt-1 text-xl font-semibold tabular-nums text-slate-900">{{ pack.formattedAmount }}&nbsp;€</p>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <p class="reveal mx-auto mt-8 max-w-3xl text-center text-[13px] leading-relaxed text-slate-600">
                    Paiement sécurisé par Stripe. Facturation et changement d’offre depuis votre espace.
                </p>
            </div>
        </section>

        {# ==========================================
           8. CTA FINAL
           ========================================== #}
        <section aria-labelledby="cta-final-heading" class="bg-slate-50">
            <div class="mx-auto flex min-h-[80svh] max-w-3xl flex-col items-center justify-center px-5 py-24 text-center sm:px-6">
                <h2 id="cta-final-heading" class="reveal text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.035em] sm:text-7xl">
                    Moins de saisie.<br>Plus de conseil.
                </h2>
                <p class="reveal mt-6 text-lg leading-relaxed text-slate-600 sm:text-xl" style="--reveal-delay: 100ms">
                    Créez votre compte, renseignez votre profil réglementaire et lancez votre premier dossier.
                </p>
                <div class="reveal mt-9 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row" style="--reveal-delay: 200ms">
                    <twig:Button as="a" href="{{ path('app_register') }}" variant="dark" class="h-12 w-full rounded-full px-8 text-base sm:w-auto">
                        Essayer gratuitement
                    </twig:Button>
                    <twig:Button as="a" href="mailto:sales@kysure.fr" variant="outline" class="h-12 w-full rounded-full px-8 text-base sm:w-auto">
                        Parler à un expert
                    </twig:Button>
                </div>
                <p class="reveal mt-5 text-[13px] text-slate-600" style="--reveal-delay: 260ms">
                    Aucune carte bancaire requise · Déjà client d’un cabinet ?
                    <a href="{{ path('website_client_access') }}" class="font-medium text-slate-900 underline underline-offset-4 hover:text-blue-700 focus-visible:rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40">Accédez à votre espace client</a>
                </p>
            </div>
        </section>

        {% include '@website/_footer.html.twig' %}

    </div>
{% endblock %}

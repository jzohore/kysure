<div {{ attributes }} class="space-y-4">
    {% set items = this.supportThreads %}

    {# --- BARRE DE FILTRES --- #}
    <div class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
        <div class="flex flex-wrap items-center gap-2">
            <div class="relative w-full sm:w-64">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <twig:ux:icon name="tabler:search" class="size-4 text-slate-400" />
                </span>
                <input type="search"
                       aria-label="Rechercher un ticket"
                       placeholder="Sujet, catégorie, email..."
                       data-model="query"
                       value="{{ query }}"
                       class="block w-full rounded-lg border border-slate-200 py-1.5 pl-9 pr-3 text-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
            </div>

            <select data-model="statusFilter" aria-label="Filtrer par statut"
                    class="rounded-lg border border-slate-200 py-1.5 pl-2 pr-7 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                <option value="">Tous les statuts</option>
                {% for status in this.availableStatuses %}
                    <option value="{{ status.value }}" {% if this.statusFilter == status %}selected{% endif %}>{{ status.label }}</option>
                {% endfor %}
            </select>

            <select data-model="categoryFilter" aria-label="Filtrer par catégorie"
                    class="rounded-lg border border-slate-200 py-1.5 pl-2 pr-7 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                <option value="">Toutes catégories</option>
                {% for category in this.availableCategories %}
                    <option value="{{ category.value }}" {% if this.categoryFilter == category.value %}selected{% endif %}>{{ category.getTitle }}</option>
                {% endfor %}
            </select>

            <input type="date" data-model="fromDate" value="{{ fromDate }}" aria-label="Depuis le"
                   class="rounded-lg border border-slate-200 py-1.5 px-2 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
            <span class="text-xs text-slate-400">→</span>
            <input type="date" data-model="toDate" value="{{ toDate }}" aria-label="Jusqu'au"
                   class="rounded-lg border border-slate-200 py-1.5 px-2 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">

            <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer ml-1">
                <input type="checkbox" data-model="assignedToMeOnly" {% if this.assignedToMeOnly %}checked{% endif %}
                       class="rounded border-slate-300 text-slate-900 focus:ring-slate-900">
                Mes tickets
            </label>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3">
            <span class="text-xs text-slate-500"><span class="font-semibold text-slate-900">{{ items.nbResults }}</span> ticket(s)</span>

            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400">Trier par</span>
                <select data-model="sortBy" aria-label="Trier par"
                        class="rounded-lg border border-slate-200 py-1.5 pl-2 pr-7 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                    <option value="priority" {% if this.sortBy == 'priority' %}selected{% endif %}>Priorité</option>
                    <option value="updatedAt" {% if this.sortBy == 'updatedAt' %}selected{% endif %}>Dernière activité</option>
                    <option value="createdAt" {% if this.sortBy == 'createdAt' %}selected{% endif %}>Date de création</option>
                </select>
                <select data-model="sortDir" aria-label="Ordre de tri"
                        class="rounded-lg border border-slate-200 py-1.5 pl-2 pr-7 text-xs text-slate-700 focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 cursor-pointer">
                    <option value="DESC" {% if this.sortDir == 'DESC' %}selected{% endif %}>Décroissant</option>
                    <option value="ASC" {% if this.sortDir == 'ASC' %}selected{% endif %}>Croissant</option>
                </select>
            </div>
        </div>
    </div>

    {# --- TABLEAU / ÉTAT VIDE --- #}
    {% if items is empty %}
        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50/50 py-14 text-center">
            <p class="text-sm font-medium text-slate-900">Aucun ticket de support</p>
            <p class="mt-1 text-sm text-slate-500">
                {% if query %}
                    Aucun ticket ne correspond à votre recherche « {{ query }} ».
                {% else %}
                    La boîte de réception est vide.
                {% endif %}
            </p>
        </div>
    {% else %}
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
                            <th scope="col" class="px-4 py-3">Client / Workspace</th>
                            <th scope="col" class="px-4 py-3">Sujet</th>
                            <th scope="col" class="px-4 py-3">Catégorie</th>
                            <th scope="col" class="px-4 py-3">Priorité</th>
                            <th scope="col" class="px-4 py-3">Assigné à</th>
                            <th scope="col" class="px-4 py-3">Statut</th>
                            <th scope="col" class="px-4 py-3 text-right"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                        {% for thread in items %}
                            <tr class="hover:bg-slate-50/80">
                                <td class="px-4 py-3">
                                    <p class="font-medium text-slate-900">{{ thread.workspace.name }}</p>
                                    <p class="text-xs text-slate-500">{{ thread.user.firstName }} {{ thread.user.lastName|default('')|slice(0, 1) }}.</p>
                                </td>
                                <td class="px-4 py-3 max-w-[16rem] truncate">{{ thread.topic }}</td>
                                <td class="px-4 py-3 text-xs text-slate-600">{{ thread.getCategoryTitle }}</td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center rounded px-2 py-0.5 text-[11px] font-bold {{ thread.priority.badgeClasses }}">
                                        {{ thread.priority.label }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-xs">
                                    {% if thread.assignedTo %}
                                        <span class="text-slate-700">{{ thread.assignedTo.firstName }} {{ thread.assignedTo.lastName }}</span>
                                    {% else %}
                                        <span class="text-slate-400 italic">Non assigné</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center rounded px-2 py-0.5 text-[11px] font-bold {{ thread.status.badgeClasses }}">
                                        {{ thread.status.label }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <twig:Button as="a" href="{{ path('admin_support_show', {slugId: thread.slugId}) }}"
                                                 variant="ghost" size="sm"
                                                 class="text-slate-500 hover:text-slate-900">
                                        Ouvrir
                                        <twig:ux:icon name="tabler:arrow-right" class="ml-1 size-3.5" aria-hidden="true" />
                                    </twig:Button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# --- PAGINATION --- #}
            <div class="flex items-center justify-between border-t border-slate-200 bg-slate-50/50 px-4 py-3">
                <p class="text-xs text-slate-500">
                    Page <span class="font-semibold text-slate-900">{{ items.currentPage }}</span> / {{ items.nbPages }}
                </p>
                <div class="flex items-center gap-2">
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="previousPage"
                            class="inline-flex items-center rounded-lg border border-slate-200 px-2 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"
                            {% if not items.hasPreviousPage %}disabled{% endif %}>
                        <twig:ux:icon name="tabler:chevron-left" class="size-3.5" aria-hidden="true" />
                        <span class="sr-only">Précédent</span>
                    </button>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="nextPage"
                            class="inline-flex items-center rounded-lg border border-slate-200 px-2 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"
                            {% if not items.hasNextPage %}disabled{% endif %}>
                        <twig:ux:icon name="tabler:chevron-right" class="size-3.5" aria-hidden="true" />
                        <span class="sr-only">Suivant</span>
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>

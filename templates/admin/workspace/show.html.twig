{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Separator />
    <twig:Breadcrumb:Item>
        <twig:Breadcrumb:Link href="{{ path('admin_organizations_list') }}" class="text-xs">
            Workspaces & clients
        </twig:Breadcrumb:Link>
    </twig:Breadcrumb:Item>
{% endblock %}

{% block content %}
    <div class="max-w-5xl mx-auto space-y-6">

        {# ========================================================= #}
        {# HEADER                                                     #}
        {# ========================================================= #}
        <header>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-xl font-semibold tracking-tight text-slate-900">{{ workspace.name }}</h1>

                {% if workspace.isActive %}
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">
                        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Actif
                    </span>
                {% else %}
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-rose-50 text-rose-700">
                        <span class="size-1.5 rounded-full bg-rose-500" aria-hidden="true"></span> Suspendu
                    </span>
                {% endif %}

                {% if workspace.subscriptionStatus == 'active' %}
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded text-[10px] font-semibold uppercase tracking-wider">
                        {{ workspace.subscriptionPlan|default('SaaS') }}
                    </span>
                {% endif %}
            </div>
            <p class="text-xs text-slate-500 mt-1">
                {{ workspace.legalName|default('-') }} &middot; <span class="font-mono">{{ workspace.slugId }}</span>
            </p>
        </header>

        {# ========================================================= #}
        {# BANDE D'ACTIVITÉ (chiffres clés, à plat)                   #}
        {# ========================================================= #}
        <div class="flex flex-wrap divide-x divide-slate-200 border border-slate-200 rounded-xl bg-white overflow-hidden">
            <div class="flex-1 min-w-[calc(50%-1px)] sm:min-w-0 px-5 py-4">
                <div class="text-xs text-slate-500">Dossiers KYC</div>
                <div class="text-xl font-semibold text-slate-900 mt-1">{{ workspace.foldersCount }}</div>
            </div>
            <div class="flex-1 min-w-[calc(50%-1px)] sm:min-w-0 px-5 py-4">
                <div class="text-xs text-slate-500">Clients finaux</div>
                <div class="text-xl font-semibold text-slate-900 mt-1">{{ workspace.clientsCount }}</div>
            </div>
            <div class="flex-1 min-w-[calc(50%-1px)] sm:min-w-0 px-5 py-4">
                <div class="text-xs text-slate-500">Membres équipe</div>
                <div class="text-xl font-semibold text-slate-900 mt-1">{{ workspace.membersCount }}</div>
            </div>
            <div class="flex-1 min-w-[calc(50%-1px)] sm:min-w-0 px-5 py-4">
                <div class="text-xs text-slate-500">Tickets ouverts</div>
                <div class="text-xl font-semibold mt-1 {{ workspace.openTicketsCount > 0 ? 'text-amber-600' : 'text-slate-900' }}">
                    {{ workspace.openTicketsCount }}
                </div>
            </div>
        </div>

        {# ========================================================= #}
        {# PANNEAU DE GESTION : sections titre + trait + colonnes     #}
        {# ========================================================= #}
        <div class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-200">

            {# --- CONNEXION SUPPORT (IMPERSONATE) --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Connexion support</h2>
                <div class="pt-4 flex items-center justify-between gap-4">
                    <p class="text-sm text-slate-600">
                        Se connecter à la place d'un membre du cabinet pour l'assister. Motif obligatoire, tracé dans le journal d'audit du cabinet.
                    </p>
                    <a href="{{ path('admin_workspace_impersonate', workspace.ownerEmail ? {slugId: workspace.slugId, email: workspace.ownerEmail} : {slugId: workspace.slugId}) }}"
                       class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 text-xs font-medium text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">
                        <twig:ux:icon name="tabler:spy" class="size-4" aria-hidden="true" />
                        Impersonate
                    </a>
                </div>
            </section>

            {# --- STATUT DU COMPTE --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Statut du compte</h2>
                <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        {% if workspace.isActive %}
                            <p class="text-sm text-slate-600">
                                La suspension bloque l'accès des collaborateurs et interrompt la collecte des pièces justificatives KYC.
                            </p>
                        {% else %}
                            <p class="text-sm text-rose-700" role="alert">
                                Suspendu le {{ workspace.suspendedAt ? workspace.suspendedAt|date('d/m/Y') : '—' }} : {{ workspace.suspensionReason|default('motif non renseigné') }}
                            </p>
                        {% endif %}
                    </div>
                    <div>
                        <twig:WorkspaceSuspendedComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />
                    </div>
                </div>
            </section>

            {# --- IDENTITÉ LÉGALE --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Identité légale</h2>
                <div class="pt-4">
                    <twig:WorkspaceEditComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />

                    <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between"
                         data-controller="inline-status-loader"
                         data-action="kysure:siret-loading@window->inline-status-loader#showLoading">
                        <div class="flex items-center gap-2">
                            <span data-inline-status-loader-target="icon">
                                <twig:ux:icon name="tabler:building-bank" class="size-4 text-slate-400" aria-hidden="true" />
                            </span>
                            <span data-inline-status-loader-target="spinner" class="hidden">
                                <twig:ux:icon name="tabler:loader" class="size-4 text-slate-400 animate-spin" aria-hidden="true" />
                            </span>
                            <div data-inline-status-loader-target="subtitle">
                                {% if workspace.siret %}
                                    {% if workspace.isSiretValid %}
                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-700">SIRET valide</span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-rose-50 text-rose-700">SIRET invalide</span>
                                    {% endif %}
                                    <span class="text-[10px] text-slate-400 ml-1">
                                        {{ workspace.verifySiretLastAttemptedAt ? 'Vérifié le ' ~ workspace.verifySiretLastAttemptedAt|date('d/m/Y à H:i') : 'Jamais vérifié' }}
                                    </span>
                                {% else %}
                                    <span class="text-[10px] text-amber-600 font-medium">SIRET non renseigné</span>
                                {% endif %}
                            </div>
                        </div>

                        <form action="{{ path('admin_workspace_action_verify_siret', {slug: workspace.slugId}) }}"
                              method="POST"
                              data-controller="submit-emitter"
                              data-submit-emitter-event-name-value="kysure:siret-loading"
                              data-action="submit->submit-emitter#submit">
                            <input type="hidden" name="_token" value="{{ csrf_token('verify_siret_' ~ workspace.slugId) }}">
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-600 hover:text-slate-900 disabled:opacity-50 disabled:cursor-wait"
                                    data-submit-emitter-target="button">
                                <twig:ux:icon name="tabler:refresh" class="size-3.5" aria-hidden="true" />
                                Re-vérifier
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            {# --- AGRÉMENT & CONFORMITÉ --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Agrément & conformité</h2>
                <dl class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
                    <div data-controller="inline-status-loader"
                         data-action="kysure:orias-loading@window->inline-status-loader#showLoading">
                        <div class="flex items-center justify-between">
                            <dt class="text-xs text-slate-500" data-inline-status-loader-target="title">N° ORIAS</dt>
                            <form action="{{ path('admin_workspace_action_verify_orias', {slug: workspace.slugId}) }}"
                                  method="POST"
                                  data-controller="submit-emitter"
                                  data-submit-emitter-event-name-value="kysure:orias-loading"
                                  data-action="submit->submit-emitter#submit">
                                <input type="hidden" name="_token" value="{{ csrf_token('verify_orias_' ~ workspace.slugId) }}">
                                <button type="submit"
                                        class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-slate-900 disabled:opacity-50 disabled:cursor-wait"
                                        data-submit-emitter-target="button">
                                    <twig:ux:icon name="tabler:refresh" class="size-3.5" aria-hidden="true" />
                                    Re-vérifier
                                </button>
                            </form>
                        </div>
                        <dd class="mt-1 flex items-center gap-2" data-inline-status-loader-target="details">
                            <span class="text-sm font-medium font-mono text-slate-900">{{ workspace.oriasNumber|default('Non renseigné') }}</span>
                            {% if workspace.oriasNumber %}
                                {% if workspace.isValidOrias %}
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-700">Valide</span>
                                {% else %}
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-rose-50 text-rose-700">Invalide</span>
                                {% endif %}
                            {% endif %}
                        </dd>
                        <div class="text-[11px] text-slate-400 mt-0.5" data-inline-status-loader-target="subtitle">
                            {{ workspace.lastCheckOrias ? 'Vérifié le ' ~ workspace.lastCheckOrias|date('d/m/Y à H:i') : 'Jamais vérifié' }}
                            &middot; {{ workspace.professionalAssociation|default('Sans association') }}
                        </div>
                    </div>

                    <div>
                        <dt class="text-xs text-slate-500">RC Pro</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900">{{ workspace.rcProInsurer|default('Non renseigné') }}</dd>
                        <div class="text-[11px] font-mono text-slate-400 mt-0.5">{{ workspace.rcProPolicyNumber|default('-') }}</div>
                    </div>
                </dl>
            </section>

            {# --- ABONNEMENT & FACTURATION --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Abonnement & facturation</h2>
                <dl class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
                    <div>
                        <dt class="text-xs text-slate-500">Forfait</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900">{{ workspace.subscriptionPlan|default('Gratuit') }}</dd>
                        <div class="text-[11px] mt-0.5 {{ workspace.subscriptionStatus == 'active' ? 'text-emerald-600 font-medium' : 'text-slate-400' }}">
                            {{ workspace.subscriptionStatus == 'active' ? 'Payant' : 'Inactif' }}
                        </div>
                    </div>
                    <div>
                        <dt class="text-xs text-slate-500">Fin de période</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900">{{ workspace.subscriptionEnd ? workspace.subscriptionEnd|date('d/m/Y') : '-' }}</dd>
                        {% if workspace.subscriptionCancelAtPeriodEnd %}
                            <div class="text-[11px] font-medium text-rose-600 mt-0.5">Résiliation programmée</div>
                        {% endif %}
                    </div>
                    <div>
                        <dt class="text-xs text-slate-500">Sièges</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900">
                            {{ workspace.subscriptionSeatsCount }} siège{{ workspace.subscriptionSeatsCount > 1 ? 's' : '' }}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs text-slate-500">Montant mensuel</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-900">
                            {% if workspace.subscriptionBasePrice is not null %}
                                {{ (workspace.subscriptionBasePrice * workspace.subscriptionSeatsCount)|number_format(2, ',', ' ') }} €
                                <span class="text-[11px] font-normal text-slate-400">({{ workspace.subscriptionBasePrice|number_format(0, ',', ' ') }} € / siège)</span>
                            {% else %}
                                -
                            {% endif %}
                        </dd>
                    </div>
                </dl>
                <div class="mt-5 pt-5 border-t border-slate-100">
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <twig:ManageSubscriptionComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />
                    {% else %}
                        <p class="text-xs text-slate-400">
                            Réservé aux administrateurs : la gestion de l'abonnement Stripe (sièges, pause, résiliation) a un impact financier direct sur le client.
                        </p>
                    {% endif %}
                </div>
            </section>

            {# --- QUOTA --- #}
            <section class="p-6">
                <h2 class="text-sm font-semibold text-slate-900 pb-3 border-b border-slate-200">Quota</h2>
                <dl class="pt-4 grid grid-cols-2 gap-x-8 gap-y-5 max-w-sm">
                    <div>
                        <dt class="text-xs text-slate-500">Dossiers d'essai restants</dt>
                        <dd class="mt-1 text-xl font-semibold text-slate-900">{{ workspace.trialDossiersRemaining }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-slate-500">Minutes d'entretien restantes</dt>
                        <dd class="mt-1 text-xl font-semibold text-slate-900">{{ workspace.remainingMeetingMinutes }}</dd>
                    </div>
                </dl>
                <p class="mt-4 text-xs text-slate-500">Créditer des dossiers d'essai ou des minutes d'entretien (geste commercial, motif obligatoire).</p>
                <div class="mt-3">
                    <twig:GrantWorkspaceQuotaComponent slugId="{{ workspace.slugId }}" adminEmail="{{ app.user.email }}" />
                </div>
            </section>

        </div>

    </div>
{% endblock %}

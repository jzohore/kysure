{% extends '@admin/base_admin.html.twig' %}

{% block title %}{{ page_title }} | {{ company_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Retours des testeurs</h1>
        <p class="text-sm text-slate-500 mt-1">Envoyés depuis le widget flottant (visible uniquement en dev/staging).</p>
    </div>

    {% if feedback_entries is empty %}
        <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center">
            <p class="text-sm text-slate-500">Aucun retour pour le moment.</p>
        </div>
    {% else %}
        <div class="space-y-3">
            {% for entry in feedback_entries %}
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                    <div class="flex items-start justify-between gap-4 mb-2">
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-slate-900">{{ entry.submittedBy.firstName }} {{ entry.submittedBy.lastName }}</p>
                            <a href="{{ entry.pageUrl }}" target="_blank" class="text-xs text-indigo-600 hover:text-indigo-800 break-all">
                                {{ entry.pageTitle ?: entry.pageUrl }}
                            </a>
                        </div>
                        <span class="text-xs text-slate-400 shrink-0">{{ entry.createdAt|date('d/m/Y H:i') }}</span>
                    </div>
                    <p class="text-sm text-slate-700 whitespace-pre-line">{{ entry.message }}</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

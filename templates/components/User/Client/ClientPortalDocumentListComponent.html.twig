{# Pièces visibles du client : celles qui lui sont demandées, ou qu'il a déjà déposées. #}
{% set kycDocuments = this.folder.documents|filter(d => d.type.value != 'der' and (d.requestedFromClient or d.status.value in ['processing', 'uploaded', 'valid'])) %}

<div {{ attributes }}
    {% if this.hasProcessingDocuments %}data-poll="delay(2000)|$render"{% endif %}
    data-action="live:render->live#$render"
    class="relative space-y-6">

    <div data-loading="action(submitForReview)|show" class="absolute inset-0 bg-slate-50/50 backdrop-blur-[1px] z-10 hidden rounded-2xl flex items-center justify-center">
        <twig:ux:icon name="tabler:loader" class="size-8 text-[#0B261C] animate-spin" aria-hidden="true" />
        <span class="sr-only" role="status">Mise à jour en cours…</span>
    </div>

    {# ==================================================================== #}
    {# LA LISTE DES PIÈCES : chaque ligne indique si elle est déjà          #}
    {# transmise/validée ou s'il reste au client à la déposer.             #}
    {# ==================================================================== #}
    <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

        {# 📱 FIX 1 : Header flex-col sur mobile, flex-row sur desktop, padding réduit #}
        <div class="px-4 py-3 sm:px-6 sm:py-4 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h2 class="text-xs sm:text-sm font-semibold text-slate-900 uppercase tracking-wider">Vos pièces justificatives</h2>
                {% set totalCount = kycDocuments|length %}
                {% set doneCount = kycDocuments|filter(d => d.status.value in ['processing', 'uploaded', 'valid'])|length %}
                {% if totalCount > 0 %}
                    <p class="mt-1 text-xs text-slate-600" role="status">{{ doneCount }} sur {{ totalCount }} pièce{{ totalCount > 1 ? 's' : '' }} déposée{{ doneCount > 1 ? 's' : '' }}</p>
                {% endif %}
            </div>
            <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wide w-fit">
                Niveau {{ this.folder.diligenceLevel.label|default('Standard') }}
            </span>
        </div>

        <ul class="divide-y divide-slate-100">
            {% for doc in kycDocuments %}
                {% set isProcessing = doc.status.value == 'processing' %}
                {% set uploadable = doc.canBeReplacedByClient and this.folder.canReceiveClientDocuments %}

                {# 📱 FIX 2 : Padding réduit sur mobile (p-4 au lieu de p-6) #}
                <li class="p-4 sm:p-6 transition-colors hover:bg-slate-50/50">
                  {# Zone de dépôt : glisser-déposer sur toute la ligne, aperçu avant envoi (document_dropzone_controller.js) #}
                  <div class="transition-colors"
                       {% if uploadable %}
                           {{ stimulus_controller('document-dropzone', {
                               url: path('portal_kyc_document_upload', { documentId: doc.id, folderId: this.folder.id }),
                               maxSize: 10485760,
                               types: ['application/pdf', 'image/jpeg', 'image/png'],
                           }) }}
                           data-document-dropzone-active-class="ring-2 ring-blue-500/40 bg-blue-50/50 rounded-xl"
                           data-action="dragenter->document-dropzone#dragOver dragover->document-dropzone#dragOver dragleave->document-dropzone#dragLeave drop->document-dropzone#drop"
                       {% endif %}>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 sm:gap-4">

                        {# 📱 FIX 3 : Ajout de min-w-0 essentiel pour que le truncate enfant fonctionne #}
                        <div class="flex items-start gap-3 sm:gap-4 flex-1 min-w-0">

                            {# Icônes d'état (inchangées) #}
                            {% if doc.status.value == 'valid' %}
                                <div class="mt-0.5 p-2 bg-emerald-50 rounded-full ring-1 ring-emerald-500/20 shrink-0">
                                    <twig:ux:icon name="tabler:check" class="size-4 sm:size-5 text-emerald-600" aria-hidden="true" />
                                </div>
                            {% elseif doc.status.value == 'rejected' %}
                                <div class="mt-0.5 p-2 bg-red-50 rounded-full ring-1 ring-red-500/20 shrink-0">
                                    <twig:ux:icon name="tabler:x" class="size-4 sm:size-5 text-red-600" aria-hidden="true" />
                                </div>
                            {% elseif isProcessing %}
                                <div class="mt-0.5 p-2 bg-indigo-50 rounded-full ring-1 ring-indigo-500/20 shrink-0">
                                    <twig:ux:icon name="tabler:loader" class="size-4 sm:size-5 text-indigo-600 animate-spin" aria-hidden="true" />
                                </div>
                            {% else %}
                                <div class="mt-0.5 p-2 bg-slate-100 rounded-full ring-1 ring-slate-200 shrink-0">
                                    <twig:ux:icon name="tabler:file-upload" class="size-4 sm:size-5 text-slate-400" aria-hidden="true" />
                                </div>
                            {% endif %}

                            {# Conteneur des textes (doit aussi avoir min-w-0) #}
                            <div class="flex-1 min-w-0">
                                {# Titre et badge : flex-wrap pour éviter l'écrasement sur tout petit écran #}
                                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                                    <h3 class="text-sm sm:text-base font-semibold text-slate-900 leading-tight">
                                        {{ doc.type.label|default('Document requis') }}
                                    </h3>
                                    {% if doc.isMandatory %}
                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded uppercase shrink-0">Requis</span>
                                    {% endif %}
                                </div>

                                {% if doc.storagePath and doc.status.value in ['uploaded', 'valid'] %}
                                    {# 📱 FIX 4 : Troncature sécurisée du nom de fichier #}
                                    <div class="flex items-center gap-2 bg-slate-100/80 ring-1 ring-slate-900/5 rounded-lg pl-2 pr-1 py-1 mt-2.5 text-xs max-w-full w-fit">
                                        <twig:ux:icon name="tabler:file-check" class="size-3.5 text-emerald-600 shrink-0" aria-hidden="true" />

                                        {% set fileParts = doc.storagePath|split('.') %}
                                        {% set extension = fileParts|last|upper %}
                                        {# On enlève le chemin complet si présent, on garde juste le nom final #}
                                        {% set rawName = doc.storagePath|split('/')|last|replace({ ('.' ~ fileParts|last): '' }) %}

                                        {# Troncature stricte pour éviter l'overflow mobile #}
                                        <span class="text-slate-700 font-medium truncate max-w-[140px] sm:max-w-[200px]" title="{{ doc.storagePath }}">
                                            {{ rawName }}
                                        </span>

                                        <span class="inline-flex items-center px-1 py-0.5 rounded text-[8px] sm:text-[9px] font-black bg-white text-slate-600 border border-slate-200 uppercase tracking-wide shrink-0 font-mono">
                                            {{ extension }}
                                        </span>
                                    </div>
                                {% elseif not isProcessing %}
                                    <p class="text-xs sm:text-sm text-slate-400 mt-1 italic">En attente de transmission</p>
                                {% endif %}

                                {% if doc.status.value == 'uploaded' %}
                                    <p class="text-xs sm:text-sm text-slate-500 mt-2">Pièce reçue — votre conseiller la vérifie.</p>
                                {% endif %}

                                {% if doc.status.value == 'rejected' and doc.rejectionReason %}
                                    <div class="mt-3 p-2.5 sm:p-3 rounded-md bg-red-50 border border-red-100 flex gap-2 text-xs sm:text-sm text-red-800">
                                        <twig:ux:icon name="tabler:alert-circle" class="size-4 shrink-0 mt-0.5" />
                                        <p><strong>Motif :</strong> {{ doc.rejectionReason }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Actions #}
                        <div class="shrink-0 w-full sm:w-auto mt-2 sm:mt-0">
                            {% if doc.status.value == 'valid' %}
                                <span class="text-sm font-medium text-emerald-600 flex items-center justify-center sm:justify-end gap-1.5 px-4 py-2 bg-emerald-50 sm:bg-transparent rounded-lg sm:rounded-none">
                                    <twig:ux:icon name="tabler:shield-check" class="size-4" />
                                    Conforme
                                </span>

                            {% elseif isProcessing %}
                                <span class="text-sm font-medium text-indigo-600 flex items-center justify-center sm:justify-end gap-1.5 px-4 py-2 bg-indigo-50 sm:bg-transparent rounded-lg sm:rounded-none" role="status">
                                    <twig:ux:icon name="tabler:loader" class="size-4 animate-spin" aria-hidden="true" />
                                    Traitement...
                                </span>

                            {% elseif uploadable %}
                                <div data-document-dropzone-target="idle" class="flex flex-col sm:flex-row gap-2">
                                    <input type="file" class="sr-only" tabindex="-1" aria-hidden="true"
                                           accept="application/pdf,image/jpeg,image/png"
                                           data-document-dropzone-target="input"
                                           data-action="change->document-dropzone#selected">
                                    <input type="file" class="sr-only" tabindex="-1" aria-hidden="true"
                                           accept="image/jpeg,image/png" capture="environment"
                                           data-document-dropzone-target="cameraInput"
                                           data-action="change->document-dropzone#selected">

                                    <twig:Button type="button" variant="dark" data-action="click->document-dropzone#browse" class="h-11 sm:h-9 w-full sm:w-auto">
                                        <twig:ux:icon name="tabler:upload" aria-hidden="true" />
                                        {{ doc.status.value == 'rejected' ? 'Renvoyer un fichier' : (doc.status.value == 'uploaded' ? 'Remplacer le fichier' : 'Choisir un fichier') }}
                                    </twig:Button>
                                    {# Sur mobile : ouvre directement l'appareil photo #}
                                    <twig:Button type="button" variant="outline" data-action="click->document-dropzone#takePhoto" class="h-11 w-full sm:hidden">
                                        <twig:ux:icon name="tabler:camera" aria-hidden="true" />
                                        Prendre en photo
                                    </twig:Button>
                                </div>
                            {% endif %}
                        </div>

                    </div>

                    {% if uploadable %}
                        <p data-document-dropzone-target="error" role="alert" hidden
                           class="mt-3 rounded-md border-l-4 border-l-red-500 bg-white px-3 py-2 text-sm text-slate-700 ring-1 ring-slate-200"></p>

                        {# Aperçu avant envoi : rien ne part tant que le client n'a pas cliqué sur « Envoyer » #}
                        <div data-document-dropzone-target="panel" hidden class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:p-4">
                            <div class="flex items-start gap-3 sm:gap-4">
                                <div data-document-dropzone-target="thumb" class="size-20 sm:size-24 shrink-0 overflow-hidden rounded-lg bg-white ring-1 ring-slate-200 flex items-center justify-center"></div>
                                <div class="min-w-0 flex-1">
                                    <p data-document-dropzone-target="fileName" class="truncate text-sm font-medium text-slate-900"></p>
                                    <p data-document-dropzone-target="fileMeta" class="mt-0.5 text-xs text-slate-600"></p>
                                    <a data-document-dropzone-target="previewLink" href="#" target="_blank" rel="noopener noreferrer"
                                       class="mt-1.5 inline-flex items-center gap-1 text-xs font-medium text-blue-700 hover:underline focus-visible:ring-2 focus-visible:ring-blue-600/30 rounded">
                                        <twig:ux:icon name="tabler:eye" class="size-3.5" aria-hidden="true" />
                                        Voir en grand
                                    </a>

                                    <div data-document-dropzone-target="progress" hidden role="progressbar" aria-label="Envoi de la pièce"
                                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="mt-3">
                                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                                            <div data-document-dropzone-target="bar" class="h-full w-0 rounded-full bg-blue-600 transition-[width] duration-200"></div>
                                        </div>
                                        <p data-document-dropzone-target="progressLabel" class="mt-1.5 text-xs text-slate-600" aria-live="polite"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                                <twig:Button type="button" variant="ghost" data-document-dropzone-target="cancelButton" data-action="click->document-dropzone#cancel" class="h-11 sm:h-9">
                                    Annuler
                                </twig:Button>
                                <twig:Button type="button" variant="outline" data-document-dropzone-target="changeButton" data-action="click->document-dropzone#browse" class="h-11 sm:h-9">
                                    Changer de fichier
                                </twig:Button>
                                <twig:Button type="button" variant="primary" data-document-dropzone-target="sendButton" data-action="click->document-dropzone#send" class="h-11 sm:h-9">
                                    <twig:ux:icon name="tabler:send" aria-hidden="true" />
                                    <span data-document-dropzone-target="sendLabel">Envoyer</span>
                                </twig:Button>
                            </div>
                        </div>
                    {% endif %}
                  </div>
                </li>
            {% else %}
                <li class="p-8 text-center text-sm text-slate-500">
                    Aucune pièce justificative n'est requise.
                </li>
            {% endfor %}
        </ul>
    </section>
    {% if this.folder.canBeSubmitted() %}
        <div class="mt-6 p-5 sm:p-6 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
            <div class="text-center sm:text-left">
                <h3 class="text-sm font-semibold text-slate-900 flex items-center justify-center sm:justify-start gap-2">
                    <twig:ux:icon name="tabler:circle-check-filled" class="size-5 text-emerald-600" aria-hidden="true" />
                    Dossier complet
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-lg">
                    Toutes les pièces requises ont été réceptionnées. Vous pouvez maintenant soumettre votre dossier de conformité à votre cabinet.
                </p>
            </div>

            {# 🚨 PLUS DE FORMULAIRE. Juste une LiveAction. #}
            <button type="button"
                    data-action="live#action"
                    data-live-action-param="submitForReview"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#0B261C] text-white px-6 py-3 sm:py-2.5 rounded-lg text-sm font-medium hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#0B261C] focus:ring-offset-2 transition-all shadow-sm disabled:opacity-50"
                    >

            <span data-loading="addClass(hidden)" class="flex items-center gap-2">
                <twig:ux:icon name="tabler:send" class="size-4" aria-hidden="true" />
                Soumettre mon dossier
            </span>

                <span data-loading class="hidden">
                <twig:ux:icon name="tabler:loader" class="size-4 animate-spin" />
            </span>
            </button>
        </div>
    {% endif %}
</div>

<section {{ attributes }} aria-labelledby="heading-adequacy">
    {% include 'components/partials/_live_alerts.html.twig' with {
        message: this.actionMessage|default(null),
        type: this.actionMessageType|default('error')
    } %}

    {# Bulle « comment c'est calculé » : ancrée au titre (HoverCard en `static`) pour rester
       dans la largeur de la section sur mobile. Règles précalculées : dans un slot, `this`
       désigne le composant HoverCard, pas ce LiveComponent. #}
    {% set rules = this.rules %}
    {% set costs_rule = this.costsRule %}
    <div class="relative flex items-center gap-1.5">
        <h2 id="heading-adequacy" class="font-serif text-2xl tracking-tight text-slate-900">Adéquation produit</h2>
        <twig:HoverCard class="static" openDelay="100" closeDelay="150">
            <twig:HoverCard:Trigger>
                <twig:Button type="button" variant="ghost" size="icon-sm" aria-label="Comment l'adéquation est-elle calculée ?" {{ ...hover_card_trigger_attrs }}>
                    <twig:ux:icon name="tabler:info-circle" class="size-4 text-slate-400" aria-hidden="true" />
                </twig:Button>
            </twig:HoverCard:Trigger>
            <twig:HoverCard:Content class="left-0 w-full max-w-md translate-x-0 p-4">
                <p class="font-medium text-slate-900">Comment c'est calculé</p>
                <p class="mt-1 text-slate-600">8 contrôles comparent le produit au profil investisseur validé et à la fiche patrimoniale. Chacun ressort conforme, point d'attention ou bloquant ; le résultat global est le plus sévère.</p>
                <dl class="mt-3 space-y-2">
                    {% for rule in rules %}
                        <div>
                            <dt class="font-medium text-slate-900">{{ rule.label }}</dt>
                            <dd class="text-slate-600">{{ rule.rule }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                <p class="mt-3 border-t border-slate-100 pt-3 font-medium text-slate-900">Frais</p>
                <p class="mt-1 text-slate-600">{{ costs_rule }}</p>
            </twig:HoverCard:Content>
        </twig:HoverCard>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">
        Vérifiez qu'un produit que vous envisagez correspond au profil, à la situation et à l'objectif du client.
        KYSURE contrôle la cohérence ; le choix du produit reste le vôtre. Un point bloquant n'empêche pas de poursuivre,
        mais exige une justification écrite, conservée dans la piste d'audit.
    </p>

    {% set missing = this.missingPrerequisite %}
    {% if missing %}
        <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-slate-200 border-l-2 border-l-amber-400 bg-white p-6 sm:flex-row sm:items-center sm:justify-between" role="status">
            <div class="flex gap-3">
                <twig:ux:icon name="tabler:alert-triangle" class="mt-0.5 size-5 shrink-0 text-amber-600" aria-hidden="true" />
                <p class="text-sm text-slate-600">{{ missing.message }}</p>
            </div>
            {% if missing.route %}
                <twig:Button as="a" href="{{ path(missing.route, missing.routeParams) }}" variant="outline" size="sm" class="shrink-0">{{ missing.cta }}</twig:Button>
            {% endif %}
        </div>
    {% elseif this.canRecord %}
        <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
            {# Champs : mêmes composants que le thème de formulaire (form/stripe_theme.html.twig).
               Listes précalculées : dans le slot d'un <twig:Select>, `this` désigne le Select. #}
            {% set products = this.products %}
            {% set objectives = this.objectives %}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="space-y-2">
                    <twig:Label for="adequacy_product">Produit</twig:Label>
                    <twig:Select id="adequacy_product" data-model="productSlugId">
                        <option value="">Choisir…</option>
                        {% for product in products %}
                            <option value="{{ product.slugId }}" {{ product.slugId == productSlugId ? 'selected' }}>{{ product.name }} · SRI {{ product.sriLevel }}</option>
                        {% endfor %}
                    </twig:Select>
                </div>
                <div class="space-y-2">
                    <twig:Label for="adequacy_objective">Objectif du client</twig:Label>
                    <twig:Select id="adequacy_objective" data-model="objectiveIndex">
                        <option value="">Choisir…</option>
                        {% for index, label in objectives %}
                            <option value="{{ index }}" {{ index ~ '' == objectiveIndex ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </twig:Select>
                </div>
                <div class="space-y-2">
                    <twig:Label for="adequacy_amount">Montant investi (€)</twig:Label>
                    <twig:Input id="adequacy_amount" type="number" min="1" step="1" inputmode="numeric"
                                data-model="amountEuros" class="tabular-nums" value="{{ amountEuros }}" />
                </div>
            </div>

            {# Rémunération du CIF (lot 4) : MIF2 impose qu'elle soit explicite, KYSURE ne la connaît pas. #}
            <fieldset class="mt-6">
                <legend class="text-sm font-medium text-slate-900">Votre rémunération</legend>
                <p class="mt-1 text-sm text-slate-600">Laissez vide ce que vous ne percevez pas. Les rétrocessions sont la part des frais annuels du produit qui vous est reversée.</p>
                <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-3">
                    <div class="space-y-2">
                        <twig:Label for="adequacy_entry_fee">Droits d'entrée (%)</twig:Label>
                        <twig:Input id="adequacy_entry_fee" type="text" inputmode="decimal" placeholder="0"
                                    data-model="entryFeePercent" class="tabular-nums" value="{{ entryFeePercent }}" />
                    </div>
                    <div class="space-y-2">
                        <twig:Label for="adequacy_advisory_fee">Honoraires de conseil (€)</twig:Label>
                        <twig:Input id="adequacy_advisory_fee" type="number" min="0" step="1" inputmode="numeric" placeholder="0"
                                    data-model="advisoryFeeEuros" class="tabular-nums" value="{{ advisoryFeeEuros }}" />
                    </div>
                    <div class="space-y-2">
                        <twig:Label for="adequacy_retrocession">Rétrocessions (% par an)</twig:Label>
                        <twig:Input id="adequacy_retrocession" type="text" inputmode="decimal" placeholder="0"
                                    data-model="retrocessionPercent" class="tabular-nums" value="{{ retrocessionPercent }}" />
                    </div>
                </div>
            </fieldset>

            {% set preview = this.preview %}
            {% set evaluation = preview ? preview.evaluation : null %}
            {% if evaluation %}
                <div class="mt-6 border-t border-slate-100 pt-6">
                    <p class="text-sm text-slate-600" role="status" aria-live="polite">
                        <span class="font-medium text-slate-900">{{ evaluation.worstSeverity.label }}</span>
                        <span aria-hidden="true" class="mx-1.5 text-slate-300">·</span>
                        {{ evaluation.countBySeverity(enum('App\\Domain\\AdequacyReport\\Enum\\MatchSeverity').CONFORME) }} conforme(s),
                        {{ evaluation.countBySeverity(enum('App\\Domain\\AdequacyReport\\Enum\\MatchSeverity').ATTENTION) }} point(s) d'attention,
                        {{ evaluation.countBySeverity(enum('App\\Domain\\AdequacyReport\\Enum\\MatchSeverity').BLOQUANT) }} bloquant(s)
                    </p>

                    <ul class="mt-4 space-y-3">
                        {% for finding in evaluation.findings %}
                            <li class="flex gap-3 rounded-lg border border-slate-200 border-l-2 {{ this.severityAccent(finding.severity) }} bg-white px-4 py-3">
                                <twig:ux:icon name="{{ this.severityIcon(finding.severity) }}" class="mt-0.5 size-4 shrink-0 {{ this.severityIconColor(finding.severity) }}" aria-hidden="true" />
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-900">
                                        {{ finding.criterion.label }}
                                        <span class="sr-only">— {{ finding.severity.label }}</span>
                                    </p>
                                    <p class="mt-0.5 text-sm text-slate-600">{{ finding.message }}</p>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="mt-6">
                        <h3 class="text-sm font-medium text-slate-900">Frais et rémunération</h3>
                        <div class="mt-3">
                            {% include 'components/AdequacyReport/_cost_breakdown.html.twig' with {costs: preview.costs} %}
                        </div>
                    </div>

                    {% set min_justification_length = this.minJustificationLength %}
                    <div class="mt-6 space-y-2">
                        <twig:Label for="adequacy_justification">
                            Justification
                            {% if evaluation.hasBlockingFinding %}
                                <span class="font-normal text-slate-600">— obligatoire ({{ min_justification_length }} caractères minimum)</span>
                            {% else %}
                                <span class="font-normal text-slate-600">— optionnelle</span>
                            {% endif %}
                        </twig:Label>
                        {# Mêmes classes que le textarea_widget du thème de formulaire #}
                        <textarea id="adequacy_justification" rows="3" data-model="norender|justification"
                                  {{ evaluation.hasBlockingFinding ? 'required aria-required="true"' }}
                                  class="flex w-full min-h-[76px] rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-400 disabled:opacity-50 transition-colors"
                                  placeholder="{{ evaluation.hasBlockingFinding ? 'Pourquoi ce produit reste adapté malgré le point bloquant (échanges avec le client, contexte, contreparties…)' : 'Contexte utile pour le rapport d\'adéquation' }}">{{ justification }}</textarea>
                    </div>

                    <div class="mt-4 flex justify-end">
                        <twig:Button type="button" variant="dark" size="sm" data-action="live#action" data-live-action-param="record">
                            <twig:ux:icon name="tabler:check" class="size-4" aria-hidden="true" />
                            Enregistrer la vérification
                        </twig:Button>
                    </div>
                </div>
            {% elseif this.evaluationError %}
                <p class="mt-4 text-sm text-rose-700" role="alert">{{ this.evaluationError }}</p>
            {% else %}
                <p class="mt-4 text-sm text-slate-500">Les constats et les frais s'affichent dès que le produit, l'objectif et le montant sont renseignés.</p>
            {% endif %}
        </div>
    {% endif %}

    {% set checks = this.checks %}
    {% if checks is not empty %}
        <div class="mt-8">
            <h3 class="text-sm font-medium text-slate-900">Vérifications enregistrées</h3>
            <ul class="mt-3 divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white">
                {% for check in checks %}
                    <li class="px-5 py-4">
                        <details class="group/check">
                            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
                                <span class="flex min-w-0 gap-3">
                                    <twig:ux:icon name="{{ this.severityIcon(check.worstSeverity) }}" class="mt-0.5 size-4 shrink-0 {{ this.severityIconColor(check.worstSeverity) }}" aria-hidden="true" />
                                    <span class="min-w-0">
                                        <span class="block truncate text-sm font-medium text-slate-900">{{ check.productNameAtCheck }} · <span class="tabular-nums">{{ (check.amountInCents / 100)|number_format(0, ',', ' ') }} €</span></span>
                                        <span class="block text-sm text-slate-600">{{ check.worstSeverity.label }} · {{ check.checkedByName }}, le {{ check.checkedAt|date('d/m/Y à H:i') }}</span>
                                    </span>
                                </span>
                                <twig:ux:icon name="tabler:chevron-down" class="mt-0.5 size-4 shrink-0 text-slate-400 transition-transform group-open/check:rotate-180" aria-hidden="true" />
                            </summary>
                            <ul class="mt-4 space-y-2 sm:pl-7">
                                {% for finding in check.evaluation.findings %}
                                    <li class="flex gap-2 text-sm text-slate-600">
                                        <twig:ux:icon name="{{ this.severityIcon(finding.severity) }}" class="mt-0.5 size-4 shrink-0 {{ this.severityIconColor(finding.severity) }}" aria-hidden="true" />
                                        <span><span class="font-medium text-slate-900">{{ finding.criterion.label }}<span class="sr-only"> — {{ finding.severity.label }}</span> :</span> {{ finding.message }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                            {% set check_costs = check.costs %}
                            <div class="mt-4 sm:pl-7">
                                <p class="text-sm font-medium text-slate-900">Frais et rémunération</p>
                                {% if check_costs %}
                                    <div class="mt-2">
                                        {% include 'components/AdequacyReport/_cost_breakdown.html.twig' with {costs: check_costs} %}
                                    </div>
                                {% else %}
                                    <p class="mt-1 text-sm text-slate-500">Non figés : vérification enregistrée avant le calcul des frais.</p>
                                {% endif %}
                            </div>
                            {% if check.justification %}
                                <p class="mt-4 border-l-2 border-slate-300 pl-3 text-sm text-slate-600 sm:ml-7">
                                    <span class="font-medium text-slate-900">Justification :</span> {{ check.justification }}
                                </p>
                            {% endif %}
                        </details>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</section>

{% extends '@app/billing/base_billing.html.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% set container_width = 'max-w-6xl' %}

{% block portal_content %}
    <div class="py-10">

        <div class="min-h-[80vh] bg-slate-50/50 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">
            <div class="max-w-md mx-auto w-full text-center">

                {# En-tête centré #}
                <div class="mb-10 animate-fade-in">
                    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Entrée en relation</h1>
                    <p class="mt-3 text-sm text-slate-500 max-w-sm mx-auto leading-relaxed">
                        Scannez ce code avec l'appareil photo de votre smartphone pour initier votre dossier de conformité sécurisé.
                    </p>
                </div>

                {# Conteneur du QR Code : Centré au pixel près avec marges auto #}
                {% if not is_profil_valid %}
                    <div class="rounded-lg bg-amber-50 ring-1 ring-inset ring-amber-200 p-4 flex flex-col sm:flex-col items-center justify-between gap-4 text-center sm:text-left animate-fade-in">
                        <div class="flex items-center gap-3 text-amber-800">
                            <twig:ux:icon name="tabler:alert-triangle-filled" class="size-5 text-amber-500 shrink-0" />
                            <span class="text-sm font-medium">Les informations réglementaires de votre cabinet (ex: ORIAS) sont incomplètes.</span>
                        </div>

                        {# Utilisation de ton variant="warning" #}
                        <twig:Button as="a" href="{{ path('app_settings_regulatory_profile') }}" target="_blank" variant="warning" size="sm">
                            <twig:ux:icon name="tabler:external-link" class="size-3.5 mr-1" />
                            Compléter mon profil
                        </twig:Button>
                    </div>
                {% else %}
                    <div class="flex justify-center items-center">
                        <div class="p-6 bg-white rounded-2xl shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] border border-slate-200/80 transform hover:scale-[1.02] transition-transform duration-300 inline-block">
                            <img src="{{ path('app_onboarding_qr_image') }}"
                                 alt="QR Code d'onboarding"
                                 class="w-64 h-64 sm:w-72 sm:h-72 object-contain mx-auto">
                        </div>
                    </div>

                    {# Indicateur de statut passif sous le QR Code #}
                    <div class="mt-8 flex items-center justify-center gap-2 text-xs font-medium text-slate-400 bg-white border border-slate-200 py-2 px-4 rounded-full max-w-xs mx-auto shadow-xs">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
                        En attente de scan client...
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
{% endblock %}

<div {{ attributes }}>

    <form data-action="live#action:prevent" data-live-action-param="finish">

        <fieldset>
            <legend class="sr-only">Comment travaillez-vous ?</legend>

            <div class="space-y-4">

                {# Carte : Indépendant. Le radio reste focusable (sr-only) ; l'anneau suit :focus-visible. #}
                <label class="relative flex cursor-pointer items-start gap-4 rounded-3xl border border-slate-200 bg-white p-6 transition-all hover:border-slate-300 has-[:checked]:border-slate-900 has-[:checked]:shadow-lg has-[:checked]:shadow-slate-900/5 has-[:checked]:ring-1 has-[:checked]:ring-slate-900 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-600/40">
                    <input type="radio" data-model="workspaceType" value="individual" class="peer sr-only" required>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50" aria-hidden="true">
                        {{ ux_icon('lucide:user', { class: 'size-5 text-slate-600' }) }}
                    </span>
                    <span class="flex-1">
                        <span class="block text-xl font-semibold tracking-tight text-slate-900">Indépendant</span>
                        <span class="mt-1 block text-[15px] leading-relaxed text-slate-600">Vous exercez seul : un siège, tout le parcours de conformité.</span>
                    </span>
                    <span class="mt-1 hidden size-6 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white peer-checked:flex" aria-hidden="true">
                        {{ ux_icon('lucide:check', { class: 'size-3.5' }) }}
                    </span>
                </label>

                {# Carte : Cabinet #}
                <label class="relative flex cursor-pointer items-start gap-4 rounded-3xl border border-slate-200 bg-white p-6 transition-all hover:border-slate-300 has-[:checked]:border-slate-900 has-[:checked]:shadow-lg has-[:checked]:shadow-slate-900/5 has-[:checked]:ring-1 has-[:checked]:ring-slate-900 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-600/40">
                    <input type="radio" data-model="workspaceType" value="firm" class="peer sr-only" required>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50" aria-hidden="true">
                        {{ ux_icon('lucide:building', { class: 'size-5 text-slate-600' }) }}
                    </span>
                    <span class="flex-1">
                        <span class="block text-xl font-semibold tracking-tight text-slate-900">Cabinet</span>
                        <span class="mt-1 block text-[15px] leading-relaxed text-slate-600">Plusieurs conseillers : un espace de travail partagé et des collaborateurs invitables (à partir de 2 sièges).</span>
                    </span>
                    <span class="mt-1 hidden size-6 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white peer-checked:flex" aria-hidden="true">
                        {{ ux_icon('lucide:check', { class: 'size-3.5' }) }}
                    </span>
                </label>

            </div>
        </fieldset>

        <div class="mt-8">
            <twig:Button as="button" type="submit" variant="dark" class="h-12 w-full rounded-full text-base">
                {# Live pilote `display` de ces <span> (data-loading) : la mise en page flex vit dans un enfant. #}
                <span data-loading="action(finish)|hide">
                    <span class="inline-flex items-center justify-center gap-2">
                        Continuer
                        {{ ux_icon('lucide:arrow-right', { class: 'size-4', 'aria-hidden': 'true' }) }}
                    </span>
                </span>
                <span data-loading="action(finish)|show" class="hidden">
                    <span class="inline-flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:loader-2', { class: 'size-4 animate-spin', 'aria-hidden': 'true' }) }}
                        Chargement
                    </span>
                </span>
            </twig:Button>
        </div>
    </form>
</div>

<div {{ attributes }} class="space-y-6" {% if this.isAnyRunning %}data-poll="delay(2000)|$render"{% endif %}>
    {% set rows = this.rows %}

    {% include 'components/partials/_live_alerts.html.twig' with {
        message: this.actionMessage|default(null),
        type: this.actionMessageType|default('success')
    } %}

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-500">
                        <th scope="col" class="px-4 py-3">Tâche</th>
                        <th scope="col" class="px-4 py-3">Fréquence</th>
                        <th scope="col" class="px-4 py-3">Dernière exécution</th>
                        <th scope="col" class="px-4 py-3">Statut</th>
                        <th scope="col" class="px-4 py-3">Active</th>
                        <th scope="col" class="px-4 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                    {% for row in rows %}
                        <tr class="hover:bg-slate-50/80">
                            <td class="px-4 py-3">
                                <p class="font-medium text-slate-900">{{ row.job.getLabel() }}</p>
                                <p class="mt-0.5 text-xs text-slate-500">{{ row.job.getDescription() }}</p>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3">
                                {% set current = pendingFrequency[row.job.value] ?? row.frequency.value %}
                                <select data-model="pendingFrequency.{{ row.job.value }}"
                                        data-action="change->live#action"
                                        data-live-action-param="saveFrequency"
                                        data-live-job-param="{{ row.job.value }}"
                                        class="rounded-lg border border-slate-200 px-2 py-1.5 text-xs focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
                                        aria-label="Fréquence de {{ row.job.getLabel() }}">
                                    {% for option in this.frequencyOptions %}
                                        <option value="{{ option.value }}" {{ option.value == current ? 'selected' : '' }}>{{ option.getLabel() }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-500" aria-live="polite">
                                {% if row.lastRun %}
                                    {{ row.lastRun.startedAt|date('d/m/Y H:i') }}
                                    <span class="text-slate-400">({{ row.lastRun.triggeredBy.getLabel() }})</span>
                                {% else %}
                                    Jamais exécutée
                                {% endif %}
                            </td>
                            <td class="px-4 py-3" aria-live="polite">
                                {% if row.lastRun %}
                                    <span class="inline-flex items-center gap-1 rounded px-2 py-0.5 text-[11px] font-bold ring-1 ring-inset {{ row.lastRun.status.getBadgeColor() }}">
                                        {% if row.lastRun.status.value == 'running' %}
                                            <twig:ux:icon name="lucide:loader-2" class="size-3 animate-spin" aria-hidden="true" />
                                        {% endif %}
                                        {{ row.lastRun.status.getLabel() }}
                                    </span>
                                {% else %}
                                    <span class="text-[11px] text-slate-300">—</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3">
                                <button type="button"
                                        data-action="live#action"
                                        data-live-action-param="toggle"
                                        data-live-job-param="{{ row.job.value }}"
                                        class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:outline-none {{ row.enabled ? 'bg-emerald-500' : 'bg-slate-200' }}"
                                        role="switch"
                                        aria-checked="{{ row.enabled ? 'true' : 'false' }}"
                                        aria-label="Activer ou désactiver {{ row.job.getLabel() }}">
                                    <span class="inline-block size-3.5 transform rounded-full bg-white transition-transform {{ row.enabled ? 'translate-x-5' : 'translate-x-1' }}"></span>
                                </button>
                            </td>
                            <td class="px-4 py-3 text-right">
                                {% set isRunning = row.lastRun and row.lastRun.status.value == 'running' %}
                                <button type="button"
                                        data-action="live#action"
                                        data-live-action-param="runNow"
                                        data-live-job-param="{{ row.job.value }}"
                                        {{ isRunning ? 'disabled' : '' }}
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50">
                                    {% if isRunning %}
                                        <twig:ux:icon name="lucide:loader-2" class="size-3.5 animate-spin" aria-hidden="true" />
                                        En cours…
                                    {% else %}
                                        <span data-loading="action(runNow)|hide" class="inline-flex items-center gap-1.5">
                                            <twig:ux:icon name="lucide:play" class="size-3.5" aria-hidden="true" />
                                            Lancer maintenant
                                        </span>
                                        <span data-loading="action(runNow)|show" class="hidden items-center gap-1.5">
                                            <twig:ux:icon name="lucide:loader-2" class="size-3.5 animate-spin" aria-hidden="true" />
                                            Envoi…
                                        </span>
                                    {% endif %}
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

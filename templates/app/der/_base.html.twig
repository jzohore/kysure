<!DOCTYPE html>
<html lang="fr" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Document d'Entrée en Relation{% endblock %}</title>
    {% include '_favicons.html.twig' %}
    {{ importmap('app') }}
</head>
<body class="h-full font-sans text-slate-900 bg-slate-50">
    <main id="main-content" class="min-h-full flex flex-col items-center px-4 py-10 sm:py-16">
        <div class="w-full {% block width %}max-w-2xl{% endblock %}">
            {% if workspace is defined and workspace %}
                <div class="mb-6 flex items-center gap-2 text-sm text-slate-500">
                    <twig:ux:icon name="lucide:building-2" class="size-4 text-slate-400" aria-hidden="true" />
                    <span><strong class="font-semibold text-slate-700">{{ workspace.name }}</strong> vous transmet ce document via KYSURE</span>
                </div>
            {% endif %}

            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded-md border-l-4 border-l-red-500 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% block content %}{% endblock %}

            <div class="mt-8 text-center text-xs text-slate-400 space-y-1">
                <p>
                    Document transmis via KYSURE pour le compte de votre conseiller.
                    {% if workspace is defined and workspace and workspace.email %}
                        Une question ? <a href="mailto:{{ workspace.email }}" class="underline hover:text-slate-600">{{ workspace.email }}</a>
                    {% endif %}
                </p>
                <p>
                    Les informations saisies sur cette page (nom, horodatage, adresse IP) sont utilisées
                    uniquement comme preuve légale de remise du document et ne sont jamais utilisées à
                    d'autres fins.
                </p>
            </div>
        </div>
    </main>
</body>
</html>
